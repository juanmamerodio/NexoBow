---
import { CONTENT } from "../site.ts";

const { prestador } = CONTENT;
const currentYear = new Date().getFullYear();
---

<footer class="py-16 bg-[var(--color-paper)] text-zinc-400 font-sans border-t border-[var(--color-hardware-border)]">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Col 1: Brand & Patent info -->
      <div class="space-y-4 md:col-span-2">
        <div class="flex items-center gap-3">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-[var(--color-hardware-surface-light)] border border-[var(--color-hardware-border)]">
            <svg class="h-3.5 w-3.5 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="m14.31 8 5.74 9.94M9.69 8h11.48M7.38 12l5.74-9.94M9.69 16 3.95 6.06M14.31 16H2.83M16.62 12l-5.74 9.94" />
            </svg>
          </div>
          <span class="font-display font-bold text-white text-base">
            {prestador?.nombre || "HEAVN One"}
          </span>
        </div>
        <p class="text-xs text-zinc-400 max-w-sm leading-relaxed">
          Pioneros en Human Centric Lighting 2.0. Desarrollado y ensamblado bajo normas alemanas de alta precisión en Múnich.
        </p>
        <p class="text-[11px] font-mono text-zinc-400">
          {prestador?.matricula || "Patente DE 10 2019 123 456 · TÜV Rheinland Certified · CE"}
        </p>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-3">
        <h4 class="font-display font-semibold text-white text-xs uppercase tracking-wider">
          Navegación
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="#ingenieria-optica" class="hover:text-white transition-colors">Ingeniería Óptica</a>
          </li>
          <li>
            <a href="#materiales" class="hover:text-white transition-colors">Despiece CNC</a>
          </li>
          <li>
            <a href="#experiencias" class="hover:text-white transition-colors">Líderes & Premios</a>
          </li>
          <li>
            <a href="#configurar" class="hover:text-white transition-colors">Configurar Pedido</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Compliance -->
      <div class="space-y-3">
        <h4 class="font-display font-semibold text-white text-xs uppercase tracking-wider">
          Legal & Garantías
        </h4>
        <p class="text-xs text-zinc-400 leading-relaxed">
          Garantía oficial de 5 años. En cumplimiento de la <strong>Ley 25.326</strong> de Protección de Datos Personales, sus datos de contacto se procesan con fines exclusivos de asesoramiento comercial.
        </p>
      </div>
    </div>

    <div class="pt-8 border-t border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-mono text-zinc-400">
      <span>
        &copy; {currentYear} {prestador?.nombre || "HEAVN One"}. Todos los derechos reservados.
      </span>
      <span>
        Ingeniería Múnich · Despliegue NexoBow
      </span>
    </div>
  </div>
</footer>
