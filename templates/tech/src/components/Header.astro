---
import { THEME, CONTENT } from "../site";
import { SECTION_NAV } from "../order";
import Button from "./ui/Button.astro";

const navItems = [
  { href: "#desafios", label: "Desafíos" },
  { href: "#fases", label: "Fases" },
  { href: "#casos", label: "Casos & ROI" },
  { href: "#faq", label: "Preguntas" },
];

const prestador = CONTENT.prestador;
const bookingLink = CONTENT.links?.calendly || "#agendar";
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[var(--color-paper)]/90 border-b border-[var(--color-ink)]/10 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    <!-- Brand & Status -->
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center gap-2.5 group" aria-label={prestador.nombre}>
        <svg class="h-8 w-auto text-[var(--color-ink)] group-hover:text-[var(--color-primary)] transition-colors" viewBox="0 0 158 65" fill="currentColor">
          <use href="/icon-sprite.svg#logo"></use>
        </svg>
        <span class="font-display font-bold text-base sm:text-lg text-[var(--color-ink)] tracking-tight">
          {prestador.nombre}
        </span>
      </a>

      <div class="hidden md:flex items-center gap-2 px-2.5 py-1 rounded-full bg-[var(--color-ink)]/5 border border-[var(--color-ink)]/10 text-xs font-mono text-[var(--color-ink)]/80">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)] animate-pulse" aria-hidden="true"></span>
        <span class="tracking-wide">{CONTENT.hero?.badge || "ARQUITECTURA DIGITAL · Q4"}</span>
      </div>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-medium text-[var(--color-ink)]/80 hover:text-[var(--color-primary)] transition-colors tracking-tight"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Direct Contact CTA -->
    <div class="flex items-center gap-3">
      <Button href={bookingLink} variant="cta" class="text-xs sm:text-sm py-2.5 sm:py-3 px-4 sm:px-5">
        <span>Agendar Descubrimiento</span>
      </Button>
    </div>
  </div>
</header>
