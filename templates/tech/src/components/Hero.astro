---
import { CONTENT } from "../site";
import Lead from "./ui/Lead.astro";
import Button from "./ui/Button.astro";

const hero = CONTENT.hero;
const prestador = CONTENT.prestador;
const marquee = CONTENT.marquee?.items || [];
const bookingLink = CONTENT.links?.calendly || "#agendar";
const whatsappLink = CONTENT.links?.whatsapp || "#";
---

<section class="relative pt-12 pb-16 lg:pt-20 lg:pb-28 overflow-hidden bg-[var(--color-paper)] border-b border-[var(--color-ink)]/10">
  <!-- Subtle tech dot background -->
  <div class="absolute inset-0 grid-dots-pattern opacity-40 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column: Editorial Headline & Copy -->
      <div class="lg:col-span-7 flex flex-col items-start">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-ink)]/5 border border-[var(--color-ink)]/10 text-xs font-mono uppercase tracking-wider text-[var(--color-ink)]/90 mb-6">
          <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span>
          <span>{hero.eyebrow || "Arquitectura Digital & Sistemas"}</span>
        </div>

        <!-- Headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[var(--color-ink)] leading-[1.08] mb-6">
          <Lead text={prestador.titulo} />
        </h1>

        <!-- Intro Description -->
        <p class="text-lg sm:text-xl text-[var(--color-ink)]/80 leading-relaxed font-sans max-w-2xl mb-8">
          {prestador.bajada}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 mb-10 w-full sm:w-auto">
          <Button href={bookingLink} variant="cta" class="w-full sm:w-auto justify-center">
            <span>Agendar Sesión de Triage</span>
          </Button>

          <Button href={whatsappLink} variant="frosted" external class="w-full sm:w-auto justify-center">
            <svg class="w-4 h-4 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>Consultar por WhatsApp</span>
          </Button>
        </div>

        <!-- Trust Metrics Row -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-[var(--color-ink)]/10 w-full max-w-xl">
          <div>
            <div class="font-mono text-2xl lg:text-3xl font-bold text-[var(--color-primary)]">{hero.stat_1_val || "+14 Años"}</div>
            <div class="text-xs text-[var(--color-ink)]/70 uppercase font-mono tracking-wider mt-1">{hero.stat_1_label || "En Producción"}</div>
          </div>
          <div>
            <div class="font-mono text-2xl lg:text-3xl font-bold text-[var(--color-ink)]">{hero.stat_2_val || "0 Min"}</div>
            <div class="text-xs text-[var(--color-ink)]/70 uppercase font-mono tracking-wider mt-1">{hero.stat_2_label || "Downtime en Deploys"}</div>
          </div>
          <div>
            <div class="font-mono text-2xl lg:text-3xl font-bold text-[var(--color-ink)]">{hero.stat_3_val || "100%"}</div>
            <div class="text-xs text-[var(--color-ink)]/70 uppercase font-mono tracking-wider mt-1">{hero.stat_3_label || "NDA Vinculante"}</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Diagnostic Console -->
      <div class="lg:col-span-5 relative">
        <div class="rounded-2xl bg-[var(--color-surface-navy)] text-white p-6 sm:p-8 shadow-2xl border border-white/10 relative overflow-hidden">
          <!-- Terminal Glow & Texture -->
          <div class="absolute -top-24 -right-24 w-60 h-60 bg-[var(--color-primary)]/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
          <div class="absolute -bottom-24 -left-24 w-60 h-60 bg-[var(--color-accent)]/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

          <!-- Console Header -->
          <div class="flex items-center justify-between pb-5 border-b border-white/10 mb-6">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[var(--color-primary)]"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
              <span class="text-xs font-mono text-white/50 ml-2">{hero.console_id || "sys-diag://production"}</span>
            </div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--color-accent)] px-2 py-0.5 rounded bg-white/5">
              {hero.console_badge || "LIVE TELEMETRY"}
            </span>
          </div>

          <!-- Console Body: 3 System Architecture Diagnostics -->
          <div class="space-y-4">
            <!-- Metric 1 -->
            <div class="p-4 rounded-xl bg-white/5 border border-white/10 hover:border-[var(--color-accent)]/40 transition-colors">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono text-white/70">{hero.diag_1_title || "ARQUITECTURA & CONCURRENCIA"}</span>
                <span class="text-xs font-mono text-emerald-400 font-bold">{hero.diag_1_status || "ESTABLE"}</span>
              </div>
              <div class="flex items-baseline justify-between">
                <div class="text-xl font-mono font-bold text-white">{hero.diag_1_val || "45.000 req/s"}</div>
                <div class="text-xs font-mono text-[var(--color-accent)]">{hero.diag_1_sub || "-78% Latencia p99"}</div>
              </div>
              <div class="w-full bg-white/10 h-1.5 rounded-full mt-2.5 overflow-hidden">
                <div class="bg-[var(--color-accent)] h-full rounded-full w-[88%]"></div>
              </div>
            </div>

            <!-- Metric 2 -->
            <div class="p-4 rounded-xl bg-white/5 border border-white/10 hover:border-[var(--color-accent)]/40 transition-colors">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono text-white/70">{hero.diag_2_title || "FRECUENCIA DE DEPLOY"}</span>
                <span class="text-xs font-mono text-[var(--color-primary)] font-bold">{hero.diag_2_status || "AUTOMATIZADO"}</span>
              </div>
              <div class="flex items-baseline justify-between">
                <div class="text-xl font-mono font-bold text-white">{hero.diag_2_val || "Deploys diarios"}</div>
                <div class="text-xs font-mono text-white/60">{hero.diag_2_sub || "Canary Zero-Downtime"}</div>
              </div>
              <div class="w-full bg-white/10 h-1.5 rounded-full mt-2.5 overflow-hidden">
                <div class="bg-[var(--color-primary)] h-full rounded-full w-[94%]"></div>
              </div>
            </div>

            <!-- Metric 3 -->
            <div class="p-4 rounded-xl bg-white/5 border border-white/10 hover:border-[var(--color-accent)]/40 transition-colors">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono text-white/70">{hero.diag_3_title || "COBERTURA & SEGURIDAD"}</span>
                <span class="text-xs font-mono text-white/60">{hero.diag_3_status || "SOC2 / HIPAA / ISO"}</span>
              </div>
              <div class="flex items-baseline justify-between">
                <div class="text-xl font-mono font-bold text-white">{hero.diag_3_val || "99.98% Uptime"}</div>
                <div class="text-xs font-mono text-emerald-400">{hero.diag_3_sub || "Auditoría Aprobada"}</div>
              </div>
              <div class="w-full bg-white/10 h-1.5 rounded-full mt-2.5 overflow-hidden">
                <div class="bg-emerald-400 h-full rounded-full w-[98%]"></div>
              </div>
            </div>
          </div>

          <!-- Console Footer Caption -->
          <div class="pt-5 mt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-white/60">
            <span>{hero.card_caption || "Auditoría en 48hs sin freno operativo"}</span>
            <span class="text-[var(--color-primary)] font-bold">→ {hero.console_footer_badge || "NDA READY"}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tech Marquee Strip -->
  {marquee.length > 0 && (
    <div class="mt-16 pt-6 pb-6 border-t border-[var(--color-ink)]/10 bg-[var(--color-paper)] overflow-hidden">
      <div class="flex gap-8 whitespace-nowrap animate-[marquee_25s_linear_infinite] motion-reduce:animate-none">
        {marquee.concat(marquee).map((item) => (
          <div class="flex items-center gap-4 text-xs sm:text-sm font-mono text-[var(--color-ink)]/70 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)]"></span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
