---
import { CONTENT } from "../site";
import Lead from "./ui/Lead.astro";

const pasos = CONTENT.pasos;
const steps = pasos.steps || [];
---

<section id="fases" class="py-20 lg:py-28 bg-[var(--color-surface-navy)] text-white relative overflow-hidden">
  <!-- Subtle tech pattern on dark surface -->
  <div class="absolute inset-0 grid-dots-pattern-light opacity-25 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header Backboard -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--color-accent)] font-bold mb-4">
        <span>[02 // ROADMAP DE INGENIERÍA]</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight mb-6">
        <Lead text={pasos.titulo} emClass="text-[var(--color-accent)] font-display italic" />
      </h2>
      <p class="text-lg text-white/80 font-sans leading-relaxed">
        {pasos.bajada}
      </p>
    </div>

    <!-- Cards Grid (Think Company Mixtape/Phases architecture) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="rounded-2xl p-6 sm:p-8 bg-white/5 border border-white/10 hover:border-[var(--color-accent)]/50 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 shadow-lg">
          <div>
            <!-- Step Numeral -->
            <div class="flex items-center justify-between mb-6">
              <span class="font-mono text-3xl font-bold text-[var(--color-primary)]">
                {step.n}
              </span>
              <span class="text-[10px] font-mono uppercase tracking-widest text-white/50 px-2 py-0.5 rounded bg-white/5">
                FASE {step.n}
              </span>
            </div>

            <!-- Title & Deliverable -->
            <h3 class="font-display text-xl font-bold text-white mb-3 group-hover:text-[var(--color-accent)] transition-colors leading-snug">
              {step.k}
            </h3>

            <p class="text-sm text-white/70 leading-relaxed font-sans mb-6">
              {step.d}
            </p>
          </div>

          <!-- Bottom Metric/Guarantee -->
          <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-white/50">
            <span>SISTEMA AUDITADO</span>
            <span class="text-emerald-400">VERIFICADO ✓</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
