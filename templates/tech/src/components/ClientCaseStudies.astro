---
import { CONTENT } from "../site";
import Lead from "./ui/Lead.astro";

const casos = CONTENT.casos;
const reviews = CONTENT.reviews;
const cases = casos.items || [];
const reviewItems = reviews?.items || [];
---

<section id="casos" class="py-20 lg:py-28 bg-[var(--color-paper)] border-b border-[var(--color-ink)]/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--color-primary)] font-bold mb-4">
        <span>[03 // IMPACTO & ROI DE INGENIERÍA]</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-ink)] tracking-tight leading-tight mb-6">
        <Lead text={casos.titulo} />
      </h2>
      <p class="text-lg text-[var(--color-ink)]/75 font-sans leading-relaxed">
        {casos.bajada}
      </p>
    </div>

    <!-- Case Studies List (Think Company Featured Work layout) -->
    <div class="space-y-8 mb-20">
      {cases.map((c, i) => (
        <div class="rounded-2xl p-6 sm:p-10 bg-white border border-[var(--color-ink)]/10 hover:border-[var(--color-primary)]/40 transition-all duration-300 shadow-sm hover:shadow-xl">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Left: Case Details -->
            <div class="lg:col-span-7">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-2.5 py-1 rounded bg-[var(--color-ink)]/5 text-xs font-mono text-[var(--color-ink)]/80 uppercase tracking-wider">
                  CASO 0{i + 1}
                </span>
                <span class="text-xs font-mono text-[var(--color-primary)] font-bold uppercase tracking-wider">
                  MÉTRICA VERIFICADA
                </span>
              </div>

              <h3 class="font-display text-2xl sm:text-3xl font-bold text-[var(--color-ink)] mb-4">
                {c.titulo}
              </h3>

              <p class="text-base sm:text-lg text-[var(--color-ink)]/75 font-sans leading-relaxed mb-6">
                {c.descripcion}
              </p>
            </div>

            <!-- Right: Measurable ROI Highlight Box -->
            <div class="lg:col-span-5 p-6 rounded-xl bg-[var(--color-surface-navy)] text-white border border-white/10">
              <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-accent)] mb-2 font-bold">
                Resultado de Arquitectura
              </div>
              <div class="font-display text-xl sm:text-2xl font-bold text-white mb-4 leading-snug">
                {c.resultado}
              </div>
              <div class="flex items-center gap-2 text-xs font-mono text-emerald-400">
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Sin interrupción del servicio en vivo</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Testimonials / Leadership Reviews -->
    {reviewItems.length > 0 && (
      <div>
        <div class="mb-8">
          <p class="text-xs font-mono uppercase tracking-widest text-[var(--color-ink)]/60">
            {reviews?.tag || "Lo que dicen los líderes técnicos"}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {reviewItems.map((rev) => (
            <div class="p-6 rounded-xl bg-white/70 border border-[var(--color-ink)]/10 hover:border-[var(--color-ink)]/30 transition-all flex flex-col justify-between">
              <p class="text-sm sm:text-base text-[var(--color-ink)]/80 font-sans italic leading-relaxed mb-6">
                “{rev.texto}”
              </p>
              <div class="pt-4 border-t border-[var(--color-ink)]/10">
                <div class="font-display font-bold text-sm text-[var(--color-ink)]">
                  {rev.nombre}
                </div>
                <div class="text-xs font-mono text-[var(--color-ink)]/60 mt-0.5">
                  {rev.rol}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
