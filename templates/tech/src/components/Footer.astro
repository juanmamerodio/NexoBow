---
import { CONTENT } from "../site";

const footer = CONTENT.footer;
const prestador = CONTENT.prestador;
const whatsappLink = CONTENT.links?.whatsapp || "#";
const bookingLink = CONTENT.links?.calendly || "#agendar";
---

<footer class="bg-[var(--color-surface-navy)] text-white border-t border-white/10 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      <!-- Col 1: Brand & Blurb -->
      <div class="md:col-span-5 flex flex-col justify-between">
        <div>
          <a href="/" class="inline-block mb-6" aria-label={prestador.nombre}>
            <svg class="h-8 w-auto text-white" viewBox="0 0 158 65" fill="currentColor">
              <use href="/icon-sprite.svg#logo"></use>
            </svg>
          </a>
          <p class="text-sm text-white/70 font-sans leading-relaxed max-w-sm">
            {footer.blurb || "Think Systems & Architecture · Consultoría de Ingeniería de Software, Modernización de Plataformas y Arquitectura Digital."}
          </p>
        </div>

        <div class="mt-8 text-xs font-mono text-white/50">
          ESPECIALIDAD EN SISTEMAS COMPLEJOS · DESPLIEGUES DE ALTA DISPONIBILIDAD
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="md:col-span-4">
        <h4 class="text-xs font-mono uppercase tracking-widest text-[var(--color-accent)] mb-4 font-bold">
          Navegación Técnica
        </h4>
        <ul class="space-y-2.5 text-sm font-sans text-white/80">
          <li><a href="#desafios" class="hover:text-[var(--color-accent)] transition-colors">Desafíos de Sistemas</a></li>
          <li><a href="#fases" class="hover:text-[var(--color-accent)] transition-colors">Fases de Ingeniería</a></li>
          <li><a href="#casos" class="hover:text-[var(--color-accent)] transition-colors">Casos & ROI Medible</a></li>
          <li><a href="#agendar" class="hover:text-[var(--color-accent)] transition-colors">Sesión de Descubrimiento</a></li>
          <li><a href="#faq" class="hover:text-[var(--color-accent)] transition-colors">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      <!-- Col 3: Direct Action & Compliance -->
      <div class="md:col-span-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-[var(--color-accent)] mb-4 font-bold">
          Canales Directos
        </h4>
        <div class="space-y-3 mb-6">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm text-white hover:text-[var(--color-primary)] transition-colors font-mono"
          >
            <span>→ WhatsApp Directo</span>
          </a>
          <br />
          <a
            href={bookingLink}
            class="inline-flex items-center gap-2 text-sm text-white hover:text-[var(--color-primary)] transition-colors font-mono"
          >
            <span>→ Calendly / Videollamada</span>
          </a>
        </div>

        <div class="p-3 rounded-lg bg-white/5 border border-white/10 text-[11px] font-sans text-white/60 leading-normal">
          <strong class="text-white/80 block mb-1">Ley 25.326 (Protección de Datos):</strong>
          Los datos ingresados se utilizan exclusivamente para coordinar el diagnóstico técnico solicitado y no son cedidos a terceros.
        </div>
      </div>
    </div>

    <!-- Copyright & Disclaimer -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-white/50">
      <div>
        © {new Date().getFullYear()} {prestador.nombre}. Todos los derechos reservados.
      </div>
      <div>
        {footer.credit || "Landing por NexoBow"}
      </div>
    </div>
  </div>
</footer>
