---
import { CONTENT } from "../site";
import Lead from "./ui/Lead.astro";

const problema = CONTENT.problema;
const pains = problema.pains || [];
const bookingLink = CONTENT.links?.calendly || "#agendar";
---

<section id="desafios" class="py-20 lg:py-28 bg-[var(--color-paper)] border-b border-[var(--color-ink)]/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header (Think Company how-we-help style) -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--color-primary)] font-bold mb-4">
        <span>[01 // ANÁLISIS DE SISTEMAS]</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-ink)] tracking-tight leading-tight mb-6">
        <Lead text={problema.titulo} />
      </h2>
      <p class="text-lg text-[var(--color-ink)]/75 font-sans leading-relaxed">
        {problema.descripcion}
      </p>
    </div>

    <!-- Challenges List (Authentic Think Company How-We-Help layout) -->
    <div class="space-y-6">
      {pains.map((item, idx) => (
        <div class="group relative rounded-2xl p-6 sm:p-8 lg:p-10 bg-white/60 hover:bg-white border border-[var(--color-ink)]/10 hover:border-[var(--color-primary)]/40 transition-all duration-300 shadow-sm hover:shadow-xl">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
            <!-- Left: Problem Quote -->
            <div class="lg:col-span-7">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-[var(--color-ink)]/5 text-[11px] font-mono uppercase tracking-wider text-[var(--color-ink)]/70 mb-4">
                <span>{item.tag || `DESAFÍO 0${idx + 1}`}</span>
              </div>
              <p class="font-display text-xl sm:text-2xl text-[var(--color-ink)] font-semibold leading-snug">
                {item.t}
              </p>
            </div>

            <!-- Right: Engineering Solution -->
            <div class="lg:col-span-5 flex flex-col justify-between h-full pt-4 lg:pt-0 lg:pl-6 lg:border-l lg:border-[var(--color-ink)]/10">
              <div class="text-sm font-mono text-[var(--color-primary)] uppercase tracking-wider mb-2 font-bold">
                Solución de Arquitectura
              </div>
              <p class="text-base text-[var(--color-ink)]/80 leading-relaxed font-sans mb-6">
                {item.d}
              </p>

              <div>
                <a
                  href={bookingLink}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-primary)] transition-colors"
                >
                  <span>Ver diagnóstico para este caso</span>
                  <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
