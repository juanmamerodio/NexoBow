---
import { CONTENT } from "../site.ts";

const { development_specs } = CONTENT;
---

<section id="especificaciones" class="py-20 sm:py-32 bg-stone-100/60 relative border-b border-[var(--color-stone-border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-stone-200/80 border border-[var(--color-stone-border)] text-xs font-semibold uppercase tracking-wider text-stone-700 mb-4">
        {development_specs.badge}
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-[var(--color-ink)] font-['Outfit']">
        {development_specs.title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-stone-600 font-['Manrope']">
        {development_specs.subtitle}
      </p>
    </div>

    <!-- 4 Technical Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {development_specs.items.map((item) => (
        <div class="bg-white rounded-3xl p-8 border border-[var(--color-stone-border)] hover:border-stone-400/80 hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-stone-100 flex items-center justify-center font-bold text-lg text-[var(--color-primary)] font-['Outfit'] mb-6 group-hover:bg-[var(--color-primary)] group-hover:text-white transition-colors">
              {item.num}
            </div>
            <h3 class="text-xl font-bold text-[var(--color-ink)] font-['Outfit'] mb-3 leading-snug">
              {item.title}
            </h3>
            <p class="text-sm text-stone-600 leading-relaxed font-['Manrope']">
              {item.desc}
            </p>
          </div>
          <div class="mt-8 pt-4 border-t border-stone-100 flex items-center text-xs font-semibold uppercase tracking-wider text-stone-400 group-hover:text-[var(--color-primary)] transition-colors">
            <span>Estándar Internacional</span>
            <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
