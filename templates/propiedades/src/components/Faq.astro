---
import { CONTENT } from "../site.ts";

const { faq } = CONTENT;
---

<section id="faq" class="py-20 sm:py-32 bg-[var(--color-paper)] relative border-b border-[var(--color-stone-border)]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-stone-200/60 border border-[var(--color-stone-border)] text-xs font-semibold uppercase tracking-wider text-stone-700 mb-4">
        PREGUNTAS FRECUENTES
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-[var(--color-ink)] font-['Outfit']">
        Claridad Absoluta en Cada Etapa
      </h2>
      <p class="mt-4 text-base sm:text-lg text-stone-600 font-['Manrope']">
        Respuestas directas a las consultas más habituales de nuestros inversores y propietarios.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {faq.map((item, idx) => (
        <details class="group bg-white rounded-2xl border border-[var(--color-stone-border)] hover:border-stone-400/80 transition-all overflow-hidden [&_summary::-webkit-details-marker]:hidden">
          <summary class="p-6 sm:p-8 cursor-pointer flex items-center justify-between gap-4 font-bold text-lg sm:text-xl text-[var(--color-ink)] font-['Outfit'] select-none">
            <span class="flex items-center gap-4">
              <span class="text-xs font-mono font-medium text-stone-400">0{idx + 1}</span>
              <span>{item.q}</span>
            </span>
            <div class="w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform duration-300">
              <svg class="w-4 h-4 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6 sm:px-8 sm:pb-8 pt-0 text-sm sm:text-base text-stone-600 font-['Manrope'] leading-relaxed border-t border-stone-100/80 mt-2">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
