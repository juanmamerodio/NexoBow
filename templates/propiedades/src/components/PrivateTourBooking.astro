---
import { CONTENT } from "../site.ts";
import Button from "./ui/Button.astro";

const { private_tour_booking, prestador } = CONTENT;
---

<section id="visita" class="py-20 sm:py-32 bg-stone-900 text-stone-100 relative overflow-hidden">
  <!-- Subtle ambient decorative glow -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-[var(--color-primary)]/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left Column: Value Proposition & Benefits -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-stone-800 border border-stone-700 text-xs font-semibold uppercase tracking-wider text-stone-300 mb-6">
          {private_tour_booking.badge}
        </div>
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white font-['Outfit'] mb-6">
          {private_tour_booking.title}
        </h2>
        <p class="text-base sm:text-lg text-stone-400 font-['Manrope'] mb-10 max-w-2xl leading-relaxed">
          {private_tour_booking.subtitle}
        </p>

        <!-- Value & Benefits List -->
        <div class="space-y-4 mb-10">
          {private_tour_booking.benefits.map((b) => (
            <div class="flex items-start gap-3.5 text-sm sm:text-base text-stone-300 font-['Manrope']">
              <div class="w-5 h-5 rounded-full bg-[var(--color-primary)]/20 border border-[var(--color-primary)] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>{b}</span>
            </div>
          ))}
        </div>

        <!-- Guarantee -->
        <div class="p-5 rounded-2xl bg-stone-800/60 border border-stone-700/80 text-xs sm:text-sm text-stone-400 font-['Manrope'] flex items-center gap-4">
          <svg class="w-6 h-6 text-stone-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>{private_tour_booking.guarantee}</span>
        </div>
      </div>

      <!-- Right Column: Card with Transparent Pricing & Direct Booking -->
      <div class="lg:col-span-5">
        <div class="bg-stone-800/90 backdrop-blur-md rounded-3xl p-8 sm:p-10 border border-stone-700 shadow-2xl relative">
          <!-- Fee Badge -->
          <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 uppercase tracking-wider mb-4 font-['Manrope']">
            {private_tour_booking.fee_badge}
          </div>

          <h3 class="text-2xl font-bold text-white font-['Outfit'] mb-2">
            {private_tour_booking.fee_title}
          </h3>

          <div class="my-6 py-6 border-y border-stone-700/80 flex items-baseline gap-3">
            <span class="text-4xl sm:text-5xl font-bold text-white font-['Outfit']">
              {private_tour_booking.fee_value}
            </span>
            <span class="text-xs text-stone-400 font-['Manrope']">
              {private_tour_booking.fee_subtext}
            </span>
          </div>

          <!-- CTAs -->
          <div class="space-y-4">
            <a
              href={prestador.whatsapp}
              class="w-full flex items-center justify-center gap-3 bg-[var(--color-primary)] text-white hover:opacity-90 active:scale-[0.98] font-medium rounded-full py-4 px-6 text-sm sm:text-base tracking-wide transition-all shadow-lg"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.073.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
              </svg>
              <span>{private_tour_booking.cta_whatsapp}</span>
            </a>

            <a
              href={`#contacto`}
              class="w-full flex items-center justify-center gap-2 border border-stone-600 text-stone-300 hover:text-white hover:border-stone-400 font-medium rounded-full py-3.5 px-6 text-sm tracking-wide transition-all"
            >
              <span>{private_tour_booking.cta_calendly}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </a>
          </div>

          <div class="mt-6 text-center text-xs text-stone-500 font-['Manrope']">
            {prestador.horarios}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
