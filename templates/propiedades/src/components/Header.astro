---
import { CONTENT } from "../site.ts";
import Button from "./ui/Button.astro";

const { prestador } = CONTENT;
---

<header class="fixed top-0 left-0 right-0 z-40 bg-[var(--color-paper)]/85 backdrop-blur-md border-b border-[var(--color-stone-border)] transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo / Identity -->
    <a href="#" class="flex items-center gap-3.5 group">
      <div class="w-10 h-10 rounded-lg border border-[var(--color-stone-border)] bg-stone-100/80 flex items-center justify-center p-2 group-hover:border-[var(--color-primary)] transition-colors">
        <svg class="w-full h-full text-[var(--color-primary)]" viewBox="0 0 73 25" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M48.5845 21.002V5.38415H49.9083V21.002H48.5845ZM42.6895 6.25541V5.00195H55.8034V6.25541H42.6895Z"/>
          <path d="M21.3485 21.002C20.1984 21.002 19.1681 20.7604 18.2576 20.2774C17.3631 19.7944 16.6523 19.1303 16.1251 18.285C15.614 17.4246 15.3584 16.4586 15.3584 15.3869V5.00195H16.6793V15.319C16.6793 16.2398 16.8584 17.0247 17.2737 17.719C17.6891 18.3982 18.2061 18.8742 18.9249 19.2516C19.6437 19.6138 20.454 19.8133 21.3485 19.8133C22.259 19.8133 23.0434 19.6138 23.7463 19.2516C24.4491 18.8742 24.9821 18.3982 25.3974 17.719C25.8127 17.0247 25.9258 16.2247 25.9258 15.319V5.00195H27.2467V15.3869C27.2467 16.4586 27.0751 17.4397 26.5479 18.285C26.0208 19.1303 25.31 19.7944 24.4155 20.2774C23.5209 20.7604 22.4986 21.002 21.3485 21.002Z"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M4.32812 19.9955V5.00195H5.63331V19.7448H14.378V20.9983H5.37227C4.79561 20.9983 4.32812 20.5493 4.32812 19.9955Z"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M59.4383 21.002C58.8554 21.002 58.3828 20.553 58.3828 19.9992V6.00472C58.3828 5.45091 58.8554 5.00195 59.4383 5.00195H68.5498V6.25541H59.7022L59.7022 12.1152H67.7892V13.3634H59.7022L59.7022 19.7485H68.5498V21.002H59.4383Z"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M29.8652 21.0019V6.00472C29.8652 5.45091 30.3382 5.00195 30.9215 5.00195H40.0323V6.25541H31.1856V12.3262H39.2038V13.543H31.1856V21.0019H29.8652Z"/>
          <path fill-rule="evenodd" clip-rule="evenodd" d="M64.0902 1H2.58339C1.17766 1 0.0380859 2.13107 0.0380859 3.52632V22.4737C0.0380859 23.8689 1.17766 25 2.58339 25H70.4159C71.8216 25 72.9612 23.8689 72.9612 22.4737V3.52632C72.9612 2.13107 71.8216 1 70.4159 1H68.2321L67.2315 2.26316H70.4159C71.1187 2.26316 71.6885 2.82869 71.6885 3.52632V22.4737C71.6885 23.1713 71.1187 23.7368 70.4159 23.7368H2.58339C1.88052 23.7368 1.31074 23.1713 1.31074 22.4737V3.52632C1.31074 2.82869 1.88053 2.26316 2.58339 2.26316H63.304L64.0902 1Z"/>
        </svg>
      </div>
      <div>
        <span class="block font-bold tracking-tight text-base sm:text-lg text-[var(--color-ink)] leading-none font-['Outfit']">
          {prestador.nombre}
        </span>
        <span class="block text-[11px] text-stone-500 tracking-wider uppercase mt-1 font-['Manrope']">
          {prestador.tagline.split("&")[0].trim()}
        </span>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-stone-600 font-['Manrope']">
      <a href="#propiedades" class="hover:text-[var(--color-primary)] transition-colors">Colección</a>
      <a href="#especificaciones" class="hover:text-[var(--color-primary)] transition-colors">Especificaciones</a>
      <a href="#proceso" class="hover:text-[var(--color-primary)] transition-colors">Proceso</a>
      <a href="#faq" class="hover:text-[var(--color-primary)] transition-colors">FAQ</a>
    </nav>

    <!-- Header Action Button -->
    <div class="flex items-center gap-3">
      <Button href={prestador.whatsapp} variant="nav">
        Agendar Visita
      </Button>
    </div>
  </div>
</header>
<div class="h-20"></div>
