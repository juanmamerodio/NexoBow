---
import { CONTENT } from "../site.ts";
import Button from "./ui/Button.astro";

const { hero, prestador } = CONTENT;
---

<section class="relative overflow-hidden pt-12 pb-20 sm:pt-20 sm:pb-28 architectural-grid border-b border-[var(--color-stone-border)]">
  <!-- Subtle ambient decorative glow -->
  <div class="absolute top-1/4 right-0 w-96 h-96 bg-[var(--color-primary)]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-80 h-80 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-stone-200/60 border border-[var(--color-stone-border)] text-xs font-semibold uppercase tracking-widest text-stone-700 mb-6 sm:mb-8">
        <span class="w-2 h-2 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
        {hero.badge}
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-[var(--color-ink)] leading-[1.08] font-['Outfit'] mb-6 sm:mb-8">
        {hero.title}
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-2xl text-stone-600 font-normal leading-relaxed max-w-3xl mb-10 font-['Manrope']">
        {hero.subtitle}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 mb-16">
        <Button href={prestador.whatsapp} variant="primary">
          {hero.cta_primary}
        </Button>
        <Button href="#propiedades" variant="outline">
          {hero.cta_secondary}
        </Button>
      </div>
    </div>

    <!-- Architectural Key Metrics (section_statistic) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 pt-10 border-t border-[var(--color-stone-border)]">
      <div class="bg-white/60 backdrop-blur-sm p-6 sm:p-8 rounded-2xl border border-[var(--color-stone-border)] hover:border-stone-300 transition-all">
        <div class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] font-['Outfit'] tracking-tight mb-2">
          {hero.stat_1_value}
        </div>
        <p class="text-xs sm:text-sm text-stone-600 font-medium leading-relaxed font-['Manrope']">
          {hero.stat_1_label}
        </p>
      </div>

      <div class="bg-white/60 backdrop-blur-sm p-6 sm:p-8 rounded-2xl border border-[var(--color-stone-border)] hover:border-stone-300 transition-all">
        <div class="text-3xl sm:text-4xl font-bold text-[var(--color-primary)] font-['Outfit'] tracking-tight mb-2">
          {hero.stat_2_value}
        </div>
        <p class="text-xs sm:text-sm text-stone-600 font-medium leading-relaxed font-['Manrope']">
          {hero.stat_2_label}
        </p>
      </div>

      <div class="bg-white/60 backdrop-blur-sm p-6 sm:p-8 rounded-2xl border border-[var(--color-stone-border)] hover:border-stone-300 transition-all">
        <div class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] font-['Outfit'] tracking-tight mb-2">
          {hero.stat_3_value}
        </div>
        <p class="text-xs sm:text-sm text-stone-600 font-medium leading-relaxed font-['Manrope']">
          {hero.stat_3_label}
        </p>
      </div>
    </div>
  </div>
</section>
