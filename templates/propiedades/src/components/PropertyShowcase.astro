---
import { CONTENT } from "../site.ts";
import Button from "./ui/Button.astro";

const { property_showcase, prestador } = CONTENT;
---

<section id="propiedades" class="py-20 sm:py-32 bg-[var(--color-paper)] relative border-b border-[var(--color-stone-border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-stone-200/60 border border-[var(--color-stone-border)] text-xs font-semibold uppercase tracking-wider text-stone-700 mb-4">
          {property_showcase.badge}
        </div>
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-[var(--color-ink)] font-['Outfit']">
          {property_showcase.title}
        </h2>
        <p class="mt-4 text-base sm:text-lg text-stone-600 font-['Manrope']">
          {property_showcase.subtitle}
        </p>
      </div>

      <div>
        <Button href={prestador.whatsapp} variant="outline">
          Solicitar Portfolio Completo
        </Button>
      </div>
    </div>

    <!-- Properties Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      {property_showcase.items.map((prop, idx) => (
        <div class="group bg-white rounded-3xl border border-[var(--color-stone-border)] hover:border-stone-400/80 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between">
          <!-- Card Header / Visual Accent -->
          <div class="p-8 sm:p-10 border-b border-stone-100 relative bg-stone-50/50">
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="text-xs font-mono font-semibold tracking-wider text-stone-400">
                {prop.id}
              </span>
              <div class="flex items-center gap-2">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-stone-200/70 text-stone-700 font-['Manrope']">
                  {prop.tag}
                </span>
                <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-accent)] text-[var(--color-primary)] font-['Manrope']">
                  {prop.badge}
                </span>
              </div>
            </div>

            <h3 class="text-2xl sm:text-3xl font-bold text-[var(--color-ink)] font-['Outfit'] mb-2 group-hover:text-[var(--color-primary)] transition-colors">
              {prop.title}
            </h3>
            <p class="text-sm font-medium text-stone-500 font-['Manrope'] flex items-center gap-2">
              <svg class="w-4 h-4 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {prop.location}
            </p>
          </div>

          <!-- Specs & Features -->
          <div class="p-8 sm:p-10 flex-1 flex flex-col justify-between">
            <div>
              <div class="inline-block font-semibold text-sm text-[var(--color-primary)] uppercase tracking-wider mb-3 font-['Manrope']">
                {prop.type}
              </div>
              <p class="text-sm sm:text-base text-stone-600 leading-relaxed font-['Manrope'] mb-8">
                {prop.specs}
              </p>
            </div>

            <!-- Price & Action -->
            <div class="pt-6 border-t border-stone-100 flex items-center justify-between gap-4">
              <div>
                <span class="block text-xs uppercase text-stone-400 font-medium font-['Manrope']">Inversión Desde</span>
                <span class="text-xl sm:text-2xl font-bold text-[var(--color-ink)] font-['Outfit']">
                  {prop.price}
                </span>
              </div>
              <Button href={prestador.whatsapp} variant="pill">
                Ver Detalles
              </Button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
