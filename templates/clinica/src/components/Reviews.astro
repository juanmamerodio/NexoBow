---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { reviews } = CONTENT;
const consent = CONTENT.consentimiento_testimonios;
const visibles = consent
  ? reviews.items
  : reviews.items.filter((review) => review.fuente === "Google Maps");
---

{
  visibles.length > 0 && (
    <section id="opiniones" class="border-b border-(--color-ink)/10">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
        <SectionHead tag={reviews.tag} title={reviews.titulo} />

        <div class="mt-14 grid gap-8 md:grid-cols-2">
          {
            visibles.map((review) => (
              <figure class="flex flex-col justify-between rounded-[16px] border border-(--color-ink)/12 bg-white/80 p-8 shadow-sm transition-all duration-300 hover:border-(--color-primary)">
                <div>
                  <div class="flex items-center gap-1 text-(--color-accent)">
                    {Array.from({ length: 5 }).map(() => (
                      <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                  <blockquote class="mt-5 font-display text-lg font-medium leading-relaxed text-(--color-ink)">
                    “{review.texto}”
                  </blockquote>
                </div>
                <figcaption class="mt-8 border-t border-(--color-ink)/10 pt-4 flex items-center justify-between">
                  <div>
                    <p class="font-display text-sm font-bold text-(--color-ink)">{review.nombre}</p>
                    <p class="text-[11px] uppercase tracking-wider text-(--color-primary) font-semibold">
                      {review.fuente}
                    </p>
                  </div>
                  <span class="rounded-full bg-(--color-primary)/10 px-2.5 py-1 text-[10px] font-bold text-(--color-primary) uppercase tracking-wider">
                    Verificada
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>

        {
          !consent && (
            <p class="mt-8 text-sm text-(--color-ink)/50">
              Reseñas públicas de pacientes, verificadas con su fuente.
            </p>
          )
        }
      </div>
    </section>
  )
}
