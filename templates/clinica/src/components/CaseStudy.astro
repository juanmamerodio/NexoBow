---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { casos } = CONTENT;
const consent = CONTENT.consentimiento_testimonios;
---

{
  consent && casos.items.length > 0 && (
    <section id="casos" class="border-b border-(--color-ink)/10 bg-white/30">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
        <div class="grid gap-14 lg:grid-cols-12 items-start">
          <div class="lg:col-span-5 lg:sticky lg:top-28">
            <SectionHead tag={casos.tag} title={casos.titulo} />
          </div>
          <div class="lg:col-span-7 space-y-6">
            {
              casos.items.map((caso) => (
                <div class="rounded-[16px] border border-(--color-ink)/12 bg-white/80 p-8 shadow-sm transition-all duration-300 hover:border-(--color-primary)">
                  <h3 class="font-display text-xl font-bold tracking-tight text-(--color-ink)">
                    {caso.titulo}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-(--color-ink)/75 font-sans">
                    {caso.descripcion}
                  </p>
                  <div class="mt-5 rounded-[10px] bg-(--color-primary)/5 p-4 border border-(--color-primary)/10">
                    <p class="font-display text-sm font-semibold text-(--color-primary)">
                      <span class="font-bold text-(--color-accent)">Resultado Clínico:</span> {caso.resultado}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  )
}
