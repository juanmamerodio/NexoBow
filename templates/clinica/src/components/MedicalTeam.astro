---
import { CONTENT } from "../site";

const team = CONTENT.team || {};
const members = team.members || [];

function formatEmphasis(text: string) {
  if (!text) return "";
  return text.replace(
    /\*([^*]+)\*/g,
    '<span class="italic font-normal text-(--color-accent)">$1</span>'
  );
}

const formattedTitle = formatEmphasis(
  team.titulo ||
    "Cirujanos especialistas con *trayectoria hospitalaria y matrícula verificada*"
);
---

<section
  id="equipo"
  class="relative border-b border-(--color-primary)/10 bg-(--color-paper) py-16 sm:py-24"
  data-section="team"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="font-mono text-xs font-semibold tracking-[0.3em] uppercase text-(--color-primary)/80"
      >
        {team.tag || "03 · CUADRO MÉDICO"}
      </p>

      <h2
        class="mt-3 font-display text-2xl font-bold tracking-tight text-(--color-ink) sm:text-3xl md:text-4xl"
        set:html={formattedTitle}
      />

      <p class="mt-4 text-base leading-relaxed text-(--color-ink)/75 sm:text-lg">
        {
          team.bajada ||
            "Nuestros directores y cirujanos cuentan con más de 15 años de residencia y docencia en cirugía reconstructiva e implantología de alta complejidad."
        }
      </p>
    </div>

    {/* Tarjetas de Especialistas */}
    <div class="mt-12 grid grid-cols-1 gap-8 sm:mt-16 md:grid-cols-2 lg:grid-cols-3">
      {
        members.map((member) => (
          <div class="flex flex-col justify-between rounded-2xl border border-(--color-primary)/15 bg-(--color-primary)/5 p-6 sm:p-8 transition-all duration-300 hover:border-(--color-accent) hover:bg-(--color-primary)/10 hover:shadow-md">
            <div>
              {/* Badge de Matrícula */}
              <div class="flex items-center justify-between border-b border-(--color-primary)/10 pb-3">
                <span class="font-mono text-xs font-semibold tracking-wider text-(--color-primary)">
                  {member.matricula}
                </span>
                <span class="rounded-full bg-(--color-accent)/20 px-2 py-0.5 text-[10px] font-semibold text-(--color-primary)">
                  Acreditado
                </span>
              </div>

              <h3 class="mt-4 font-display text-xl font-bold text-(--color-ink)">
                {member.nombre}
              </h3>

              <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-(--color-primary)">
                {member.cargo}
              </p>

              <p class="mt-3 text-xs font-medium text-(--color-accent) leading-snug">
                {member.especialidad}
              </p>

              <p class="mt-3 text-sm leading-relaxed text-(--color-ink)/75">
                {member.resumen}
              </p>
            </div>

            <div class="mt-6 border-t border-(--color-primary)/10 pt-3 flex items-center justify-between text-xs text-(--color-ink)/60">
              <span>Bioética & Secreto Médico</span>
              <span class="font-mono text-(--color-accent)">Cumplimiento Ley 25.326</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
