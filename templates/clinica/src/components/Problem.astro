---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { problema } = CONTENT;
---

<section id="problema" class="border-b border-(--color-ink)/10">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
    <div class="grid gap-14 lg:grid-cols-12 items-start">
      
      <!-- Cabecera de Problema / Diagnóstico del Paciente -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <SectionHead
          tag={problema.tag}
          title={problema.titulo}
          description={problema.descripcion}
        />
        
        <div class="mt-8 rounded-[12px] bg-(--color-primary)/5 p-6 border border-(--color-primary)/15">
          <p class="text-xs uppercase tracking-[0.2em] font-semibold text-(--color-primary)">
            Protocolo de Intervención Temprana
          </p>
          <p class="mt-2 text-sm leading-relaxed text-(--color-ink)/75">
            Cada semana de demora en un cuadro clínico o quirúrgico incrementa la complejidad del tratamiento. Una valoración inicial permite frenar el deterioro antes de que sea irreversible.
          </p>
        </div>
      </div>

      <!-- Tarjetas de Dolores / Friction Points Clínicos con bordes suaves y acento menta -->
      <div class="lg:col-span-7">
        <div class="space-y-6">
          {
            problema.pains.map((pain, idx) => (
              <div class="relative rounded-[16px] border border-(--color-ink)/12 bg-white/75 p-8 transition-all duration-300 hover:border-(--color-accent) hover:shadow-md">
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-2 rounded-full bg-(--color-primary)/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.15em] text-(--color-primary)">
                    <span class="h-1.5 w-1.5 rounded-full bg-(--color-accent)"></span>
                    {pain.tag}
                  </span>
                  <span class="font-display text-sm font-semibold text-(--color-ink)/40">
                    0{idx + 1}
                  </span>
                </div>
                
                <h3 class="mt-4 font-display text-xl sm:text-2xl font-bold tracking-tight text-(--color-ink)">
                  {pain.t}
                </h3>
                
                <p class="mt-3 text-sm sm:text-base leading-relaxed text-(--color-ink)/75 font-sans">
                  {pain.d}
                </p>
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>
</section>
