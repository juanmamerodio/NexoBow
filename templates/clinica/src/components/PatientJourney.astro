---
import { CONTENT } from "../site";

const journey = CONTENT.journey || {};
const steps = journey.steps || [];

function formatEmphasis(text: string) {
  if (!text) return "";
  return text.replace(
    /\*([^*]+)\*/g,
    '<span class="italic font-normal text-(--color-accent)">$1</span>'
  );
}

const formattedTitle = formatEmphasis(
  journey.titulo ||
    "De la valoración inicial al alta definitiva: *un protocolo sin fricciones*"
);
---

<section
  id="proceso"
  class="relative border-b border-(--color-primary)/10 bg-(--color-primary)/5 py-16 sm:py-24"
  data-section="journey"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="font-mono text-xs font-semibold tracking-[0.3em] uppercase text-(--color-primary)/80"
      >
        {journey.tag || "04 · EL PROCESO CLÍNICO"}
      </p>

      <h2
        class="mt-3 font-display text-2xl font-bold tracking-tight text-(--color-ink) sm:text-3xl md:text-4xl"
        set:html={formattedTitle}
      />

      <p class="mt-4 text-base leading-relaxed text-(--color-ink)/75 sm:text-lg">
        {
          journey.bajada ||
            "+20 Países · Un Solo Destino. Diseñamos un camino estructurado para pacientes locales e internacionales."
        }
      </p>
    </div>

    {/* Línea de Tiempo de 4 Pasos */}
    <div class="mt-12 grid grid-cols-1 gap-6 sm:mt-16 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        steps.map((step) => (
          <div class="relative flex flex-col justify-between rounded-xl border border-(--color-primary)/15 bg-(--color-paper) p-6 shadow-xs transition-all duration-300 hover:border-(--color-accent) hover:shadow-md">
            <div>
              <div class="flex items-center justify-between border-b border-(--color-primary)/10 pb-3">
                <span class="font-mono text-xl font-bold text-(--color-accent)">
                  {step.fase}
                </span>
                <span class="rounded bg-(--color-primary)/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-(--color-primary)">
                  {step.tiempo}
                </span>
              </div>

              <h3 class="mt-4 font-display text-base font-bold text-(--color-ink) sm:text-lg">
                {step.nombre}
              </h3>

              <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-(--color-ink)/75">
                {step.detalle}
              </p>
            </div>

            <div class="mt-5 border-t border-(--color-primary)/10 pt-3 text-[11px] font-mono text-(--color-primary)/60">
              Protocolo Estandarizado
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
