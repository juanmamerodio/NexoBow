---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { pasos } = CONTENT;
---

<section id="metodo" class="border-b border-(--color-ink)/10 bg-white/40">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
    <SectionHead tag={pasos.tag} title={pasos.titulo} align="center" />

    <!-- Grid de Fases de Tratamiento Quirúrgico / Clínico -->
    <div class="mt-16 grid gap-8 md:grid-cols-3">
      {
        pasos.steps.map((step) => (
          <div class="relative flex flex-col justify-between rounded-[16px] border border-(--color-ink)/12 bg-white/80 p-8 shadow-sm transition-all duration-300 hover:border-(--color-primary) hover:shadow-md">
            <div>
              <div class="flex items-center justify-between border-b border-(--color-ink)/10 pb-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-[10px] bg-(--color-primary) font-display text-sm font-bold text-(--color-paper)">
                  {step.n}
                </span>
                <span class="h-2 w-2 rounded-full bg-(--color-accent)"></span>
              </div>
              
              <h3 class="mt-6 font-display text-xl font-bold tracking-tight text-(--color-ink)">
                {step.k}
              </h3>
              
              <p class="mt-3 text-sm leading-relaxed text-(--color-ink)/75 font-sans">
                {step.d}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-(--color-ink)/10 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-(--color-primary)">
              <span>Protocolo Seguro</span>
              <span class="text-(--color-accent)">✦</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Cierre del método con garantía de recuperación -->
    <div class="mt-14 mx-auto max-w-2xl text-center rounded-[12px] bg-(--color-primary)/5 p-6 border border-(--color-primary)/15">
      <p class="font-display text-base font-semibold text-(--color-primary)">
        {pasos.footer}
      </p>
    </div>
  </div>
</section>
