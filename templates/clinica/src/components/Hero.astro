---
import Button from "./ui/Button.astro";
import Lead from "./ui/Lead.astro";
import { CONTENT } from "../site";

const { prestador, pasos, links, hero, marquee } = CONTENT;
---

<section id="inicio" class="relative overflow-hidden border-b border-(--color-ink)/10">
  <div class="mx-auto max-w-7xl px-6 pt-12 pb-16 lg:px-12 lg:pt-20 lg:pb-24">
    <!-- Asymmetric Grid Layout de Prestigio Médico Quirúrgico (7/5 split) -->
    <div class="grid items-stretch gap-12 lg:grid-cols-12 lg:gap-14">
      
      <!-- Columna Principal: Copy de autoridad clínica, badges y CTAs -->
      <div class="flex flex-col justify-between lg:col-span-7">
        <div>
          <!-- Badge de certificación y prestigio con acento menta quirúrgico -->
          <div class="inline-flex items-center gap-2.5 rounded-[12px] bg-(--color-primary)/10 px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-(--color-primary)">
            <span class="h-2 w-2 rounded-full bg-(--color-accent) animate-pulse" aria-hidden="true"></span>
            <span>{hero.eyebrow}</span>
          </div>

          <!-- Titular de Prestigio Médico (Plus Jakarta Sans) -->
          <h1 class="mt-6 font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.08] tracking-tight text-balance text-(--color-ink)">
            <Lead text={prestador.titulo} emClass="text-(--color-primary) italic font-medium" />
          </h1>

          <!-- Bajada de alivio y claridad clínica -->
          <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-(--color-ink)/75 font-sans">
            {prestador.bajada}
          </p>

          <!-- Badges de Certificación Quirúrgica -->
          <div class="mt-8 flex flex-wrap items-center gap-6 text-xs text-(--color-ink)/70">
            <div class="flex items-center gap-2">
              <div class="flex h-6 w-6 items-center justify-center rounded-full bg-(--color-accent)/20 text-(--color-primary)">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M20 6L9 17l-5-5"></path>
                </svg>
              </div>
              <span class="font-medium">Certificación Internacional de Bioseguridad</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex h-6 w-6 items-center justify-center rounded-full bg-(--color-accent)/20 text-(--color-primary)">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M20 6L9 17l-5-5"></path>
                </svg>
              </div>
              <span class="font-medium">Diagnóstico 3D en el acto</span>
            </div>
          </div>
        </div>

        <!-- Botones y Garantía -->
        <div class="mt-10 pt-6 border-t border-(--color-ink)/10">
          <div class="flex flex-wrap items-center gap-4">
            <Button href={links.calendly} label="Agendá tu valoración inicial" external={true} />
            <Button href={links.whatsapp} label="Consultá por WhatsApp" variant="outline" external={true} />
          </div>
          <p class="mt-4 text-xs tracking-wider uppercase text-(--color-ink)/60">
            Valoración clínica sin compromiso · 30 minutos · Presencial u Online
          </p>
        </div>
      </div>

      <!-- Columna Lateral: Tarjeta Clínica de Alta Complejidad con curvatura 12px y acentos menta -->
      <div class="flex flex-col justify-center lg:col-span-5">
        <div class="relative rounded-[16px] border border-(--color-ink)/15 bg-white/80 p-8 shadow-sm backdrop-blur-sm lg:p-10">
          
          <div class="flex items-center justify-between border-b border-(--color-ink)/10 pb-4">
            <p class="text-[11px] font-bold uppercase tracking-[0.25em] text-(--color-primary)">
              {hero.card_caption}
            </p>
            <span class="flex h-2.5 w-2.5 rounded-full bg-(--color-accent)"></span>
          </div>

          <ol class="mt-8 space-y-7">
            {
              pasos.steps.map((step) => (
                <li class="flex items-start gap-4">
                  <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-[10px] bg-(--color-primary) text-xs font-bold text-(--color-paper)">
                    {step.n}
                  </div>
                  <div>
                    <h3 class="font-display text-base font-bold text-(--color-ink)">
                      {step.k}
                    </h3>
                    <p class="mt-1 text-xs leading-5 text-(--color-ink)/75 font-sans">
                      {step.d}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="mt-8 rounded-[10px] bg-(--color-paper)/70 p-4 border border-(--color-ink)/10">
            <p class="text-xs leading-5 text-(--color-ink)/80">
              <span class="font-bold text-(--color-primary)">Garantía de Cuidado:</span> {hero.card_footer}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee Quirúrgico & Hospitalario -->
  <div class="marquee overflow-hidden border-y border-(--color-ink)/10 bg-(--color-primary) py-3 text-(--color-paper)" aria-hidden="true">
    <div class="marquee-track flex w-max whitespace-nowrap">
      {
        [0, 1].map(() => (
          <div class="flex items-center">
            {marquee.items.map((item) => (
              <span class="px-6 text-xs font-semibold uppercase tracking-[0.2em] text-(--color-paper)/90">
                {item} <span class="text-(--color-accent) mx-1">✦</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
