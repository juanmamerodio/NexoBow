---
import { CONTENT } from "../site";

const reviews = CONTENT.reviews || {};
const items = reviews.items || [];

function formatEmphasis(text: string) {
  if (!text) return "";
  return text.replace(
    /\*([^*]+)\*/g,
    '<span class="italic font-normal text-(--color-accent)">$1</span>'
  );
}

const formattedTitle = formatEmphasis(
  reviews.titulo ||
    "Historias reales de pacientes que *recuperaron su bienestar y sonrisa*"
);
---

<section
  id="casos"
  class="relative border-b border-(--color-primary)/10 bg-(--color-primary)/5 py-16 sm:py-24"
  data-section="reviews"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="font-mono text-xs font-semibold tracking-[0.3em] uppercase text-(--color-primary)/80"
      >
        {reviews.tag || "06 · CASOS DOCUMENTADOS"}
      </p>

      <h2
        class="mt-3 font-display text-2xl font-bold tracking-tight text-(--color-ink) sm:text-3xl md:text-4xl"
        set:html={formattedTitle}
      />

      <p class="mt-4 text-base leading-relaxed text-(--color-ink)/75 sm:text-lg">
        Casos clínicos auditados con consentimiento informado según normativas de bioética y ejercicio de la medicina.
      </p>
    </div>

    {/* Tarjetas de Testimonios */}
    <div class="mt-12 grid grid-cols-1 gap-8 sm:mt-16 md:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <div class="flex flex-col justify-between rounded-2xl border border-(--color-primary)/15 bg-(--color-paper) p-6 sm:p-8 shadow-xs transition-all duration-300 hover:border-(--color-accent) hover:shadow-md">
            <div>
              {/* 5 Estrellas & Badge */}
              <div class="flex items-center justify-between border-b border-(--color-primary)/10 pb-3">
                <div class="flex items-center gap-1 text-amber-500">
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <span class="rounded bg-(--color-primary)/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-(--color-primary)">
                  Verificado
                </span>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-(--color-ink)/80 italic">
                "{item.texto}"
              </p>
            </div>

            <div class="mt-6 border-t border-(--color-primary)/10 pt-4">
              <p class="font-display text-sm font-bold text-(--color-ink)">
                {item.nombre}
              </p>
              {item.rol && (
                <p class="mt-0.5 text-xs text-(--color-primary) font-medium">
                  {item.rol}
                </p>
              )}
              <p class="mt-1 text-[11px] font-mono text-(--color-ink)/60">
                {item.fuente || "Paciente Clínico Verificado"}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
