---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { faq } = CONTENT;
---

<section id="faq" class="border-b border-(--color-ink)/10">
  <div class="mx-auto max-w-3xl px-6 py-20 lg:py-28">
    <SectionHead tag={faq.tag} title={faq.titulo} align="center" />

    <div class="mt-12">
      {
        faq.items.map((item) => (
          <details class="group border-t border-(--color-ink)/10 py-6 last:border-b">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-semibold tracking-tight [&::-webkit-details-marker]:hidden"
            >
              <span>{item.q}</span>
              <span
                aria-hidden="true"
                class="font-display text-2xl text-(--color-primary) transition-transform duration-300 group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-4 max-w-2xl leading-7 text-(--color-ink)/70">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
