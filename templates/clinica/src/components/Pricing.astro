---
import Button from "./ui/Button.astro";
import SectionHead from "./ui/SectionHead.astro";
import { ars, CONTENT } from "../site";

const { pricing, links } = CONTENT;
---

<section id="precios" class="border-b border-(--color-ink)/10">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
    <SectionHead tag={pricing.tag} title={pricing.titulo} align="center" />

    <div class="mx-auto mt-14 max-w-2xl rounded-[18px] bg-(--color-primary) p-10 text-(--color-paper) shadow-xl lg:p-14 border border-(--color-accent)/30">
      <div class="flex items-center justify-between border-b border-(--color-paper)/15 pb-4">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-(--color-accent)">
          {pricing.plan}
        </p>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-accent)/20 px-3 py-1 text-[11px] font-bold text-(--color-paper)">
          <span class="h-1.5 w-1.5 rounded-full bg-(--color-accent)"></span>
          Sin compromiso
        </span>
      </div>

      <div class="mt-8">
        <p class="font-display text-5xl font-bold tracking-tight text-white">
          {ars(pricing.precio_ars)}
        </p>
        <p class="mt-2 text-sm font-medium text-(--color-paper)/80">{pricing.precio_label}</p>
        <p class="mt-2 text-sm leading-relaxed text-(--color-paper)/70 font-sans">
          {pricing.precio_sub}
        </p>
      </div>

      <hr class="my-8 border-(--color-paper)/15" />

      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-(--color-accent)">
        {pricing.detalle_titulo}
      </p>
      <ul class="mt-6 space-y-4">
        {
          pricing.incluido.map((item) => (
            <li class="flex items-start gap-3 leading-6 text-sm text-(--color-paper)/90">
              <span aria-hidden="true" class="font-bold text-(--color-accent) text-base leading-none mt-0.5">
                ✓
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-10">
        <Button
          href={links.calendly}
          label={pricing.cta}
          variant="light"
          size="lg"
          external={true}
        />
      </div>
      <p class="mt-6 text-xs text-center text-(--color-paper)/60 uppercase tracking-wider">
        {pricing.garantia}
      </p>
    </div>
  </div>
</section>
