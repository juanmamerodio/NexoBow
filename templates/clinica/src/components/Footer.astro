---
import { CONTENT } from "../site";
import { SECTION_NAV } from "../sections";

const { prestador, links, footer } = CONTENT;
const year = new Date().getFullYear();
---

<footer class="border-t border-(--color-ink)/10 bg-white/60">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 lg:px-12 md:grid-cols-3">
    <!-- Identidad Institucional SkyClinics -->
    <div>
      <div class="flex items-center gap-3">
        <div
          class="flex h-8 w-8 items-center justify-center rounded-[8px] bg-(--color-primary) text-(--color-paper)"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2v20M2 12h20"></path>
          </svg>
        </div>
        <p class="font-display text-xl font-bold tracking-tight text-(--color-ink)">
          {prestador.nombre}
        </p>
      </div>
      <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-(--color-primary)">
        {prestador.rol}
      </p>
      <p class="mt-4 max-w-sm text-xs leading-relaxed text-(--color-ink)/75 font-sans">
        {footer.blurb}
      </p>
    </div>

    <!-- Navegación Institucional -->
    <nav aria-label="Secciones">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-(--color-primary)">
        Protocolos & Especialidades
      </p>
      <ul class="mt-4 space-y-2.5">
        {
          SECTION_NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-xs font-medium uppercase tracking-wider text-(--color-ink)/70 transition-colors hover:text-(--color-primary)"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Canales Directos de Atención Médica -->
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-(--color-primary)">
        Contacto Clínico
      </p>
      <ul class="mt-4 space-y-3">
        <li>
          <a
            href={links.calendly}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-sm font-semibold text-(--color-primary) hover:underline"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-(--color-accent)"></span>
            Agendá tu valoración inicial online
          </a>
        </li>
        <li>
          <a
            href={links.whatsapp}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 text-sm font-semibold text-(--color-primary) hover:underline"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-(--color-accent)"></span>
            Secretaría Médica por WhatsApp
          </a>
        </li>
      </ul>
      <p class="mt-6 text-[11px] leading-relaxed text-(--color-ink)/60">
        Cumplimiento estricto de la Ley 25.326 de Protección de Datos Personales y Secreto Médico.
      </p>
    </div>
  </div>

  <div class="border-t border-(--color-ink)/10 bg-white/40">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-6 text-xs text-(--color-ink)/60 lg:px-12">
      <p>
        © {year} {prestador.nombre} · {prestador.rol}
      </p>
      <p class="font-medium text-(--color-primary)">{footer.credit}</p>
    </div>
  </div>
</footer>
