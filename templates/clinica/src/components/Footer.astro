---
import { CONTENT } from "../site";

const prestador = CONTENT.prestador || {};
const footer = CONTENT.footer || {};
const prestadorNombre = prestador.nombre || "SkyClinics Argentina";
---

<footer
  class="relative border-t border-(--color-primary)/20 bg-(--color-primary) text-(--color-paper) pt-16 pb-12"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      {/* Columna Marca & Identidad */}
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3">
            <div
              class="flex h-9 w-9 items-center justify-center rounded-lg bg-(--color-accent) text-(--color-primary) shadow-sm"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 4v16M4 12h16" />
              </svg>
            </div>
            <span
              class="font-display text-xl font-bold tracking-[0.14em] uppercase text-(--color-paper)"
            >
              {prestadorNombre}
            </span>
          </div>

          <p class="mt-4 max-w-sm text-xs sm:text-sm leading-relaxed text-(--color-paper)/75">
            {
              footer.blurb ||
                "Centro Médico y Odontológico de Cirugía Guiada y Rehabilitación de Alta Complejidad. Diagnóstico de precisión, tecnología de vanguardia y cuidado centrado en la persona."
            }
          </p>
        </div>

        <div class="mt-6 text-xs text-(--color-accent) font-mono">
          Habilitación Sanitaria Ministerial Nº 48.291
        </div>
      </div>

      {/* Columna Navegación Rápida */}
      <div class="lg:col-span-3">
        <p class="text-xs font-bold tracking-[0.14em] uppercase text-(--color-accent)">
          Especialidades & Servicios
        </p>
        <ul class="mt-4 space-y-2.5 text-xs text-(--color-paper)/80">
          <li>
            <a href="#especialidades" class="transition-colors hover:text-(--color-paper)">
              Implantología Digital 3D
            </a>
          </li>
          <li>
            <a href="#especialidades" class="transition-colors hover:text-(--color-paper)">
              Rehabilitación Oral Completa
            </a>
          </li>
          <li>
            <a href="#especialidades" class="transition-colors hover:text-(--color-paper)">
              Arquitectura de la Sonrisa DSD
            </a>
          </li>
          <li>
            <a href="#tecnologia" class="transition-colors hover:text-(--color-paper)">
              Tomografía CBCT & Laboratorio In-House
            </a>
          </li>
          <li>
            <a href="#instalaciones" class="transition-colors hover:text-(--color-paper)">
              Quirófanos con Flujo Laminar
            </a>
          </li>
        </ul>
      </div>

      {/* Columna Contacto & Guardia */}
      <div class="lg:col-span-4">
        <p class="text-xs font-bold tracking-[0.14em] uppercase text-(--color-accent)">
          Contacto & Guardia Médica
        </p>
        <div class="mt-4 space-y-3 text-xs text-(--color-paper)/80">
          <p class="flex items-start gap-2">
            <span class="text-(--color-accent)">📍</span>
            <span>{footer.direccion || "Av. del Libertador 4980, CABA"}</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-(--color-accent)">📞</span>
            <span>{footer.telefono || "+54 11 5555-0000"}</span>
          </p>
          <div class="mt-4 rounded-lg bg-black/20 p-3 border border-(--color-accent)/20">
            <p class="font-semibold text-(--color-accent) text-[11px] uppercase tracking-wider">
              {footer.guardia || "Guardia Médica Postoperatoria 24/7"}
            </p>
            <p class="text-[11px] text-(--color-paper)/70 mt-1">
              Atención prioritaria y soporte continuo para pacientes en recuperación.
            </p>
          </div>
        </div>
      </div>
    </div>

    {/* Barra Inferior Legal & Ley 25.326 */}
    <div
      class="mt-12 border-t border-(--color-paper)/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-(--color-paper)/60"
    >
      <p>
        © {new Date().getFullYear()} {prestadorNombre}. Todos los derechos reservados.
      </p>

      <p class="text-center sm:text-right max-w-md">
        Cumplimiento estricto con la Ley 25.326 de Protección de Datos Personales y normas de bioética del Colegio Médico.
      </p>

      <p>
        {footer.credit || "Landing desarrollada con NexoBow"}
      </p>
    </div>
  </div>
</footer>
