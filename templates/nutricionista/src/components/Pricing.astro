---
import { CONTENT, ars } from "../site";

const { pricing, links } = CONTENT;
---

<section id="precios" class="relative mx-auto max-w-5xl px-6 py-24">
  <div class="text-center mb-14">
    <div
      class="inline-block rounded-full bg-white/5 border border-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-wider text-(--color-primary) mb-3"
    >
      {pricing.tag}
    </div>
    <h2
      class="font-sans text-4xl font-extrabold tracking-tight text-white md:text-5xl"
    >
      {pricing.titulo}
    </h2>
  </div>

  <div class="grid gap-8 md:grid-cols-2 items-stretch">
    <div
      class="relative overflow-hidden rounded-[36px] border-2 border-(--color-primary)/50 bg-gradient-to-b from-neutral-900 via-neutral-950 to-black p-8 sm:p-10 shadow-[0_0_50px_color-mix(in_oklab,var(--color-primary)_20%,transparent)] flex flex-col justify-between"
    >
      <div class="absolute -top-12 -right-12 h-36 w-36 rounded-full bg-(--color-primary)/30 blur-3xl"></div>

      <div>
        <span
          class="inline-block rounded-full bg-(--color-primary) px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-(--color-on-primary) shadow-sm"
        >
          {pricing.plan}
        </span>
        <p class="mt-6 text-sm uppercase tracking-wider text-white/60 font-medium">
          {pricing.precio_label}
        </p>
        <p class="mt-2 font-sans text-6xl font-extrabold text-(--color-primary)">
          {ars(pricing.precio_ars)}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-white/70">{pricing.precio_sub}</p>
      </div>

      <div class="mt-8 rounded-2xl bg-white/5 border border-white/10 p-4">
        <p class="text-sm font-semibold text-(--color-primary) flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-(--color-primary) animate-ping"></span>
          {pricing.garantia}
        </p>
      </div>
    </div>

    <div
      class="rounded-[36px] border border-white/10 bg-white/[0.03] p-8 sm:p-10 backdrop-blur-md flex flex-col justify-between"
    >
      <div>
        <h3 class="font-sans text-2xl font-bold text-white">{pricing.detalle_titulo}</h3>

        <ul class="mt-6 space-y-4">
          {pricing.incluido.map((i) => (
            <li class="flex items-start gap-3 text-sm text-white/80">
              <span
                class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-(--color-primary)/20 text-(--color-primary)"
              >
                ✓
              </span>
              <span>{i}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-10">
        <a
          href={links.calendly}
          class="group relative flex w-full items-center justify-between rounded-full bg-white/10 p-2 pl-6 pr-2 text-sm font-bold tracking-wide text-white backdrop-blur-md border border-white/20 transition-all duration-300 hover:border-(--color-primary) hover:bg-white/15 hover:shadow-[0_0_30px_color-mix(in_oklab,var(--color-primary)_40%,transparent)]"
        >
          <span>{pricing.cta}</span>
          <span
            class="flex h-10 w-10 items-center justify-center rounded-full bg-(--color-primary) text-(--color-on-primary) transition-all duration-300 group-hover:scale-105 group-hover:translate-x-0.5"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>