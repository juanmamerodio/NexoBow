---
import Button from "./ui/Button.astro";
import Lead from "./ui/Lead.astro";
import { CONTENT } from "../site";

const { pricing, links, final_cta } = CONTENT;
---

<section class="bg-(--color-primary) text-(--color-on-primary)">
  <div class="mx-auto max-w-4xl px-6 py-24 text-center lg:py-32">
    <p
      class="flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-(--color-on-primary)/70"
    >
      <span aria-hidden="true" class="h-px w-8 bg-(--color-on-primary)/60"></span>
      {pricing.garantia}
      <span aria-hidden="true" class="h-px w-8 bg-(--color-on-primary)/60"></span>
    </p>

    <h2
      class="mt-6 font-display text-4xl leading-[1.05] tracking-tight text-balance sm:text-5xl lg:text-6xl"
    >
      <Lead text={final_cta.titulo} />
    </h2>

    <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-(--color-on-primary)/80">
      {final_cta.bajada}
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <Button href={links.calendly} label={pricing.cta} variant="light" external={true} />
      <Button href={links.whatsapp} label="WhatsApp" variant="ghost-light" external={true} />
    </div>
  </div>
</section>
