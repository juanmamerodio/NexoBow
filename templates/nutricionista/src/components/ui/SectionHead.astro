---
import Lead from "./Lead.astro";

interface Props {
  tag?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { tag, title, description, align = "left" } = Astro.props;
const centered = align === "center";
---

<header class={centered ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  {
    tag && (
      <p
        class={`flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-(--color-primary) ${
          centered ? "justify-center" : ""
        }`}
      >
        <span aria-hidden="true" class="h-px w-8 bg-(--color-primary)"></span>
        {tag}
        {centered && <span aria-hidden="true" class="h-px w-8 bg-(--color-primary)"></span>}
      </p>
    )
  }
  <h2
    class="mt-5 font-display text-4xl leading-[1.05] tracking-tight text-balance lg:text-5xl"
  >
    <Lead text={title} />
  </h2>
  {
    description && (
      <p class="mt-5 text-lg leading-7 text-(--color-ink)/70">{description}</p>
    )
  }
</header>
