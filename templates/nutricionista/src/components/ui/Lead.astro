---
interface Props {
  text: string;
  emClass?: string;
}

const { text, emClass = "text-(--color-primary)" } = Astro.props;
const parts = text.split("*");
---

{
  parts.map((p, i) =>
    i % 2 === 1 ? (
      <em class={`font-display italic ${emClass}`}>{p}</em>
    ) : (
      <span>{p}</span>
    )
  )
}
