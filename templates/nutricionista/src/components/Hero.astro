---
import { CONTENT } from "../site";

const { prestador, links } = CONTENT;
---

<section class="relative mx-auto max-w-6xl px-6 pb-28 pt-12 md:pt-20">
  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold text-white/90 backdrop-blur-md mb-6 shadow-sm"
      >
        <span class="flex h-2 w-2 rounded-full bg-(--color-primary) animate-ping"></span>
        <span class="text-white/80">{prestador.rol}</span>
      </div>

      <h1
        class="font-sans text-5xl font-extrabold leading-[1.05] tracking-tight text-white md:text-7xl"
      >
        {prestador.titulo}
      </h1>

      <p class="mt-7 max-w-xl text-lg font-normal leading-relaxed text-white/70">
        {prestador.bajada}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-5">
        <a
          href={links.calendly}
          class="group relative inline-flex items-center gap-4 rounded-full bg-white/10 p-2 pl-7 pr-2.5 text-sm font-bold tracking-wide text-white backdrop-blur-md border border-white/20 transition-all duration-300 hover:border-(--color-primary) hover:bg-white/15 hover:shadow-[0_0_35px_color-mix(in_oklab,var(--color-primary)_45%,transparent)]"
        >
          <span>Agendá tu consultoría gratuita</span>
          <span
            class="flex h-11 w-11 items-center justify-center rounded-full bg-(--color-primary) text-(--color-on-primary) transition-all duration-300 group-hover:scale-110 group-hover:translate-x-1 shadow-[0_0_15px_color-mix(in_oklab,var(--color-primary)_60%,transparent)]"
          >
            <svg
              class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </span>
        </a>

        <a
          href={links.whatsapp}
          class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white/90 backdrop-blur-md transition-all duration-300 hover:border-white/30 hover:bg-white/10"
        >
          <svg class="h-4 w-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"
            />
          </svg>
          <span>Escribime por WhatsApp</span>
        </a>
      </div>

      <div class="mt-6 flex items-center gap-2 text-xs text-white/60">
        <svg class="h-4 w-4 text-(--color-primary)" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"
          />
        </svg>
        <span>Consultoría gratuita de 20 minutos · Respuesta automática por WhatsApp</span>
      </div>
    </div>

    <div class="lg:col-span-5 flex justify-center">
      <div class="relative w-full max-w-[340px] sm:max-w-[360px]" style="perspective: 1200px;">
        <div
          class="absolute -inset-4 rounded-[45px] bg-gradient-to-tr from-(--color-primary)/30 via-violet-600/20 to-transparent blur-2xl opacity-75"
        ></div>

        <div
          id="phone-3d-card"
          class="relative rounded-[42px] border-4 border-white/20 bg-gradient-to-b from-neutral-900 via-neutral-950 to-black p-3.5 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_30px_color-mix(in_oklab,var(--color-primary)_25%,transparent)] transition-transform duration-200 ease-out preserve-3d"
          style="transform: rotateY(-8deg) rotateX(6deg);"
        >
          <div
            class="mx-auto mb-3 h-5 w-24 rounded-full bg-neutral-950 border border-white/10 flex items-center justify-center"
          >
            <div class="h-2 w-2 rounded-full bg-neutral-800 mr-2"></div>
            <div class="h-1.5 w-8 rounded-full bg-neutral-900"></div>
          </div>

          <div
            class="rounded-[30px] bg-neutral-950/90 border border-white/10 p-4 overflow-hidden backdrop-blur-md"
          >
            <div class="flex items-center gap-3 border-b border-white/10 pb-3">
              <div
                class="relative flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 font-bold text-sm border border-emerald-500/30"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"
                  />
                </svg>
                <span
                  class="absolute bottom-0 right-0 h-2.5 w-2.5 rounded-full bg-emerald-500 ring-2 ring-neutral-950"
                ></span>
              </div>
              <div>
                <p class="text-sm font-semibold text-white">{prestador.nombre}</p>
                <p class="text-[11px] text-emerald-400 font-medium">● En línea (Respuesta instantánea)</p>
              </div>
            </div>

            <div class="my-4 space-y-3 text-xs">
              <div class="flex flex-col items-start">
                <div
                  class="max-w-[85%] rounded-2xl rounded-tl-sm bg-neutral-800/90 px-3.5 py-2.5 text-neutral-200 border border-white/5 shadow-sm"
                >
                  ¡Hola! Los vi en Google Maps. ¿Cómo hago para empezar una consulta?
                </div>
                <span class="mt-1 text-[9px] text-neutral-500">14:32</span>
              </div>

              <div class="flex flex-col items-end">
                <div
                  class="max-w-[88%] rounded-2xl rounded-tr-sm bg-(--color-primary)/25 border border-(--color-primary)/40 px-3.5 py-2.5 text-white shadow-sm"
                >
                  ¡Hola! Qué bueno saludarte. Sí, elegí el día y horario de tu consultoría gratuita en este link 👇
                </div>
                <span class="mt-1 text-[9px] text-white/50">14:32 · Automático</span>
              </div>

              <div
                class="rounded-xl border border-white/15 bg-gradient-to-br from-white/10 to-white/5 p-3 text-white backdrop-blur-md shadow-md"
              >
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-xs text-white">Consultoría gratuita</span>
                  <span
                    class="rounded-full bg-(--color-primary) px-2 py-0.5 text-[10px] font-bold text-(--color-on-primary) uppercase tracking-wider"
                    >Agendada</span
                  >
                </div>
                <div class="mt-2 text-[11px] text-white/80">
                  📅 Jueves 16:30 hs · Online
                </div>
                <div class="mt-1.5 flex items-center gap-1.5 text-[10px] text-emerald-400">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Sincronizado en Google Calendar &amp; email</span>
                </div>
              </div>
            </div>

            <div
              class="mt-2 rounded-xl border border-(--color-primary)/30 bg-(--color-primary)/10 p-3 text-center"
            >
              <span class="text-[10px] uppercase tracking-wider font-semibold text-white/70"
                >Agendado en 2 clics</span
              >
              <p class="font-sans text-xl font-bold text-(--color-primary) mt-0.5">
                Sin llamadas ni idas y vueltas
              </p>
              <p class="text-[10px] text-white/60">Recordatorio automático incluido</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const card = document.getElementById("phone-3d-card");
  if (card && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const parent = card.parentElement;
    if (parent) {
      parent.addEventListener("mousemove", (e) => {
        const rect = parent.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const xPct = (x / rect.width - 0.5) * 2;
        const yPct = (y / rect.height - 0.5) * 2;
        card.style.transform = `rotateY(${xPct * 18}deg) rotateX(${-yPct * 18}deg) scale3d(1.03, 1.03, 1.03)`;
      });
      parent.addEventListener("mouseleave", () => {
        card.style.transform = "rotateY(-8deg) rotateX(6deg) scale3d(1, 1, 1)";
      });
    }
  }
</script>