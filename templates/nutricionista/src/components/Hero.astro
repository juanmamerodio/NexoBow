---
import Button from "./ui/Button.astro";
import Lead from "./ui/Lead.astro";
import { CONTENT } from "../site";

const { prestador, pasos, links, hero, marquee } = CONTENT;
---

<section id="inicio" class="relative">
  <div class="mx-auto max-w-6xl px-6 pb-20 pt-16 lg:pb-28 lg:pt-24">
    <div class="grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p
          class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-(--color-primary)"
        >
          <span aria-hidden="true" class="h-px w-8 bg-(--color-primary)"></span>
          {hero.eyebrow}
        </p>

        <h1
          class="mt-6 font-display text-5xl leading-[1.02] tracking-tight text-balance sm:text-6xl lg:text-7xl"
        >
          <Lead text={prestador.titulo} />
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-8 text-(--color-ink)/70">
          {prestador.bajada}
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <Button href={links.calendly} label="Agendá tu consultoría gratuita" external={true} />
          <Button href={links.whatsapp} label="Escribime por WhatsApp" variant="outline" external={true} />
        </div>

        <p
          class="mt-10 border-t border-(--color-ink)/10 pt-6 text-sm text-(--color-ink)/60"
        >
          Consultoría gratuita · 20 minutos · Online — sin cargo y sin
          compromiso.
        </p>
      </div>

      <div class="lg:col-span-5">
        <div class="border border-(--color-ink)/15 bg-white/60 p-8">
          <p
            class="text-xs font-semibold uppercase tracking-[0.25em] text-(--color-ink)/60"
          >
            {hero.card_caption}
          </p>
          <ol class="mt-8 space-y-8">
            {
              pasos.steps.map((step) => (
                <li class="flex gap-5">
                  <span
                    class="font-display text-4xl italic leading-none text-(--color-primary)"
                  >
                    {step.n}
                  </span>
                  <div>
                    <h3 class="font-display text-xl font-semibold">{step.k}</h3>
                    <p class="mt-1 text-sm leading-6 text-(--color-ink)/70">
                      {step.d}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="mt-8 border-t border-(--color-ink)/10 pt-5 text-sm text-(--color-ink)/60">
            {hero.card_footer}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="marquee overflow-hidden border-y border-(--color-ink)/10 bg-(--color-ink) py-3 text-(--color-paper)" aria-hidden="true">
    <div class="marquee-track flex w-max whitespace-nowrap">
      {
        [0, 1].map(() => (
          <div class="flex items-center">
            {marquee.items.map((item) => (
              <span class="px-6 text-sm font-medium uppercase tracking-[0.2em]">
                {item} <span class="text-(--color-primary)">✦</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
