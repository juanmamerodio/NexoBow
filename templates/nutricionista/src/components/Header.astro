---
import Button from "./ui/Button.astro";
import { CONTENT, THEME } from "../site";
import { resolveOrder, SECTION_NAV } from "../sections";

const { links, prestador } = CONTENT;
const order = resolveOrder(THEME.orden_secciones);
const navItems = SECTION_NAV.filter((item) => order.includes(item.key));
---

<header
  class="sticky top-0 z-40 border-b border-(--color-ink)/10 bg-(--color-paper)/90 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6">
    <a href="#inicio" class="flex items-baseline gap-2">
      <span class="font-display text-xl font-semibold tracking-tight">
        {prestador.nombre}
      </span>
      <span
        class="hidden text-xs uppercase tracking-[0.2em] text-(--color-ink)/60 sm:inline"
      >
        {prestador.rol}
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Secciones">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-(--color-ink)/70 transition-colors hover:text-(--color-ink)"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <Button href={links.whatsapp} label="WhatsApp" variant="outline" size="md" external={true} />
      <Button href={links.calendly} label="Agendá" size="md" external={true} />
    </div>
  </div>
</header>
