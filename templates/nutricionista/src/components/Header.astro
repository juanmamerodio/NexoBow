---
import { CONTENT, THEME } from "../site";
import { SECTION_NAV } from "../sections";

const nav = SECTION_NAV.filter((s) => THEME.orden_secciones.includes(s.key));
---

<div class="sticky top-4 z-50 mx-auto max-w-5xl px-4 sm:px-6">
  <header
    class="flex items-center justify-between rounded-full border border-white/10 bg-black/60 px-6 py-3.5 backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.4)]"
  >
    <a
      href="/"
      class="flex items-center gap-1 font-sans text-2xl font-extrabold tracking-tight"
      aria-label="NexoBow"
    >
      <span class="text-white transition-colors">Nexo</span>
      <span class="text-[#DB1FFF] drop-shadow-[0_0_12px_rgba(219,31,255,0.6)]"
        >Bow</span
      >
    </a>

    <nav class="hidden gap-1 text-sm font-medium text-white/70 md:flex" aria-label="Principal">
      {nav.map((l) => (
        <a
          href={l.href}
          class="rounded-full px-4 py-2 transition-all duration-200 hover:bg-white/10 hover:text-white"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <a
      href={CONTENT.links.calendly}
      class="group relative inline-flex items-center gap-2.5 rounded-full bg-white/5 p-1 pl-5 pr-1.5 text-xs font-semibold tracking-wide text-white uppercase backdrop-blur-md border border-white/15 transition-all duration-300 hover:border-(--color-primary)/60 hover:bg-white/10 hover:shadow-[0_0_20px_color-mix(in_oklab,var(--color-primary)_40%,transparent)]"
    >
      <span>Agendá</span>
      <span
        class="flex h-8 w-8 items-center justify-center rounded-full bg-(--color-primary) text-(--color-on-primary) transition-all duration-300 group-hover:scale-105 group-hover:translate-x-0.5 shadow-[0_0_10px_color-mix(in_oklab,var(--color-primary)_50%,transparent)]"
      >
        <svg
          class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M14 5l7 7m0 0l-7 7m7-7H3"
          />
        </svg>
      </span>
    </a>
  </header>
</div>