---
import { CONTENT } from "../site";
---

<footer class="relative mx-auto max-w-6xl px-6 pb-12 pt-8 text-sm text-white/50">
  <div
    class="flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 md:flex-row"
  >
    <div class="flex items-center gap-1 font-sans text-lg font-extrabold tracking-tight">
      <span class="text-white">Nexo</span>
      <span class="text-[#DB1FFF]">Bow</span>
    </div>

    <p class="text-center md:text-left text-xs">
      Landing de {CONTENT.prestador.nombre} · Fábrica automatizada de embudos de
      venta y agendamiento para profesionales.
    </p>

    <p class="text-xs">
      © {new Date().getFullYear()} NexoBow. Todos los derechos reservados.
    </p>
  </div>
</footer>