---
import { CONTENT } from "../site";

const { pasos } = CONTENT;
---

<section id="metodo" class="relative mx-auto max-w-6xl px-6 py-24">
  <div
    class="inline-block rounded-full bg-white/5 border border-white/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-(--color-primary) mb-4"
  >
    {pasos.tag}
  </div>
  <h2
    class="font-sans max-w-3xl text-4xl font-extrabold tracking-tight text-white md:text-6xl"
  >
    {pasos.titulo}
  </h2>

  <ol class="mt-14 grid gap-6 md:grid-cols-2">
    {pasos.steps.map((s) => (
      <li
        class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.05] to-transparent p-8 backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.08]"
      >
        <span class="font-sans text-4xl font-extrabold text-(--color-primary)/50">{s.n}</span>
        <h3 class="font-sans mt-3 text-3xl font-bold text-white">{s.k}</h3>
        <p class="mt-3 text-base leading-relaxed text-white/70">{s.d}</p>
      </li>
    ))}
  </ol>

  <p class="mt-12 text-center font-sans text-2xl font-bold text-white">
    {pasos.footer}
  </p>
</section>