---
import { CONTENT } from "../site";

const { casos } = CONTENT;

if (!CONTENT.consentimiento_testimonios || casos.items.length === 0) return;
---

<section id="casos" class="relative mx-auto max-w-6xl px-6 py-24">
  <div class="text-center mb-14">
    <div
      class="inline-block rounded-full bg-white/5 border border-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-wider text-(--color-primary) mb-3"
    >
      {casos.tag}
    </div>
    <h2
      class="font-sans text-4xl font-extrabold tracking-tight text-white md:text-5xl"
    >
      {casos.titulo}
    </h2>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {casos.items.map((c) => (
      <article
        class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.05] to-transparent p-8 backdrop-blur-sm transition-all duration-300 hover:border-(--color-primary)/40 hover:bg-white/[0.08]"
      >
        <h3 class="font-sans text-2xl font-bold text-white">{c.titulo}</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/70">{c.descripcion}</p>
        <p
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-(--color-primary)/15 border border-(--color-primary)/30 px-3.5 py-1.5 text-xs font-semibold text-(--color-primary)"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          {c.resultado}
        </p>
      </article>
    ))}
  </div>
</section>