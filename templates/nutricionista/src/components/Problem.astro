---
import { CONTENT } from "../site";

const { problema } = CONTENT;
---

<section id="problema" class="relative mx-auto max-w-6xl px-6 py-24">
  <div
    class="rounded-[40px] border border-white/10 bg-gradient-to-b from-white/[0.04] to-transparent p-8 md:p-14 backdrop-blur-sm"
  >
    <div
      class="inline-block rounded-full bg-(--color-primary)/20 border border-(--color-primary)/40 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-(--color-primary) mb-4"
    >
      {problema.tag}
    </div>
    <h2
      class="font-sans max-w-3xl text-4xl font-extrabold tracking-tight text-white md:text-5xl lg:text-6xl"
    >
      {problema.titulo}
    </h2>
    <p class="mt-6 max-w-2xl text-lg text-white/70">{problema.descripcion}</p>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {problema.pains.map((p) => (
        <article
          class="group relative rounded-3xl border border-white/10 bg-white/[0.03] p-7 transition-all duration-300 hover:border-(--color-primary)/40 hover:bg-white/[0.06] hover:-translate-y-1"
        >
          <span
            class="inline-block rounded-full bg-white/5 border border-white/10 px-3 py-0.5 text-[11px] font-medium text-white/60 mb-4"
          >
            {p.tag}
          </span>
          <h3
            class="font-sans text-2xl font-bold text-white group-hover:text-(--color-primary) transition-colors"
          >
            {p.t}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-white/70">{p.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>