---
import Button from "./ui/Button.astro";
import { CONTENT } from "../site";

const finalCta = CONTENT.final_cta || {
  tag: "El Próximo Paso",
  titulo: "Tomá el control definitivo de las *finanzas y el futuro de tu empresa*",
  bajada: "Coordiná una llamada estratégica de 30 minutos sin cargo. Evaluamos la situación de tu negocio y te decimos exactamente cómo multiplicar tu rentabilidad.",
};

const links = CONTENT.links || {};
const bookingUrl = links.calendly || "#agendar";
const whatsappUrl = links.whatsapp || "#";
---

<section class="py-24 bg-[#0a0a0a] text-[#f4f4f4] border-b border-[#222222] relative overflow-hidden">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <div class="inline-flex items-center gap-2 mb-4">
      <span class="w-1.5 h-1.5 bg-(--color-primary)"></span>
      <span class="text-xs uppercase tracking-widest text-[#888888] font-mono">
        {finalCta.tag || "El Próximo Paso"}
      </span>
    </div>

    <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#f4f4f4] max-w-3xl mx-auto leading-tight mb-6">
      {finalCta.titulo?.split("*").map((part, index) =>
        index % 2 === 1 ? (
          <span class="text-(--color-primary)">{part}</span>
        ) : (
          <span>{part}</span>
        )
      )}
    </h2>

    <p class="text-sm sm:text-base text-[#999999] max-w-2xl mx-auto font-sans leading-relaxed mb-10">
      {finalCta.bajada}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href={bookingUrl} variant="primary" size="lg">
        Agendar Llamada Estratégica
      </Button>
      <Button href={whatsappUrl} variant="secondary" size="lg" target="_blank" rel="noopener noreferrer">
        Consultar por WhatsApp
      </Button>
    </div>

  </div>
</section>
