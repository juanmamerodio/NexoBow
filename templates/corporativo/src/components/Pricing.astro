---
import Button from "./ui/Button.astro";
import { ars, CONTENT } from "../site";

const pricing = CONTENT.pricing || {};
const links = CONTENT.links || {};
const bookingUrl = links.calendly || "#agendar";
---

<section id="precios" class="py-24 bg-[#090909] text-[#f4f4f4] border-b border-[#222222]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 bg-(--color-primary)"></span>
        <span class="text-xs uppercase tracking-widest text-[#888888] font-mono">
          {pricing.tag || "Inversión Estratégica"}
        </span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-[#f4f4f4]">
        {pricing.titulo?.split("*").map((part, index) =>
          index % 2 === 1 ? (
            <span class="text-(--color-primary)">{part}</span>
          ) : (
            <span>{part}</span>
          )
        )}
      </h2>
    </div>

    <div class="bg-[#111111] border border-[#262626] rounded-xs p-8 sm:p-12 hover:border-[#3a3a3a] transition-colors relative">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#1f1f1f]">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-(--color-primary) block">
            {pricing.plan || "Diagnóstico Financiero & Plan de Escalamiento"}
          </span>
          <span class="text-xs text-[#777777] font-sans mt-1 block">
            {pricing.precio_label || "Inversión única · Informe ejecutivo en 10 días hábiles"}
          </span>
        </div>
        <div class="text-left sm:text-right">
          <span class="font-display text-3xl sm:text-4xl font-bold text-[#f4f4f4]">
            {pricing.precio_ars ? ars(pricing.precio_ars) : "$850.000 ARS"}
          </span>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-[#a0a0a0] font-sans italic my-6">
        {pricing.precio_sub}
      </p>

      <div class="border-t border-[#1f1f1f] pt-6 mb-8">
        <span class="text-xs font-mono uppercase tracking-widest text-[#888888] block mb-4">
          {pricing.detalle_titulo || "Qué incluye la intervención:"}
        </span>
        <ul class="space-y-3">
          {pricing.incluido?.map((item) => (
            <li class="flex items-start gap-3 text-xs sm:text-sm text-[#cccccc]">
              <span class="text-(--color-primary) font-bold">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="pt-6 border-t border-[#1f1f1f] flex flex-col sm:flex-row items-center justify-between gap-6">
        <Button href={bookingUrl} variant="primary" size="lg">
          {pricing.cta || "Agendá tu llamada de diagnóstico"}
        </Button>
        <span class="text-[11px] text-[#666666] font-mono uppercase">
          {pricing.garantia}
        </span>
      </div>
    </div>

  </div>
</section>
