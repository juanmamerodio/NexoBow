---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "outline" | "light" | "ghost-light";
  size?: "md" | "lg";
  external?: boolean;
}

const { href, label, variant = "primary", size = "lg", external = false } = Astro.props;

const base =
  "group inline-flex items-center justify-center gap-3 rounded-full font-semibold transition-all duration-300 ease-out";

const sizes: Record<string, string> = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-7 py-4 text-base",
};

const variants: Record<string, string> = {
  primary:
    "bg-(--color-primary) text-(--color-on-primary) hover:gap-4 hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--color-primary)",
  outline:
    "border border-(--color-ink)/25 text-(--color-ink) hover:border-(--color-ink) hover:bg-(--color-ink) hover:text-(--color-paper) hover:gap-4",
  light:
    "bg-(--color-paper) text-(--color-ink) hover:gap-4 hover:brightness-95",
  "ghost-light":
    "border border-(--color-on-primary)/40 text-(--color-on-primary) hover:bg-(--color-on-primary) hover:text-(--color-primary) hover:gap-4",
};
---

<a
  href={href}
  class={`${base} ${sizes[size]} ${variants[variant]}`}
  {...(external ? { target: "_blank", rel: "noopener" } : {})}
>
  <span>{label}</span>
  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
</a>
