---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { problema } = CONTENT;
---

<section id="problema" class="border-b border-(--color-ink)/10 bg-(--color-paper)">
  <div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
    <div class="max-w-2xl">
      <SectionHead
        tag={problema.tag}
        title={problema.titulo}
        description={problema.descripcion}
      />
    </div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-(--color-ink)/10 border border-(--color-ink)/10">
      {
        problema.pains.map((pain, idx) => (
          <div class={`p-8 lg:p-10 ${idx % 2 === 0 ? 'bg-[#151515]' : 'bg-[#1e1e1e]'} transition-colors duration-300 hover:bg-[#252525]`}>
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase tracking-widest text-(--color-primary)">
                0{idx + 1} // {pain.tag || "Estrategia"}
              </span>
              <span class="text-xs font-mono text-(--color-ink)/40">✦</span>
            </div>
            <h3 class="mt-4 font-display text-xl font-bold tracking-tight text-(--color-ink)">
              {pain.t}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-(--color-ink)/70">
              {pain.d}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
