---
import { CONTENT } from "../site";
import Button from "./ui/Button.astro";

const hero = CONTENT.hero || {};
const prestador = CONTENT.prestador || {};
const links = CONTENT.links || {};
const bookingUrl = links.calendly || "#agendar";
const whatsappUrl = links.whatsapp || "#";

const titulo =
  prestador.titulo ||
  "Los negocios son como el ajedrez rápido. La estrategia es la clave. El tiempo es crítico.";
const bajada =
  prestador.bajada ||
  "Más de 700 directores y accionistas satisfechos no son casualidad: somos la firma de consultoría y finanzas estratégicas para empresas que exigen control absoluto de su caja.";
---

<section class="relative pt-12 pb-24 lg:pt-20 lg:pb-32 bg-[#090909] text-[#f4f4f4] overflow-hidden border-b border-[#222222]">
  <!-- Subtle Chess Grid Background -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 flex flex-col justify-center text-left">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 mb-6">
          <span class="px-3 py-1 bg-[#141414] border border-[#2a2a2a] text-(--color-primary) text-[11px] font-sans font-bold uppercase tracking-widest rounded-xs">
            {hero.eyebrow || "Estrategia Corporativa B2B"}
          </span>
          <span class="text-xs uppercase tracking-wider text-[#888888] font-mono">
            {hero.card_caption || "Speed Chess · Finanzas de Alto Impacto"}
          </span>
        </div>

        <!-- Headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#f4f4f4] leading-[1.08] mb-6">
          {titulo.split("*").map((part, index) =>
            index % 2 === 1 ? (
              <span class="text-(--color-primary)">{part}</span>
            ) : (
              <span>{part}</span>
            )
          )}
        </h1>

        <!-- Subline -->
        <p class="text-base sm:text-lg text-[#a8a8a8] font-sans font-normal leading-relaxed max-w-2xl mb-10">
          {bajada}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-14">
          <Button href={bookingUrl} variant="primary" size="lg">
            {hero.cta_primary || "Agendar Llamada de Diagnóstico"}
          </Button>
          <Button href={whatsappUrl} variant="secondary" size="lg" target="_blank" rel="noopener noreferrer">
            Consultar por WhatsApp
          </Button>
        </div>

        <!-- Trust Mini Badges -->
        <div class="flex items-center gap-8 border-t border-[#1c1c1c] pt-6">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-(--color-primary)" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-xs text-[#888888] uppercase tracking-wider">{hero.trust_1 || "Acuerdo NDA Estricto"}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-(--color-primary)" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-xs text-[#888888] uppercase tracking-wider">{hero.trust_2 || "Atención de Socio a Director"}</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Speed Chess Clock & Tactical Matrix -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        
        <!-- Chess Clock Tactical Card -->
        <div class="p-6 bg-[#121212] border border-[#262626] rounded-xs shadow-2xl relative overflow-hidden">
          <div class="flex items-center justify-between pb-4 border-b border-[#222222] mb-5">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-(--color-primary)"></div>
              <span class="text-xs font-mono uppercase tracking-widest text-[#a8a8a8]">{hero.clock_title || "Speed Chess Clock"}</span>
            </div>
            <span class="text-[11px] font-mono text-[#666666]">{hero.clock_round || "BLITZ ROUND 01"}</span>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <!-- Clock 1: Competition -->
            <div class="p-4 bg-[#0a0a0a] border border-[#1f1f1f] rounded-xs text-left">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] uppercase tracking-wider text-[#777777] font-medium">{hero.clock_left_label || "Tu Competencia"}</span>
                <img src="/assets/pferd.svg" alt="Knight" class="w-4 h-4 filter invert opacity-60" />
              </div>
              <div class="font-mono text-3xl font-bold text-[#888888] tracking-widest">
                {hero.clock_left_val || "05:00"}
              </div>
              <span class="text-[10px] text-[#555555] block mt-1 uppercase font-mono">{hero.clock_left_sub || "Tiempo Estándar"}</span>
            </div>

            <!-- Clock 2: Your Business with Strategy -->
            <div class="p-4 bg-[#181818] border border-(--color-primary)/40 rounded-xs text-left relative overflow-hidden">
              <div class="absolute -right-4 -bottom-4 w-16 h-16 bg-(--color-primary)/5 rounded-full pointer-events-none"></div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] uppercase tracking-wider text-[#f4f4f4] font-medium">{hero.clock_right_label || "Tu Negocio con Plan"}</span>
                <img src="/assets/bauer.svg" alt="Pawn" class="w-4 h-4 filter invert opacity-90" />
              </div>
              <div class="font-mono text-3xl font-bold text-(--color-primary) tracking-widest">
                {hero.clock_right_val || "04:28"}
              </div>
              <span class="text-[10px] text-(--color-primary) block mt-1 uppercase font-mono animate-pulse">{hero.clock_right_sub || "Acelerando Ejecución"}</span>
            </div>
          </div>
        </div>

        <!-- 4-Metric Chessboard Matrix -->
        <div class="grid grid-cols-2 gap-px bg-[#262626] border border-[#262626] rounded-xs overflow-hidden">
          
          <div class="p-5 bg-[#0e0e0e] hover:bg-[#141414] transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="font-display text-2xl sm:text-3xl font-bold text-[#f4f4f4] tracking-tight">{hero.stat_1_val || "+5.000"}</span>
              <img src="/assets/king.svg" alt="" class="w-4 h-4 filter invert opacity-40" />
            </div>
            <span class="text-xs text-[#888888] uppercase tracking-wider block font-sans">{hero.stat_1_label || "Consultorías Realizadas"}</span>
          </div>

          <div class="p-5 bg-[#121212] hover:bg-[#181818] transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="font-display text-2xl sm:text-3xl font-bold text-(--color-primary) tracking-tight">{hero.stat_2_val || "700+"}</span>
              <img src="/assets/springer.svg" alt="" class="w-4 h-4 filter invert opacity-40" />
            </div>
            <span class="text-xs text-[#888888] uppercase tracking-wider block font-sans">{hero.stat_2_label || "Clientes Satisfechos"}</span>
          </div>

          <div class="p-5 bg-[#121212] hover:bg-[#181818] transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="font-display text-2xl sm:text-3xl font-bold text-[#f4f4f4] tracking-tight">{hero.stat_3_val || "100%"}</span>
              <img src="/assets/circle-check.svg" alt="" class="w-4 h-4 filter invert opacity-40" />
            </div>
            <span class="text-xs text-[#888888] uppercase tracking-wider block font-sans">{hero.stat_3_label || "Digital & Sin Papeles"}</span>
          </div>

          <div class="p-5 bg-[#0e0e0e] hover:bg-[#141414] transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="font-display text-2xl sm:text-3xl font-bold text-(--color-primary) tracking-tight">{hero.stat_4_val || "44%"}</span>
              <img src="/assets/coins.svg" alt="" class="w-4 h-4 filter invert opacity-40" />
            </div>
            <span class="text-xs text-[#888888] uppercase tracking-wider block font-sans">{hero.stat_4_label || "Menos Carga Administrativa"}</span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
