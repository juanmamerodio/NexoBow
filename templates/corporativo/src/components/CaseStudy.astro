---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { casos } = CONTENT;
const consent = CONTENT.consentimiento_testimonios;
---

{
  consent && casos.items.length > 0 && (
    <section id="casos" class="border-b border-(--color-ink)/10 bg-(--color-accent)/20">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
        <div class="grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-28">
              <SectionHead tag={casos.tag} title={casos.titulo} />
            </div>
          </div>
          <div class="lg:col-span-7">
            <ul>
              {
                casos.items.map((caso) => (
                  <li class="border-t border-(--color-ink)/10 py-8">
                    <h3 class="font-display text-2xl font-semibold tracking-tight">
                      {caso.titulo}
                    </h3>
                    <p class="mt-3 max-w-lg text-(--color-ink)/70">
                      {caso.descripcion}
                    </p>
                    <p class="mt-4 font-display text-xl italic text-(--color-primary)">
                      Resultado: {caso.resultado}
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
