---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { pasos } = CONTENT;
---

<section id="metodo" class="border-b border-(--color-ink)/10 bg-white/50">
  <div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
    <SectionHead tag={pasos.tag} title={pasos.titulo} align="center" />

    <div class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        pasos.steps.map((step) => (
          <div class="border-t border-(--color-ink)/10 pt-8 md:border-t-0 md:pt-0">
            <p class="font-display text-6xl italic leading-none text-(--color-primary)">
              {step.n}
            </p>
            <h3 class="mt-6 font-display text-2xl font-semibold tracking-tight">
              {step.k}
            </h3>
            <p class="mt-3 leading-7 text-(--color-ink)/70">{step.d}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-16 text-center font-display text-xl italic text-(--color-ink)/60">
      {pasos.footer}
    </p>
  </div>
</section>
