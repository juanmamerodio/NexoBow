---
import { CONTENT } from "../site";

const nombre = CONTENT.prestador?.nombre || "Vetter Consulting";
const blurb =
  CONTENT.footer?.blurb ||
  "Firma de Consultoría Estratégica & Finanzas Corporativas B2B para directores, fundadores y accionistas.";
---

<footer class="bg-[#060606] text-[#a0a0a0] border-t border-[#1a1a1a] pt-16 pb-12 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-[#181818]">
      
      <!-- Brand & Description -->
      <div class="md:col-span-6 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-[#141414] border border-[#2a2a2a] flex items-center justify-center rounded-xs">
            <img src="/assets/king.svg" alt="" class="w-4 h-4 filter invert opacity-80" />
          </div>
          <span class="font-display font-bold text-lg text-[#f4f4f4] tracking-tight">
            {nombre}
          </span>
        </div>
        <p class="text-xs sm:text-sm text-[#777777] max-w-sm leading-relaxed">
          {blurb}
        </p>
        <span class="inline-block text-[11px] font-mono text-(--color-primary) uppercase tracking-wider">
          Speed Chess · Finanzas de Alto Impacto
        </span>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-3 space-y-3">
        <span class="text-xs font-mono uppercase tracking-widest text-[#f4f4f4] block">
          Navegación
        </span>
        <ul class="space-y-2 text-xs">
          <li><a href="#servicios" class="hover:text-(--color-primary) transition-colors">Áreas de Servicio</a></li>
          <li><a href="#metodologia" class="hover:text-(--color-primary) transition-colors">Metodología</a></li>
          <li><a href="#casos" class="hover:text-(--color-primary) transition-colors">Casos & Retorno ROI</a></li>
          <li><a href="#faq" class="hover:text-(--color-primary) transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="#agendar" class="hover:text-(--color-primary) transition-colors">Agendar Diagnóstico</a></li>
        </ul>
      </div>

      <!-- Social & Direct Channels -->
      <div class="md:col-span-3 space-y-3">
        <span class="text-xs font-mono uppercase tracking-widest text-[#f4f4f4] block">
          Contacto Directo
        </span>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#ffffff] transition-colors">
              LinkedIn Corporativo ↗
            </a>
          </li>
          <li>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#ffffff] transition-colors">
              YouTube Análisis Estratégico ↗
            </a>
          </li>
          <li>
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#ffffff] transition-colors">
              Instagram Insights ↗
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal Notice & Ley 25.326 -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[#555555]">
      <p>
        © {new Date().getFullYear()} {nombre}. Todos los derechos reservados.
      </p>
      <p class="text-[11px] text-center md:text-right max-w-xl">
        Cumplimiento legal y protección de datos: Toda información brindada es procesada con estricto secreto profesional y resguardada bajo la Ley 25.326 de Protección de los Datos Personales de la República Argentina.
      </p>
    </div>

  </div>
</footer>
