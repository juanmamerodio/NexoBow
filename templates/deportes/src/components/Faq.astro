---
import { CONTENT } from "../site";

const faq = CONTENT.faq;
const items = faq.items || [];
---

<section id="faq" class="py-20 md:py-32 bg-[#0f1419] border-b border-[var(--color-carbon-border)] relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-16 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#171d24] border border-[#2a3642] mb-4">
        <span class="w-2 h-2 bg-[var(--color-primary)]"></span>
        <span class="font-mono text-xs font-semibold text-gray-300 uppercase tracking-wider">
          {faq.tag}
        </span>
      </div>

      <h2 class="type-h2 text-white">
        {faq.titulo.split("*").map((part, i) => (
          i % 2 === 1 ? <span class="text-[var(--color-primary)]">{part}</span> : part
        ))}
      </h2>

      <p class="mt-4 text-base sm:text-lg text-gray-400 font-sans leading-relaxed">
        {faq.bajada}
      </p>
    </div>

    <!-- Accordion Items -->
    <div class="space-y-4">
      {
        items.map((item, idx) => (
          <details class="carbon-card group p-6 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
            <summary class="flex items-center justify-between text-base sm:text-lg font-bold text-white font-mono uppercase tracking-tight gap-4 focus:outline-none">
              <span class="flex items-center gap-3">
                <span class="text-xs text-[var(--color-primary)]">[{String(idx + 1).padStart(2, "0")}]</span>
                <span>{item.q}</span>
              </span>
              <span class="text-[var(--color-primary)] text-xl font-mono transition-transform duration-300 group-open:rotate-45 flex-shrink-0">
                +
              </span>
            </summary>
            <div class="mt-4 pt-4 border-t border-[#242b35] text-sm text-gray-300 font-sans leading-relaxed">
              {item.a}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
