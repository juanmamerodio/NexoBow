---
import { CONTENT } from "../site";

const cases = CONTENT.casos.items || [];
const reviews = CONTENT.reviews.items || [];
---

<section id="resultados" class="py-20 md:py-32 bg-[#0f1419] border-b border-[var(--color-carbon-border)] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#171d24] border border-[#2a3642] mb-4">
        <span class="w-2 h-2 bg-[var(--color-primary)]"></span>
        <span class="font-mono text-xs font-semibold text-gray-300 uppercase tracking-wider">
          {CONTENT.casos.tag}
        </span>
      </div>

      <h2 class="type-h2 text-white">
        {CONTENT.casos.titulo.split("*").map((part, i) => (
          i % 2 === 1 ? <span class="text-[var(--color-primary)]">{part}</span> : part
        ))}
      </h2>

      <p class="mt-4 text-base sm:text-lg text-gray-400 font-sans leading-relaxed">
        {CONTENT.casos.bajada}
      </p>
    </div>

    <!-- Case Studies / Personal Records Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
      {
        cases.map((c, idx) => (
          <div class="carbon-card p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs text-[var(--color-primary)] uppercase tracking-wider font-semibold">
                  REGISTRO #{idx + 1}
                </span>
                <span class="font-mono text-xs text-gray-400">TEST VALD</span>
              </div>

              <h3 class="text-lg font-bold text-white font-mono uppercase tracking-tight mb-3">
                {c.titulo}
              </h3>

              <div class="bg-[#0f1419] border border-[#2a3642] p-3 mb-4">
                <span class="block font-mono text-[10px] text-gray-400 uppercase tracking-wider mb-1">
                  ESTADO INICIAL / DIAGNÓSTICO:
                </span>
                <p class="text-xs text-gray-300 font-sans leading-relaxed">
                  {c.descripcion}
                </p>
              </div>
            </div>

            <div class="pt-4 border-t border-[#242b35] bg-[#10b981]/10 -mx-6 -mb-6 p-6">
              <span class="block font-mono text-[10px] text-[var(--color-primary)] uppercase tracking-wider font-bold mb-1">
                RESULTADO MEDIBLE:
              </span>
              <p class="text-sm font-semibold text-white font-sans leading-snug">
                {c.resultado}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Athlete Testimonials Header -->
    <div class="border-t border-[#2a3642] pt-16 mb-12">
      <div class="max-w-2xl">
        <span class="font-mono text-xs text-[var(--color-primary)] uppercase tracking-wider font-bold block mb-2">
          {CONTENT.reviews.tag}
        </span>
        <h3 class="text-2xl sm:text-3xl font-bold text-white font-mono uppercase tracking-tight">
          {CONTENT.reviews.titulo.split("*").map((part, i) => (
            i % 2 === 1 ? <span class="text-[var(--color-primary)]">{part}</span> : part
          ))}
        </h3>
      </div>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        reviews.map((r) => (
          <div class="bg-[#171d24] border border-[#2a3642] p-6 flex flex-col justify-between">
            <div>
              <!-- Stars Rating -->
              <div class="flex items-center gap-1 text-[var(--color-primary)] mb-4">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>

              <blockquote class="text-sm text-gray-300 font-sans leading-relaxed italic mb-6">
                “{r.texto}”
              </blockquote>
            </div>

            <div class="pt-4 border-t border-[#242b35] flex items-center justify-between">
              <div>
                <div class="text-sm font-bold text-white font-mono">
                  {r.nombre}
                </div>
                <div class="text-xs text-gray-400 font-sans">
                  {r.rol}
                </div>
              </div>
              <span class="font-mono text-[10px] text-[var(--color-primary)] bg-[#10b981]/10 px-2 py-0.5 border border-[#10b981]/30">
                VERIFICADO
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
