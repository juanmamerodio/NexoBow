---
import { CONTENT } from "../site";
import Button from "./ui/Button.astro";

const navItems = [
  { label: "EVALUACIÓN", href: "#evaluacion" },
  { label: "PERIODIZACIÓN", href: "#metodologia" },
  { label: "RÉCORDS", href: "#resultados" },
  { label: "PREGUNTAS", href: "#faq" },
];
---

<header class="sticky top-0 z-40 w-full border-b border-[var(--color-carbon-border)] bg-[#0f1419]/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand & Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-1 focus:ring-[var(--color-primary)]">
      <!-- Athletic Crosshair Target SVG from The Performance Lab -->
      <div class="w-9 h-9 text-[var(--color-primary)] transition-transform duration-500 ease-out group-hover:rotate-90">
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
          <path d="M3.73143 12.5293C8.00183 16.8 8.00196 23.7239 3.73143 27.9945L0.567404 24.8305C3.09046 22.3074 3.09033 18.2165 0.567404 15.6933L3.73143 12.5293ZM24.8286 39.9546C22.3055 37.4317 18.216 37.4317 15.6929 39.9546L12.5288 36.7905C16.7994 32.5202 23.7221 32.5202 27.9927 36.7905L24.8286 39.9546ZM20.3816 16.3065C22.4986 16.3065 24.2147 18.0227 24.2147 20.1397C24.2145 22.2565 22.4985 23.9728 20.3816 23.9728C18.2647 23.9728 16.5486 22.2565 16.5484 20.1397C16.5484 18.0227 18.2646 16.3066 20.3816 16.3065ZM39.9534 15.6926C37.4303 18.2158 37.4298 22.3073 39.9527 24.8305L36.7887 27.9945C32.5183 23.7238 32.5188 16.7992 36.7894 12.5286L39.9534 15.6926ZM27.9933 3.7326C23.7227 8.00305 16.7988 8.00309 12.5281 3.7326L15.6922 0.568573C18.2153 3.09159 22.3061 3.09155 24.8293 0.568573L27.9933 3.7326Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-mono text-sm font-bold tracking-wider text-white uppercase leading-none">
          {CONTENT.prestador.nombre}
        </span>
        <span class="font-mono text-[10px] text-gray-400 uppercase tracking-widest leading-tight mt-0.5">
          {CONTENT.prestador.subtitulo || "LABORATORIO DE CIENCIAS DEL DEPORTE"}
        </span>
      </div>
    </a>

    <!-- Navigation (Desktop) -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="font-mono text-xs tracking-wider text-gray-300 hover:text-[var(--color-primary)] transition-colors py-2 focus:outline-none focus:text-[var(--color-primary)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      <div class="hidden lg:flex items-center gap-2 px-3 py-1 bg-[#171d24] border border-[#2a3642]">
        <span class="w-2 h-2 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
        <span class="font-mono text-[10px] tracking-wider text-gray-300 uppercase">
          LAB EN VIVO · TEST DISPONIBLE
        </span>
      </div>

      <Button href={CONTENT.links.calendly || "#agendar"} variant="primary" size="sm" class="group">
        VALORACIÓN ATLÉTICA
      </Button>
    </div>
  </div>
</header>
