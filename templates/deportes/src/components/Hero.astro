---
import { CONTENT } from "../site";
import Button from "./ui/Button.astro";

const metrics = [
  { label: "VO2 MAX (CONSUMO PICO)", value: "68.4", unit: "ml/kg/min", status: "ZONA ÉLITE" },
  { label: "FUERZA REACTIVA (RSI)", value: "2.84", unit: "índice", status: "ÓPTIMO" },
  { label: "POTENCIA EXPLOSIVA (PPO)", value: "1.420", unit: "Watts", status: "+18% VS BASE" },
  { label: "ASIMETRÍA BILATERAL", value: "< 3.1%", unit: "diferencial", status: "SEGURO" },
];
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden border-b border-[var(--color-carbon-border)]">
  <!-- Kinetic accent gradient glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-[var(--color-primary)] opacity-10 blur-[140px] pointer-events-none rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Top Eyebrow Tag -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-[#171d24] border border-[#2a3642] mb-6">
      <span class="w-2 h-2 bg-[var(--color-primary)]"></span>
      <span class="font-mono text-xs font-semibold text-gray-200 tracking-wider uppercase">
        {CONTENT.hero.eyebrow}
      </span>
    </div>

    <!-- Main Athletic Title (Display Massive) -->
    <div class="mb-8">
      <h1 class="type-h1 text-white tracking-tighter max-w-5xl">
        {CONTENT.hero.tagline}
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-2xl font-sans leading-relaxed">
        {CONTENT.prestador.bajada}
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-16">
      <Button href={CONTENT.links.calendly || "#agendar"} variant="primary" size="lg" class="group">
        AGENDAR DIAGNÓSTICO ATLÉTICO
      </Button>
      <Button href={CONTENT.links.whatsapp} variant="outline" size="lg" class="group" target="_blank" rel="noopener noreferrer">
        CONSULTAR POR WHATSAPP
      </Button>
    </div>

    <!-- Athletic Biometrics & Diagnostic Console Box -->
    <div class="carbon-card p-6 sm:p-8 relative overflow-hidden">
      <!-- Crosshair decorative markers at corners -->
      <div class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-[var(--color-primary)]"></div>
      <div class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-[var(--color-primary)]"></div>
      <div class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-[var(--color-primary)]"></div>
      <div class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-[var(--color-primary)]"></div>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <!-- Left: Console Header -->
        <div class="max-w-md">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span>
            <span class="font-mono text-xs text-gray-400 uppercase tracking-widest">
              TELEMETRÍA NEUROMUSCULAR EN VIVO
            </span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-white font-mono">
            {CONTENT.hero.card_caption}
          </h2>
          <p class="mt-2 text-sm text-gray-400 font-sans">
            {CONTENT.hero.card_footer}
          </p>
        </div>

        <!-- Center: 4 Athletic KPI Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 flex-1">
          {
            metrics.map((m) => (
              <div class="bg-[#0f1419] border border-[#2a3642] p-4 flex flex-col justify-between">
                <span class="font-mono text-[10px] text-gray-400 uppercase tracking-wider mb-2">
                  {m.label}
                </span>
                <div>
                  <div class="text-2xl sm:text-3xl font-extrabold text-white font-mono leading-none">
                    {m.value}
                  </div>
                  <div class="text-[11px] text-gray-400 font-mono mt-1">
                    {m.unit}
                  </div>
                </div>
                <div class="mt-3 pt-2 border-t border-[#242b35] flex items-center justify-between">
                  <span class="text-[9px] font-mono uppercase tracking-widest text-[var(--color-primary)] font-semibold">
                    {m.status}
                  </span>
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)]"></span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
