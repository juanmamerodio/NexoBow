---
import { CONTENT } from "../site";

const pains = CONTENT.problema.pains || [];
---

<section id="evaluacion" class="py-20 md:py-32 bg-[#0f1419] border-b border-[var(--color-carbon-border)] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#171d24] border border-[#2a3642] mb-4">
        <span class="w-2 h-2 bg-[var(--color-primary)]"></span>
        <span class="font-mono text-xs font-semibold text-gray-300 uppercase tracking-wider">
          {CONTENT.problema.tag}
        </span>
      </div>
      
      <h2 class="type-h2 text-white">
        {CONTENT.problema.titulo.split("*").map((part, i) => (
          i % 2 === 1 ? <span class="text-[var(--color-primary)]">{part}</span> : part
        ))}
      </h2>
      
      <p class="mt-4 text-base sm:text-lg text-gray-400 font-sans leading-relaxed">
        {CONTENT.problema.descripcion}
      </p>
    </div>

    <!-- 4 Assessment Pain Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {
        pains.map((p, idx) => (
          <div class="carbon-card p-8 flex flex-col justify-between group relative overflow-hidden">
            <!-- Corner accent -->
            <div class="absolute top-0 right-0 w-8 h-8 bg-gradient-to-bl from-[var(--color-primary)]/20 to-transparent pointer-events-none"></div>

            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs font-bold text-[var(--color-primary)] tracking-wider uppercase bg-[#0f1419] px-2.5 py-1 border border-[#2a3642]">
                  {p.tag}
                </span>
                <span class="font-mono text-sm font-semibold text-gray-400">
                  [{String(idx + 1).padStart(2, "0")}]
                </span>
              </div>

              <blockquote class="text-lg sm:text-xl font-medium text-white font-sans leading-snug mb-6 border-l-2 border-[var(--color-primary)] pl-4 italic">
                {p.t}
              </blockquote>
            </div>

            <div class="pt-6 border-t border-[#242b35] mt-4">
              <div class="flex items-start gap-3">
                <div class="w-5 h-5 rounded-none bg-[var(--color-primary)]/10 text-[var(--color-primary)] flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <p class="text-sm text-gray-300 font-sans leading-relaxed">
                  <strong class="text-white block font-mono text-xs uppercase tracking-wide mb-1">
                    PROTOCOLO DE INTERVENCIÓN CIENCIA DEL DEPORTE:
                  </strong>
                  {p.d}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
