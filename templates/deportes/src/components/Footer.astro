---
import { CONTENT } from "../site";
---

<footer class="bg-[#0b0e13] text-gray-400 py-16 border-t border-[var(--color-carbon-border)] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b border-[#1f2833]">
      <!-- Brand & Mission -->
      <div class="md:col-span-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 text-[var(--color-primary)]">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
              <path d="M3.73143 12.5293C8.00183 16.8 8.00196 23.7239 3.73143 27.9945L0.567404 24.8305C3.09046 22.3074 3.09033 18.2165 0.567404 15.6933L3.73143 12.5293ZM24.8286 39.9546C22.3055 37.4317 18.216 37.4317 15.6929 39.9546L12.5288 36.7905C16.7994 32.5202 23.7221 32.5202 27.9927 36.7905L24.8286 39.9546ZM20.3816 16.3065C22.4986 16.3065 24.2147 18.0227 24.2147 20.1397C24.2145 22.2565 22.4985 23.9728 20.3816 23.9728C18.2647 23.9728 16.5486 22.2565 16.5484 20.1397C16.5484 18.0227 18.2646 16.3066 20.3816 16.3065ZM39.9534 15.6926C37.4303 18.2158 37.4298 22.3073 39.9527 24.8305L36.7887 27.9945C32.5183 23.7238 32.5188 16.7992 36.7894 12.5286L39.9534 15.6926ZM27.9933 3.7326C23.7227 8.00305 16.7988 8.00309 12.5281 3.7326L15.6922 0.568573C18.2153 3.09159 22.3061 3.09155 24.8293 0.568573L27.9933 3.7326Z" fill="currentColor"/>
            </svg>
          </div>
          <span class="font-mono text-base font-bold text-white tracking-wider uppercase">
            {CONTENT.prestador.nombre}
          </span>
        </div>
        <p class="text-sm text-gray-400 font-sans max-w-md leading-relaxed mb-4">
          {CONTENT.footer.blurb}
        </p>
        <div class="flex items-center gap-2 text-xs font-mono text-gray-400">
          <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span>
          <span>CIENCIA APLICADA AL MOVIMIENTO HUMANO</span>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="md:col-span-3">
        <h4 class="font-mono text-xs font-bold text-white uppercase tracking-wider mb-4">
          SECCIONES
        </h4>
        <ul class="space-y-2 text-xs font-mono">
          <li><a href="#evaluacion" class="hover:text-[var(--color-primary)] transition-colors">EVALUACIÓN ATLÉTICA</a></li>
          <li><a href="#metodologia" class="hover:text-[var(--color-primary)] transition-colors">PERIODIZACIÓN</a></li>
          <li><a href="#resultados" class="hover:text-[var(--color-primary)] transition-colors">RÉCORDS & ATLETAS</a></li>
          <li><a href="#agendar" class="hover:text-[var(--color-primary)] transition-colors">VALORACIÓN INICIAL</a></li>
          <li><a href="#faq" class="hover:text-[var(--color-primary)] transition-colors">PREGUNTAS FRECUENTES</a></li>
        </ul>
      </div>

      <!-- Legal Compliance -->
      <div class="md:col-span-3">
        <h4 class="font-mono text-xs font-bold text-white uppercase tracking-wider mb-4">
          NORMATIVA & PRIVACIDAD
        </h4>
        <p class="text-xs text-gray-400 leading-relaxed font-sans mb-3">
          Cumplimiento Ley 25.326 de Protección de Datos Personales. Los datos biométricos y de rendimiento físico son confidenciales y se almacenan bajo protocolos seguros de grado médico-deportivo.
        </p>
        <div class="text-[11px] font-mono text-[var(--color-primary)]">
          DIAGNÓSTICO SUJETO A VALORACIÓN CLÍNICA
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs font-mono text-gray-400 gap-4">
      <div>
        © {new Date().getFullYear()} {CONTENT.prestador.nombre}. Todos los derechos reservados.
      </div>
      <div>
        Desarrollado por <a href="https://nexobow.site" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-[var(--color-primary)] transition-colors underline">NexoBow</a>
      </div>
    </div>
  </div>
</footer>
