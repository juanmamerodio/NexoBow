---
import Button from "./ui/Button.astro";
import Lead from "./ui/Lead.astro";
import { CONTENT } from "../site";

const { prestador, pasos, links, hero, marquee } = CONTENT;
---

<section id="inicio" class="cm_hero relative px-3 pt-3 pb-10 sm:px-6 sm:pt-4 lg:pb-16">
  <div class="mx-auto max-w-[1520px]">
    <!-- Contenedor principal Kümmerlein con bordes redondeados 30px y recorte SVG en esquina inferior derecha -->
    <div class="relative overflow-hidden rounded-[18px] sm:rounded-[30px] bg-[#161615] text-(--color-primary) min-h-[540px] lg:min-h-[660px] flex flex-col justify-between p-6 sm:p-12 lg:p-16">
      <!-- Textura arquitectónica y cuadrícula sutil de fondo -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-25"
        style="background-image: radial-gradient(circle at 78% 22%, rgba(247, 247, 136, 0.28), transparent 48%), linear-gradient(135deg, rgba(255,255,255,0.05) 0%, transparent 60%);"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:4rem_4rem]"
      />

      <!-- Top Bar dentro del lienzo Hero: Promesa + Credencial -->
      <div class="relative z-10 flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-5">
        <p class="type_hero_before_headline text-(--color-primary)">
          {hero.eyebrow}
        </p>
        <span class="type__tiny_text_uc text-white/60">
          {prestador.rol}
        </span>
      </div>

      <!-- Centro Asimétrico: Titular Display Rhymes / Instrument Serif (.type__header_big) + Tarjeta de Promesa -->
      <div class="relative z-10 my-auto grid items-end gap-10 py-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <h1 class="type__header_big text-(--color-primary) text-balance">
            <Lead text={prestador.titulo} emClass="italic text-white" />
          </h1>
          <p class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-white/85 font-sans">
            {prestador.bajada}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button
              href={links.calendly}
              label="Agendá tu diagnóstico estratégico"
              variant="primary"
              size="lg"
              external={true}
            />
            <a
              href={links.whatsapp}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-[58px] items-center gap-3 rounded-[12px] border border-white/25 bg-white/5 px-6 py-3.5 font-display text-sm sm:text-base font-medium text-white backdrop-blur-xs transition-colors hover:border-(--color-primary) hover:text-(--color-primary)"
            >
              <span class="h-2.5 w-2.5 rounded-full bg-(--color-primary)" aria-hidden="true" />
              <span>Consultar por WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Bloque lateral estilo Kümmerlein: Hoja de ruta resumida -->
        <div class="lg:col-span-5 lg:pr-20">
          <div class="rounded-[18px] border border-white/15 bg-black/45 p-6 sm:p-8 backdrop-blur-md text-white">
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <span class="type__tiny_text_uc text-(--color-primary)">
                {hero.card_caption}
              </span>
              <span class="h-2.5 w-2.5 rounded-full bg-(--color-primary)" aria-hidden="true" />
            </div>

            <ol class="mt-5 space-y-4">
              {
                pasos.steps.slice(0, 3).map((step) => (
                  <li class="flex items-start gap-3.5">
                    <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-[6px] bg-(--color-primary) font-display text-xs font-bold text-[#111111]">
                      {step.n}
                    </span>
                    <div>
                      <p class="font-display text-sm font-semibold text-white">
                        {step.k}
                      </p>
                      <p class="mt-0.5 text-xs leading-relaxed text-white/70">
                        {step.d}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ol>

            <p class="mt-5 border-t border-white/10 pt-3 text-xs text-white/60">
              {hero.card_footer}
            </p>
          </div>
        </div>
      </div>

      <!-- Esquina inferior derecha con recorte cóncavo SVG auténtico de Kümmerlein (.item_bottom .cutout) -->
      <div class="item_bottom hidden sm:block absolute bottom-0 right-0 z-20 h-[100px] w-[100px]">
        <!-- Curva cóncava izquierda -->
        <div class="left_part pointer-events-none absolute bottom-0 -left-[30px] h-[30px] w-[30px] overflow-hidden" aria-hidden="true">
          <svg class="h-[31px] w-[31px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 31 31">
            <path style="fill:var(--color-paper)" d="M0,30v1h31V0h-1c0,16.57-13.43,30-30,30Z" />
          </svg>
        </div>
        <!-- Curva cóncava superior -->
        <div class="top_part pointer-events-none absolute -top-[30px] right-0 h-[30px] w-[30px] overflow-hidden" aria-hidden="true">
          <svg class="h-[31px] w-[31px]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 31 31">
            <path style="fill:var(--color-paper)" d="M0,30v1h31V0h-1c0,16.57-13.43,30-30,30Z" />
          </svg>
        </div>
        <!-- Recorte del color de página con botón circular amarillo Kümmerlein -->
        <div class="cutout absolute bottom-0 right-0 h-[100px] w-[100px] rounded-tl-[30px] bg-(--color-paper) flex items-end justify-end">
          <a
            href="#enfoque"
            aria-label="Explorar propuesta de valor"
            class="circle_inner group flex h-[86px] w-[86px] items-center justify-center rounded-full bg-(--color-primary) text-[#111111] transition-transform duration-300 hover:scale-105"
          >
            <svg
              class="arrow h-4 w-4 transition-transform duration-300 group-hover:scale-125 group-hover:rotate-45"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 12 12"
              fill="currentColor"
            >
              <path d="M11.02,1.48c0-.28-.22-.5-.5-.5h-4.5c-.28,0-.5.22-.5.5s.22.5.5.5h4v4c0,.28.22.5.5.5s.5-.22.5-.5V1.48Z" />
              <rect x="-.57" y="5.57" width="13" height="1" transform="translate(-2.56 5.97) rotate(-45)" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Ticker horizontal de áreas jurídicas -->
    <div class="marquee mt-4 overflow-hidden rounded-[12px] bg-[#e2e4d7] py-3 text-[#111111]" aria-hidden="true">
      <div class="marquee-track flex w-max whitespace-nowrap">
        {
          [0, 1].map(() => (
            <div class="flex items-center">
              {marquee.items.map((item) => (
                <span class="px-7 font-display text-xs font-semibold uppercase tracking-[0.2em] flex items-center gap-3">
                  <span>{item}</span>
                  <span class="inline-block h-2 w-2 rounded-full bg-[#111111]" />
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
