---
import Button from "./ui/Button.astro";
import Lead from "./ui/Lead.astro";
import { CONTENT } from "../site";

const { prestador, pasos, links, hero, marquee } = CONTENT;
---

<section id="inicio" class="relative overflow-hidden border-b border-(--color-ink)/10">
  <div class="mx-auto max-w-7xl px-6 pt-12 pb-16 lg:px-12 lg:pt-20 lg:pb-24">
    <!-- Asymmetric Grid Layout Kümmerlein (7/5 split) -->
    <div class="grid items-stretch gap-12 lg:grid-cols-12 lg:gap-14">
      
      <!-- Columna Principal: Copy brutalista, eyebrow con dot y CTAs -->
      <div class="flex flex-col justify-between lg:col-span-7">
        <div>
          <!-- Micro-eyebrow con dot amarillo signature -->
          <div class="inline-flex items-center gap-2.5 rounded-[6px] bg-(--color-ink)/5 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-(--color-ink)/75">
            <span class="h-2 w-2 rounded-full bg-(--color-primary)" aria-hidden="true"></span>
            <span>{hero.eyebrow}</span>
          </div>

          <!-- Titular Brutalista Kümmerlein (Space Grotesk + tracking ajustado) -->
          <h1 class="mt-6 font-display text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight text-balance text-(--color-ink)">
            <Lead text={prestador.titulo} />
          </h1>

          <!-- Bajada de alivio estratégico -->
          <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-(--color-ink)/75">
            {prestador.bajada}
          </p>
        </div>

        <!-- Botones y Garantía -->
        <div class="mt-10 pt-6 border-t border-(--color-ink)/10">
          <div class="flex flex-wrap items-center gap-4">
            <Button href={links.calendly} label="Agendá tu diagnóstico estratégico" external={true} />
            <Button href={links.whatsapp} label="Escribinos por WhatsApp" variant="outline" external={true} />
          </div>
          <p class="mt-4 text-xs tracking-wider uppercase text-(--color-ink)/50">
            Confidencialidad amparada por secreto profesional · Sesión inicial de 25 min
          </p>
        </div>
      </div>

      <!-- Columna Lateral: Tarjeta asimétrica de credenciales y método con geometría Kümmerlein -->
      <div class="flex flex-col justify-center lg:col-span-5">
        <div class="relative rounded-[15px] border border-(--color-ink)/15 bg-(--color-paper) p-8 lg:p-10 shadow-xs">
          
          <!-- Recorte visual característico Kümmerlein en la esquina superior derecha -->
          <div class="absolute -top-px -right-px hidden sm:block pointer-events-none" aria-hidden="true">
            <svg class="h-8 w-8 text-(--color-ink)/15" viewBox="0 0 32 32" fill="none" stroke="currentColor">
              <path d="M0 0h32v32C32 14.33 17.67 0 0 0z" fill="var(--color-primary)"/>
            </svg>
          </div>

          <div class="flex items-center justify-between border-b border-(--color-ink)/10 pb-4">
            <p class="text-[11px] font-bold uppercase tracking-[0.25em] text-(--color-ink)/60">
              {hero.card_caption}
            </p>
            <span class="inline-block h-2 w-2 rounded-full bg-(--color-primary)"></span>
          </div>

          <ol class="mt-6 space-y-6">
            {
              pasos.steps.map((step) => (
                <li class="flex items-start gap-4">
                  <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-[6px] bg-(--color-ink) font-display text-xs font-bold text-(--color-primary)">
                    {step.n}
                  </span>
                  <div>
                    <h2 class="font-display text-base font-bold text-(--color-ink)">
                      {step.k}
                    </h2>
                    <p class="mt-1 text-xs sm:text-sm leading-relaxed text-(--color-ink)/70">
                      {step.d}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>

          <p class="mt-6 border-t border-(--color-ink)/10 pt-4 text-xs leading-relaxed text-(--color-ink)/60">
            {hero.card_footer}
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Marquee Ticker de Prácticas Jurídicas -->
  <div class="marquee overflow-hidden border-t border-(--color-ink)/10 bg-(--color-ink) py-3.5 text-(--color-paper)" aria-hidden="true">
    <div class="marquee-track flex w-max whitespace-nowrap">
      {
        [0, 1].map(() => (
          <div class="flex items-center">
            {marquee.items.map((item) => (
              <span class="px-8 text-xs font-semibold uppercase tracking-[0.25em] flex items-center gap-3">
                <span>{item}</span>
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-(--color-primary)" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
