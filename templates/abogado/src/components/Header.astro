---
import Button from "./ui/Button.astro";
import { CONTENT, THEME } from "../site";
import { resolveOrder, SECTION_NAV } from "../sections";

const { links, prestador } = CONTENT;
const order = resolveOrder(THEME.orden_secciones);
const navItems = SECTION_NAV.filter((item) => order.includes(item.key));
---

<header
  class="sticky top-0 z-40 border-b border-(--color-ink)/10 bg-(--color-paper)/95 backdrop-blur-md transition-colors"
>
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-6 px-6 lg:px-12">
    <!-- Logotipo sobrio y tipográfico con geometría Kümmerlein -->
    <a href="#inicio" class="group flex items-baseline gap-3 focus:outline-none">
      <span class="flex h-7 w-7 items-center justify-center rounded-[4px] bg-(--color-ink) text-(--color-primary) font-display text-sm font-bold transition-transform group-hover:scale-105">
        K.
      </span>
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-2">
        <span class="font-display text-lg font-bold tracking-tight text-(--color-ink)">
          {prestador.nombre}
        </span>
        <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-(--color-ink)/50">
          Rechtsanwälte & Notare
        </span>
      </div>
    </a>

    <!-- Navegación ejecutiva minimalista -->
    <nav class="hidden items-center gap-8 xl:flex" aria-label="Secciones">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-xs font-semibold uppercase tracking-[0.18em] text-(--color-ink)/70 transition-colors hover:text-(--color-ink)"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- CTAs de conversión con estilo Kümmerlein -->
    <div class="flex items-center gap-3">
      <Button href={links.whatsapp} label="WhatsApp" variant="outline" size="md" external={true} />
      <Button href={links.calendly} label="Agendá consulta" size="md" external={true} />
    </div>
  </div>
</header>
