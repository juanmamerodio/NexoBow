---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { casos } = CONTENT;
const consent = CONTENT.consentimiento_testimonios;
---

{
  consent && casos.items.length > 0 && (
    <section id="casos" class="border-b border-(--color-ink)/10 bg-(--soft-grey1)/20">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <div class="lg:sticky lg:top-28">
              <SectionHead tag={casos.tag} title={casos.titulo} />
            </div>
          </div>
          <div class="lg:col-span-7">
            <div class="space-y-6">
              {
                casos.items.map((caso) => (
                  <div class="rounded-[18px] border border-(--color-ink)/15 bg-white/90 p-8 shadow-sm transition-all duration-300 hover:border-(--color-ink)/30">
                    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-(--color-ink)/50">
                      <span class="h-1.5 w-1.5 rounded-full bg-(--color-primary)" />
                      <span>Resolución Destacada</span>
                    </div>
                    
                    <h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-(--color-ink)">
                      {caso.titulo}
                    </h3>
                    
                    <p class="mt-3 text-sm sm:text-base leading-relaxed text-(--color-ink)/75">
                      {caso.descripcion}
                    </p>
                    
                    <div class="mt-6 rounded-[8px] bg-(--color-paper) p-4 border border-(--color-ink)/10">
                      <p class="font-display text-sm font-semibold text-(--color-ink)">
                        <span class="text-(--color-ink)/50 uppercase text-[11px] tracking-wider block mb-1">Impacto legal concreto:</span>
                        {caso.resultado}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
