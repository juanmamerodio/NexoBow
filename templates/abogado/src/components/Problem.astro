---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { problema } = CONTENT;
---

<section id="problema" class="border-b border-(--color-ink)/10 bg-(--color-paper)">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
    <!-- Grid asimétrico 2 columnas estilo Kümmerlein (cm_text two_col) -->
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      
      <!-- Columna izquierda: Titular y contexto -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <SectionHead
            tag={problema.tag}
            title={problema.titulo}
            description={problema.descripcion}
          />
        </div>
      </div>

      <!-- Columna derecha: Bloques de dolores estructurados con bordes 8px -->
      <div class="lg:col-span-7">
        <div class="space-y-4">
          {
            problema.pains.map((pain) => (
              <div class="group rounded-[8px] border border-(--color-ink)/15 bg-white/70 p-6 sm:p-8 transition-all duration-300 hover:border-(--color-ink)/40 hover:bg-white">
                <div class="flex items-center gap-2.5">
                  <span class="h-2 w-2 rounded-full bg-(--color-primary) flex-shrink-0" />
                  <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-(--color-ink)/60">
                    {pain.tag}
                  </span>
                </div>
                
                <h3 class="mt-3 font-display text-xl sm:text-2xl font-bold tracking-tight text-(--color-ink)">
                  {pain.t}
                </h3>
                
                <p class="mt-2 text-sm sm:text-base leading-relaxed text-(--color-ink)/75">
                  {pain.d}
                </p>
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>
</section>
