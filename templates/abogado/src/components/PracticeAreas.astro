---
import Button from "./ui/Button.astro";
import Lead from "./ui/Lead.astro";
import { CONTENT } from "../site";

const { pasos, prestador, links } = CONTENT;
const pillars = (pasos as any).pillars || [
  "Maniobra rápida",
  "Agilidad táctica",
  "Solvencia técnica",
  "Ejecución precisa",
];
const areas = (pasos as any).areas || [
  {
    code: "A·01",
    nombre: "Derecho Societario & M&A",
    detalle: "Estructuración de sociedades, acuerdos de accionistas y resolución de conflictos societarios.",
  },
  {
    code: "A·02",
    nombre: "Contratos & Negociaciones B2B",
    detalle: "Redacción y auditoría de contratos comerciales, distribución, franquicias y garantías.",
  },
  {
    code: "A·03",
    nombre: "Litigios Patrimoniales & Arbitraje",
    detalle: "Defensa judicial y arbitral de alto impacto, medidas cautelares y recupero de activos.",
  },
  {
    code: "A·04",
    nombre: "Sucesiones & Blindaje Familiar",
    detalle: "Planificación patrimonial, protocolos de empresas familiares y sucesiones complejas.",
  },
];
---

<section id="practicas" class="cm_themen relative px-3 py-12 sm:px-6 lg:py-20">
  <div class="mx-auto max-w-[1520px] space-y-12">
    <!-- Bloque 1: cm_themen (Fondo piedra --soft-grey2 #d7d7cc, navegación lateral sticky + círculos interactivos) -->
    <div class="rounded-[24px] sm:rounded-[30px] bg-[#d7d7cc] p-6 sm:p-12 lg:p-16 text-[#111111]">
      <div class="grid gap-12 lg:grid-cols-12 items-start">
        <!-- Columna izquierda sticky: Por qué trabajar con nosotros + Pilares circulares Kümmerlein -->
        <div class="lg:col-span-5 lg:sticky lg:top-28">
          <p class="type__tiny_text_uc text-[#686155] mb-3">
            {pasos.tag}
          </p>
          <h2 class="type__headline font-semibold text-[#111111] text-balance">
            <Lead text={pasos.titulo} emClass="font-serif italic font-normal" />
          </h2>
          <p class="mt-4 text-base sm:text-lg leading-relaxed text-[#111111]/80">
            {pasos.footer}
          </p>

          <!-- Círculos de agilidad Kümmerlein (.col__circles) -->
          <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4" role="list" aria-label="Pilares estratégicos">
            {
              pillars.map((pillar: string, idx: number) => (
                <button
                  type="button"
                  data-pillar-index={idx}
                  class={`pillar-circle group relative flex aspect-square max-w-[170px] w-full flex-col items-center justify-center rounded-full p-4 text-center transition-all duration-300 cursor-pointer border border-black/10 ${
                    idx === 0
                      ? "bg-(--color-primary) text-[#111111] shadow-sm scale-[1.02]"
                      : "bg-[#e2e4d7] text-[#111111]/80 hover:bg-(--color-primary) hover:text-[#111111]"
                  }`}
                >
                  <span class="type__tiny_text_uc text-[10px] opacity-60 mb-1">0{idx + 1}</span>
                  <span class="font-display text-sm sm:text-base font-semibold leading-tight">
                    {pillar}
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Columna derecha: Desglose de Áreas de Práctica + Las 3 etapas operativas -->
        <div class="lg:col-span-7 space-y-8">
          <!-- Áreas de Práctica Legal -->
          <div class="grid gap-4 sm:grid-cols-2">
            {
              areas.map((area: any) => (
                <div class="group rounded-[18px] bg-[#f6f6f4] p-6 sm:p-7 transition-all duration-300 hover:bg-(--color-primary)">
                  <div class="flex items-center justify-between border-b border-black/10 pb-3">
                    <span class="type__tiny_text_uc text-[#686155]">{area.code}</span>
                    <span class="h-2.5 w-2.5 rounded-full bg-[#111111] transition-transform duration-300 group-hover:scale-150" />
                  </div>
                  <h3 class="type__headline_tiles mt-4 font-semibold text-[#111111]">
                    {area.nombre}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-[#111111]/75">
                    {area.detalle}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- Etapas del Método (Steps de la ficha) -->
          <div class="rounded-[20px] bg-[#161615] p-6 sm:p-9 text-white">
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
              <span class="type__tiny_text_uc text-(--color-primary)">
                Protocolo de Trabajo en 3 Etapas
              </span>
              <span class="type__tiny_text_uc text-white/50">Sin fricción burocrática</span>
            </div>

            <div class="mt-6 grid gap-6 md:grid-cols-3">
              {
                pasos.steps.map((step) => (
                  <div class="border-l border-white/15 pl-4">
                    <span class="font-display text-xs font-bold uppercase tracking-widest text-(--color-primary)">
                      Fase {step.n}
                    </span>
                    <h3 class="mt-1 font-display text-lg font-semibold text-white">
                      {step.k}
                    </h3>
                    <p class="mt-2 text-xs sm:text-sm leading-relaxed text-white/75">
                      {step.d}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bloque 2: cm_cta_button .button_wrap.square_style (Ancho grid 2/12 de Kümmerlein) -->
    <div class="cm_cta_button lg:px-[8.33%]">
      <a
        href={links.calendly}
        target="_blank"
        rel="noopener"
        class="group flex min-h-[72px] sm:min-h-[84px] w-full items-center justify-center rounded-[12px] sm:rounded-[15px] bg-(--color-primary) px-6 sm:px-14 text-center font-display text-lg sm:text-2xl font-medium text-[#111111] no-underline transition-colors duration-300 hover:bg-[#3c3c3c] hover:text-(--color-primary)"
      >
        <span class="mr-5 h-3.5 w-3.5 flex-shrink-0 rounded-full bg-current transition-transform duration-500 group-hover:scale-150" aria-hidden="true" />
        <span>Coordinar estrategia para tu empresa o patrimonio</span>
      </a>
    </div>

    <!-- Bloque 3: cm_solutions (Banner oscuro inmersivo con dos big_fat_button gemelos al pie) -->
    <div class="cm_solutions relative overflow-hidden rounded-[24px] sm:rounded-[30px] bg-[#1c1b18] p-6 sm:p-12 lg:p-16 text-white">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-30"
        style="background: radial-gradient(circle at 85% 30%, rgba(247, 247, 136, 0.25), transparent 55%);"
      />
      <div class="relative z-10 grid gap-8 lg:grid-cols-12 items-center">
        <div class="lg:col-span-6 lg:col-start-2">
          <p class="type__tiny_text_uc text-(--color-primary) mb-3">
            Nuestras Soluciones
          </p>
          <h2 class="type__headline font-semibold text-(--color-primary)">
            Soluciones simples para los escenarios más exigentes
          </h2>
          <p class="mt-4 text-base sm:text-lg leading-relaxed text-white/85">
            {prestador.bio}
          </p>
        </div>
      </div>

      <!-- Dos Big Fat Buttons característicos de Kümmerlein (.big_fat_button) -->
      <div class="relative z-10 mt-10 grid gap-4 sm:grid-cols-2 lg:mx-auto lg:w-[82%]">
        <Button
          href={links.calendly}
          label="Áreas de Práctica & Diagnóstico"
          variant="fat"
          external={true}
        />
        <Button
          href={links.whatsapp}
          label="Consulta Directa por WhatsApp"
          variant="fat"
          external={true}
        />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll(".pillar-circle");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => {
          b.classList.remove("bg-(--color-primary)", "shadow-sm", "scale-[1.02]");
          b.classList.add("bg-[#e2e4d7]");
        });
        btn.classList.remove("bg-[#e2e4d7]");
        btn.classList.add("bg-(--color-primary)", "shadow-sm", "scale-[1.02]");
      });
    });
  })();
</script>
