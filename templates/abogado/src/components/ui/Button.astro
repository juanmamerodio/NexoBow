---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "outline" | "light" | "ghost-light";
  size?: "md" | "lg";
  external?: boolean;
}

const { href, label, variant = "primary", size = "lg", external = false } = Astro.props;

// Estilo signature Kümmerlein: botón rectangular con bordes de 8px, dot expansivo y hover invertido
const isSignature = variant === "primary" || variant === "light";
---

<a
  href={href}
  class={`group relative inline-flex items-center justify-center font-display font-medium tracking-tight text-center transition-all duration-300 rounded-[8px] no-underline ${
    size === "md" ? "px-5 py-2.5 text-xs sm:text-sm min-h-[44px]" : "px-7 py-3.5 sm:py-4 text-sm sm:text-base min-h-[52px]"
  } ${
    variant === "primary"
      ? "bg-(--color-primary) text-(--color-ink) hover:bg-(--color-ink) hover:text-(--color-primary) shadow-sm"
      : variant === "outline"
      ? "border border-(--color-ink)/25 text-(--color-ink) hover:bg-(--color-ink) hover:text-(--color-paper)"
      : variant === "light"
      ? "bg-(--color-paper) text-(--color-ink) hover:bg-(--color-ink) hover:text-(--color-paper)"
      : "border border-(--color-ink)/30 text-(--color-ink) hover:bg-(--color-ink) hover:text-(--color-primary)"
  }`}
  {...(external ? { target: "_blank", rel: "noopener" } : {})}
>
  {
    isSignature && (
      <span
        aria-hidden="true"
        class="inline-block h-2 w-2 rounded-full bg-current mr-3 flex-shrink-0 transition-transform duration-300 ease-out group-hover:scale-150"
      />
    )
  }
  <span>{label}</span>
  <span
    aria-hidden="true"
    class="ml-2.5 transition-transform duration-300 group-hover:translate-x-1 opacity-70 group-hover:opacity-100"
  >
    →
  </span>
</a>
