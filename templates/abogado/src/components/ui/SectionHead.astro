---
import Lead from "./Lead.astro";

interface Props {
  tag?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { tag, title, description, align = "left" } = Astro.props;
const centered = align === "center";
---

<header class={centered ? "mx-auto max-w-3xl text-center" : "max-w-3xl"}>
  {
    tag && (
      <div
        class={`flex items-center gap-2.5 text-[11px] font-bold uppercase tracking-[0.25em] text-(--color-ink)/60 ${
          centered ? "justify-center" : ""
        }`}
      >
        <span
          aria-hidden="true"
          class="h-1.5 w-1.5 rounded-full bg-(--color-primary)"
        />
        <span>{tag}</span>
      </div>
    )
  }
  <h2
    class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-semibold leading-[1.08] tracking-tight text-balance"
  >
    <Lead text={title} />
  </h2>
  {
    description && (
      <p class="mt-4 text-base sm:text-lg leading-relaxed text-(--color-ink)/75 max-w-2xl">
        {description}
      </p>
    )
  }
</header>
