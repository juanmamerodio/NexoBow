---
import { CONTENT } from "../site";
import { SECTION_NAV } from "../sections";

const { prestador, links, footer } = CONTENT;
const year = new Date().getFullYear();
---

<footer class="border-t border-(--color-ink)/10 bg-(--color-paper)">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-12">
    <div class="grid gap-12 md:grid-cols-4">
      <!-- Columna 1: Firma & Isotipo -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3">
          <span class="flex h-7 w-7 items-center justify-center rounded-[4px] bg-(--color-ink) text-(--color-primary) font-display text-sm font-bold">
            K.
          </span>
          <span class="font-display text-xl font-bold tracking-tight text-(--color-ink)">
            {prestador.nombre}
          </span>
        </div>
        <p class="mt-2 text-xs uppercase tracking-[0.2em] text-(--color-ink)/60">
          {prestador.rol}
        </p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-(--color-ink)/75">
          {footer.blurb}
        </p>
      </div>

      <!-- Columna 2: Navegación -->
      <nav aria-label="Secciones del sitio">
        <p class="text-[11px] font-bold uppercase tracking-[0.25em] text-(--color-ink)/50">
          Navegación
        </p>
        <ul class="mt-4 space-y-2.5">
          {
            SECTION_NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-xs font-semibold uppercase tracking-wider text-(--color-ink)/70 transition-colors hover:text-(--color-ink)"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Columna 3: Contacto y Agendamiento -->
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.25em] text-(--color-ink)/50">
          Atención Inmediata
        </p>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href={links.calendly}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-(--color-ink) underline-offset-4 hover:underline"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-(--color-primary)" />
              Agendá tu diagnóstico
            </a>
          </li>
          <li>
            <a
              href={links.whatsapp}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-(--color-ink) underline-offset-4 hover:underline"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-(--color-primary)" />
              WhatsApp Oficial
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Créditos y Ley de Datos -->
    <div class="mt-14 pt-8 border-t border-(--color-ink)/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-(--color-ink)/50">
      <p>
        © {year} {prestador.nombre} · Todos los derechos reservados · Secreto profesional CPACF
      </p>
      <p class="font-medium">
        {footer.credit}
      </p>
    </div>
  </div>
</footer>
