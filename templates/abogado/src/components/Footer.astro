---
import { CONTENT } from "../site";
import { SECTION_NAV } from "../sections";

const { prestador, links, footer } = CONTENT;
const year = new Date().getFullYear();
const seenHrefs = new Set<string>();
const uniqueNav = SECTION_NAV.filter((item) => {
  if (seenHrefs.has(item.href)) return false;
  seenHrefs.add(item.href);
  return true;
});
---

<footer id="footer" class="bg-(--color-primary) text-[#111111] px-3 py-14 sm:px-6 lg:py-20">
  <div class="mx-auto max-w-[1520px]">
    <!-- Grilla 12 columnas idéntica a Kümmerlein (#footer .grid__outer_12) -->
    <div class="grid gap-10 lg:grid-cols-12 items-start">
      <!-- main_col1 (span 3): Isotipo Kümmerlein grande en negro -->
      <div class="lg:col-span-3">
        <a
          href="#inicio"
          aria-label={`Volver al inicio - ${prestador.nombre}`}
          class="inline-block text-[#111111] transition-opacity hover:opacity-80"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 111 71"
            class="h-14 sm:h-16 w-auto fill-current"
            aria-hidden="true"
          >
            <path d="M87.28,71l-28.1-37.59c-.59-.79-.59-1.88,0-2.68L82.14,0h-27.23l-29.12,39.41c-.68.93-2.16.44-2.16-.71V0H0v71h28.97l14.53-19.37c.61-.82,1.85-.79,2.43.06l13.14,19.31h28.22Z" />
            <path d="M91.7,51.53c10.66,0,19.3-8.61,19.3-19.24s-8.64-19.24-19.3-19.24-19.3,8.61-19.3,19.24,8.64,19.24,19.3,19.24Z" />
          </svg>
        </a>
        <p class="mt-4 font-display text-sm font-bold uppercase tracking-wider text-[#111111]">
          {prestador.nombre}
        </p>
        <p class="mt-1 text-xs text-[#111111]/75">
          {prestador.rol}
        </p>
      </div>

      <!-- main_col2 (span 6): Columnas de menú institucionales -->
      <div class="lg:col-span-6 grid gap-8 sm:grid-cols-3">
        <div class="border-t border-black/20 pt-3 sm:border-t-0 sm:pt-0">
          <h3 class="font-display text-sm font-bold uppercase tracking-wider text-[#111111]">
            Estudio
          </h3>
          <ul class="mt-3 space-y-2 text-sm">
            {
              uniqueNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-[#111111]/85 transition-colors hover:text-[#686155]"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-t border-black/20 pt-3 sm:border-t-0 sm:pt-0">
          <h3 class="font-display text-sm font-bold uppercase tracking-wider text-[#111111]">
            Canales Directos
          </h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              <a
                href={links.calendly}
                target="_blank"
                rel="noopener"
                class="font-medium text-[#111111] underline-offset-4 hover:underline"
              >
                Agenda Online ↗
              </a>
            </li>
            <li>
              <a
                href={links.whatsapp}
                target="_blank"
                rel="noopener"
                class="font-medium text-[#111111] underline-offset-4 hover:underline"
              >
                WhatsApp Directo ↗
              </a>
            </li>
          </ul>
        </div>

        <div class="border-t border-black/20 pt-3 sm:border-t-0 sm:pt-0">
          <h3 class="font-display text-sm font-bold uppercase tracking-wider text-[#111111]">
            Marco Legal
          </h3>
          <ul class="mt-3 space-y-2 text-xs leading-relaxed text-[#111111]/80">
            <li>Secreto Profesional CPACF</li>
            <li>Cumplimiento Ley 25.326 (Protección de Datos Personales)</li>
            <li>Atención Confidencial</li>
          </ul>
        </div>
      </div>

      <!-- main_col3 (span 3): Wordmark y síntesis -->
      <div class="lg:col-span-3 lg:text-right flex flex-col justify-between">
        <div>
          <span class="font-display text-xl sm:text-2xl font-bold uppercase tracking-[0.16em] text-[#111111]">
            {prestador.nombre.split(" ").slice(-1)[0]}
          </span>
          <p class="mt-2 text-xs leading-relaxed text-[#111111]/80">
            {footer.blurb}
          </p>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-black/15 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#111111]/75">
      <p>
        © {year} {prestador.nombre} · Todos los derechos reservados · Ley 25.326
      </p>
      <p class="font-semibold">
        {footer.credit}
      </p>
    </div>
  </div>
</footer>
