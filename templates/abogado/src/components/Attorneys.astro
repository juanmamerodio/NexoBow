---
import Lead from "./ui/Lead.astro";
import { CONTENT } from "../site";

const { prestador, reviews, links } = CONTENT;
const attorneys = (CONTENT as any).attorneys || {
  tag: "Socios & Especialistas",
  titulo: "Un equipo que cuenta. *Simplicidad que impacta.*",
  bajada:
    "Conocé a los profesionales detrás de cada estrategia. Cada socio responde directamente por la agilidad técnica y la seguridad jurídica de tu caso.",
  members: [
    {
      nombre: prestador.nombre,
      cargo: prestador.rol || "Socio Director · Litigios & Corporativo",
      credencial: "Atención directa de socios",
      iniciales: "MA",
    },
    {
      nombre: "Dra. Carolina V. Stein",
      cargo: "Socia · Contratos Corporativos & M&A",
      credencial: "LL.M. · Derecho Empresarial",
      iniciales: "CS",
    },
    {
      nombre: "Dr. Julián Kranevitter",
      cargo: "Socio · Arbitraje & Defensa Patrimonial",
      credencial: "Especialista en Procesal Civil y Comercial",
      iniciales: "JK",
    },
    {
      nombre: "Dra. Sofía Lindemann",
      cargo: "Counsel · Estructuración & Empresas Familiares",
      credencial: "Protocolos Societarios & Sucesiones",
      iniciales: "SL",
    },
  ],
};

// Asegurar que el primer miembro refleje siempre el prestador inyectado en la ficha
const members = attorneys.members.map((m: any, idx: number) =>
  idx === 0
    ? {
        ...m,
        nombre: prestador.nombre,
        cargo: prestador.rol || m.cargo,
      }
    : m
);

const consent = CONTENT.consentimiento_testimonios;
const visibleReviews = consent
  ? reviews.items
  : reviews.items.filter((review) => review.fuente === "Google Maps");
---

<section id="socios" class="cm_team_ticker relative px-3 py-12 sm:px-6 lg:py-20">
  <div class="mx-auto max-w-[1520px] space-y-14">
    <!-- Contenedor gris cálido Kümmerlein (.content.bg_color__grey) -->
    <div class="overflow-hidden rounded-[24px] sm:rounded-[30px] bg-[#e2e4d7] py-12 sm:py-16 lg:py-20 text-[#111111]">
      <!-- Cabecera 2 columnas -->
      <div class="px-6 sm:px-12 lg:px-16 grid gap-8 lg:grid-cols-10 items-start">
        <div class="lg:col-span-4 lg:col-start-2">
          <p class="type__tiny_text_uc text-[#686155] mb-3">
            {attorneys.tag}
          </p>
          <h2 class="type__headline font-semibold text-[#111111] text-balance">
            <Lead text={attorneys.titulo} emClass="font-serif italic font-normal" />
          </h2>
        </div>

        <div class="lg:col-span-4 lg:col-start-6 space-y-4">
          <p class="text-base sm:text-lg leading-relaxed text-[#111111]/85">
            {attorneys.bajada}
          </p>
          <p class="text-sm leading-relaxed text-[#686155]">
            {prestador.bio}
          </p>
          <div class="pt-2">
            <a href={links.calendly} target="_blank" rel="noopener" class="link_dot">
              <span>Agendar reunión con el socio director</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Doble Ticker de píldoras de abogados (.badge__name) de Kümmerlein -->
      <div class="mt-12 space-y-4">
        <!-- Fila 1: Hacia la izquierda -->
        <div class="marquee overflow-hidden">
          <div class="marquee-track flex w-max gap-5 px-4">
            {
              [0, 1].map(() =>
                members.map((member: any) => (
                  <div class="badge__name group relative inline-flex h-[84px] w-[330px] sm:w-[370px] flex-shrink-0 items-center justify-between rounded-full bg-white pl-7 pr-2.5 text-[#111111] shadow-xs transition-colors duration-300 hover:bg-(--color-primary)">
                    <div class="pr-3">
                      <p class="font-display text-sm font-bold uppercase tracking-wide text-[#111111]">
                        {member.nombre}
                      </p>
                      <p class="type__tiny_text_uc mt-0.5 text-[10px] text-[#686155]">
                        {member.cargo}
                      </p>
                    </div>
                    <div class="flex h-[68px] w-[68px] flex-shrink-0 items-center justify-center rounded-full bg-(--color-primary) font-display text-lg font-bold text-[#111111] border border-black/10 transition-colors group-hover:bg-[#111111] group-hover:text-(--color-primary)">
                      {member.iniciales}
                    </div>
                  </div>
                ))
              )
            }
          </div>
        </div>

        <!-- Fila 2: Hacia la derecha -->
        <div class="marquee overflow-hidden">
          <div class="marquee-track-reverse flex w-max gap-5 px-4">
            {
              [0, 1].map(() =>
                [...members].reverse().map((member: any) => (
                  <div class="badge__name group relative inline-flex h-[84px] w-[330px] sm:w-[370px] flex-shrink-0 items-center justify-between rounded-full bg-white pl-7 pr-2.5 text-[#111111] shadow-xs transition-colors duration-300 hover:bg-(--color-primary)">
                    <div class="pr-3">
                      <p class="font-display text-sm font-bold uppercase tracking-wide text-[#111111]">
                        {member.nombre}
                      </p>
                      <p class="type__tiny_text_uc mt-0.5 text-[10px] text-[#686155]">
                        {member.credencial}
                      </p>
                    </div>
                    <div class="flex h-[68px] w-[68px] flex-shrink-0 items-center justify-center rounded-full bg-[#161615] font-display text-lg font-bold text-(--color-primary)">
                      {member.iniciales}
                    </div>
                  </div>
                ))
              )
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Bloque de Voces de Mandantes & Reconocimientos (.cm_logo_ticker + Reseñas verificadas) -->
    {
      visibleReviews.length > 0 && (
        <div id="opiniones" class="pt-4">
          <div class="grid gap-8 lg:grid-cols-10 items-end mb-10">
            <div class="lg:col-span-4 lg:col-start-2">
              <p class="type__tiny_text_uc text-(--color-accent) mb-2">
                {reviews.tag}
              </p>
              <h2 class="type__headline font-semibold text-(--color-ink)">
                {reviews.titulo}
              </h2>
            </div>
            <div class="lg:col-span-4 lg:col-start-6">
              <p class="text-base text-(--color-ink)/75">
                Confiá en la experiencia de nuestros representados. Ellos expresan con claridad cómo transformamos conflictos complejos en certidumbre ejecutiva.
              </p>
            </div>
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:px-[8.33%]">
            {
              visibleReviews.map((review) => (
                <figure class="flex flex-col justify-between rounded-[24px] border border-(--color-ink)/12 bg-white p-8 sm:p-10 text-[#111111] shadow-xs transition-colors duration-300 hover:bg-(--color-primary)/35">
                  <div>
                    <div class="flex items-center justify-between border-b border-black/10 pb-4">
                      <span class="type__tiny_text_uc flex items-center gap-2 text-[#111111]">
                        <span class="h-2.5 w-2.5 rounded-full bg-(--color-primary) border border-black/30" />
                        <span>Mandante Verificado</span>
                      </span>
                      <span class="type__tiny_text_uc text-[#686155]">{review.fuente}</span>
                    </div>
                    <blockquote class="mt-6 font-serif text-2xl sm:text-3xl italic leading-snug text-[#111111]">
                      “{review.texto}”
                    </blockquote>
                  </div>

                  <figcaption class="mt-8 pt-4 border-t border-black/10 flex items-center justify-between">
                    <span class="font-display text-sm font-bold uppercase tracking-wider text-[#111111]">
                      {review.nombre}
                    </span>
                    <span class="text-xs font-semibold text-[#686155]">★★★★★</span>
                  </figcaption>
                </figure>
              ))
            }
          </div>

          {!consent && (
            <p class="mt-6 text-center text-xs text-(--color-ink)/55">
              Reseñas públicas de Google Maps citadas conforme a la Ley 25.326 de Protección de Datos Personales.
            </p>
          )}
        </div>
      )
    }
  </div>
</section>
