---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { reviews } = CONTENT;
const consent = CONTENT.consentimiento_testimonios;
const visibles = consent
  ? reviews.items
  : reviews.items.filter((review) => review.fuente === "Google Maps");
---

{
  visibles.length > 0 && (
    <section id="opiniones" class="border-b border-(--color-ink)/10">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
        <SectionHead tag={reviews.tag} title={reviews.titulo} />

        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            visibles.map((review) => (
              <figure class="flex flex-col border border-(--color-ink)/15 bg-white/60 p-8">
                <p
                  class="text-sm tracking-[0.3em] text-(--color-primary)"
                  aria-label="5 de 5 estrellas"
                >
                  ★★★★★
                </p>
                <blockquote class="mt-5 flex-1 font-display text-xl italic leading-snug">
                  “{review.texto}”
                </blockquote>
                <figcaption class="mt-6 border-t border-(--color-ink)/10 pt-4">
                  <p class="text-sm font-semibold">{review.nombre}</p>
                  <p class="text-xs uppercase tracking-[0.2em] text-(--color-ink)/60">
                    {review.fuente}
                  </p>
                </figcaption>
              </figure>
            ))
          }
        </div>

        {
          !consent && (
            <p class="mt-8 text-sm text-(--color-ink)/50">
              Reseñas públicas de Google Maps, citadas con su fuente.
            </p>
          )
        }
      </div>
    </section>
  )
}
