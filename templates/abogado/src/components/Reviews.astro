---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { reviews } = CONTENT;
const consent = CONTENT.consentimiento_testimonios;
const visibles = consent
  ? reviews.items
  : reviews.items.filter((review) => review.fuente === "Google Maps");
---

{
  visibles.length > 0 && (
    <section id="opiniones" class="border-b border-(--color-ink)/10 bg-(--color-paper)">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
        <SectionHead tag={reviews.tag} title={reviews.titulo} />

        <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {
            visibles.map((review) => (
              <figure class="flex flex-col justify-between rounded-[18px] border border-(--color-ink)/15 bg-white/80 p-8 shadow-sm backdrop-blur-sm transition-all duration-300 hover:border-(--color-ink)/40">
                <div>
                  <div class="flex items-center justify-between border-b border-(--color-ink)/10 pb-4">
                    <span class="flex items-center gap-1 text-xs font-bold uppercase tracking-widest text-(--color-ink)">
                      <span class="h-2 w-2 rounded-full bg-(--color-primary)" />
                      Valoración 5.0
                    </span>
                    <span class="text-xs text-(--color-ink)/40">Verificada</span>
                  </div>
                  
                  <blockquote class="mt-6 font-display text-lg sm:text-xl font-medium leading-snug text-(--color-ink)">
                    “{review.texto}”
                  </blockquote>
                </div>

                <figcaption class="mt-8 border-t border-(--color-ink)/10 pt-4">
                  <p class="font-display text-sm font-bold text-(--color-ink)">{review.nombre}</p>
                  <p class="text-xs uppercase tracking-[0.2em] text-(--color-ink)/50">
                    {review.fuente}
                  </p>
                </figcaption>
              </figure>
            ))
          }
        </div>

        {
          !consent && (
            <p class="mt-8 text-xs text-(--color-ink)/50">
              Reseñas públicas de Google Maps, citadas con su fuente de origen.
            </p>
          )
        }
      </div>
    </section>
  )
}
