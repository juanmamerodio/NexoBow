---
import SectionHead from "./ui/SectionHead.astro";
import { CONTENT } from "../site";

const { pasos } = CONTENT;
---

<section id="metodo" class="border-b border-(--color-ink)/10 bg-(--soft-grey1)/30">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
    <SectionHead tag={pasos.tag} title={pasos.titulo} align="center" />

    <!-- 3 columnas con esquinas Kümmerlein (18px) y micro-detalles técnicos -->
    <div class="mt-16 grid gap-8 md:grid-cols-3">
      {
        pasos.steps.map((step) => (
          <div class="relative flex flex-col justify-between rounded-[18px] border border-(--color-ink)/15 bg-white/80 p-8 shadow-sm transition-all duration-300 hover:shadow-md">
            <div>
              <div class="flex items-center justify-between border-b border-(--color-ink)/10 pb-4">
                <span class="flex h-9 w-9 items-center justify-center rounded-[8px] bg-(--color-ink) font-display text-sm font-bold text-(--color-primary)">
                  {step.n}
                </span>
                <span class="h-1.5 w-1.5 rounded-full bg-(--color-primary)" />
              </div>
              
              <h3 class="mt-6 font-display text-2xl font-bold tracking-tight text-(--color-ink)">
                {step.k}
              </h3>
              
              <p class="mt-3 text-sm leading-relaxed text-(--color-ink)/75">
                {step.d}
              </p>
            </div>
            
            <div class="mt-8 pt-4 border-t border-(--color-ink)/5 flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-(--color-ink)/40">
              <span>Etapa {step.n}</span>
              <span>—</span>
              <span>Rigor K.</span>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-14 text-center font-display text-base sm:text-lg font-medium text-(--color-ink)/70 max-w-2xl mx-auto">
      {pasos.footer}
    </p>
  </div>
</section>
