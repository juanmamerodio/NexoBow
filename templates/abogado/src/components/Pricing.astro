---
import Button from "./ui/Button.astro";
import SectionHead from "./ui/SectionHead.astro";
import { ars, CONTENT } from "../site";

const { pricing, links } = CONTENT;
---

<section id="precios" class="border-b border-(--color-ink)/10 bg-(--color-paper)">
  <div class="mx-auto max-w-7xl px-6 py-20 lg:px-12 lg:py-28">
    <SectionHead tag={pricing.tag} title={pricing.titulo} align="center" />

    <!-- Tarjeta de Diagnóstico Kümmerlein (Fondo oscuro tinta, acento amarillo dot, bordes 18px) -->
    <div class="mx-auto mt-14 max-w-3xl rounded-[18px] bg-(--color-ink) p-8 text-(--color-paper) shadow-xl lg:p-14">
      <div class="flex items-center justify-between border-b border-white/10 pb-6">
        <div>
          <span class="inline-flex items-center gap-2 rounded-[6px] bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-(--color-primary)">
            <span class="h-1.5 w-1.5 rounded-full bg-(--color-primary)" />
            {pricing.plan}
          </span>
          <p class="mt-4 font-display text-4xl sm:text-5xl font-bold tracking-tight text-white">
            {ars(pricing.precio_ars)}
          </p>
        </div>
        <div class="text-right">
          <p class="text-xs uppercase tracking-wider text-white/60">{pricing.precio_label}</p>
          <p class="mt-1 text-xs font-medium text-(--color-primary)">{pricing.precio_sub}</p>
        </div>
      </div>

      <div class="mt-8">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/50">
          {pricing.detalle_titulo}
        </p>
        
        <ul class="mt-6 space-y-3.5">
          {
            pricing.incluido.map((item) => (
              <li class="flex items-start gap-3 text-sm text-white/80 leading-relaxed">
                <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-(--color-primary) text-[11px] font-bold text-(--color-ink)">
                  ✓
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <Button
          href={links.calendly}
          label={pricing.cta}
          variant="primary"
          size="lg"
          external={true}
        />
        <p class="text-xs text-white/50 max-w-xs text-center sm:text-right">
          {pricing.garantia}
        </p>
      </div>
    </div>
  </div>
</section>
