---
import { CONTENT } from "../site";
import Button from "./ui/Button.astro";

const q = CONTENT.quoteEstimationSection;
const p = CONTENT.prestador;
---

<section id="cotizar" class="py-20 md:py-28 bg-[var(--color-paper)] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Info Column -->
      <div class="lg:col-span-6 flex flex-col items-start">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-sm bg-[var(--color-asphalt-surface)] border border-[var(--color-asphalt-border)] mb-4">
          <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span>
          <span class="text-xs font-mono font-bold tracking-widest text-[var(--color-primary)] uppercase">
            {q.badge}
          </span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-display uppercase tracking-tight text-[var(--color-ink)] mb-4 leading-tight">
          {q.title}
        </h2>

        <p class="text-base sm:text-lg text-stone-300 font-sans leading-relaxed mb-8">
          {q.subtitle}
        </p>

        <!-- Pricing Card -->
        <div class="w-full bg-[var(--color-asphalt-surface)] border-2 border-[var(--color-primary)] p-6 sm:p-8 rounded-sm mb-8 shadow-xl relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-[var(--color-primary)] text-[#1c1917] font-mono font-black text-xs px-3 py-1 uppercase tracking-wider">
            100% Bonificado
          </div>
          <span class="text-xs font-mono text-stone-400 uppercase tracking-widest block mb-1">
            Relevamiento Topográfico In Situ
          </span>
          <div class="flex items-baseline gap-3 mb-3">
            <span class="text-4xl sm:text-5xl font-black font-display text-[var(--color-primary)]">
              {q.price}
            </span>
            <span class="text-xs text-stone-400 line-through font-mono">
              $290.000 ARS
            </span>
          </div>
          <p class="text-xs font-sans text-stone-300 leading-relaxed mb-6">
            {q.priceNote}
          </p>

          <div class="pt-4 border-t border-[var(--color-asphalt-border)] flex items-center gap-3">
            <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="text-xs font-mono text-stone-200">
              {q.guarantee}
            </span>
          </div>
        </div>

        <!-- Quick Contacts -->
        <div class="space-y-3 w-full">
          <div class="flex items-center gap-3 text-sm text-stone-300">
            <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span>
            <span>Atención directa: <strong class="text-[var(--color-ink)] font-mono">{p.phone_display}</strong></span>
          </div>
          <div class="flex items-center gap-3 text-sm text-stone-300">
            <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span>
            <span>Cobertura técnica: <strong class="text-[var(--color-ink)]">{p.ciudad}</strong></span>
          </div>
        </div>
      </div>

      <!-- Right Form / Interactive Request Card -->
      <div class="lg:col-span-6 bg-[var(--color-asphalt-surface)] border border-[var(--color-asphalt-border)] p-6 sm:p-10 rounded-sm shadow-2xl relative">
        <h3 class="text-2xl font-black font-display uppercase tracking-wide text-[var(--color-ink)] mb-2">
          Solicitar Relevamiento en Obra
        </h3>
        <p class="text-xs text-stone-400 font-mono uppercase tracking-wider mb-6">
          Completá los datos y te contactamos en menos de 2 horas hábiles.
        </p>

        <form
          action={q.whatsapp}
          method="GET"
          target="_blank"
          class="space-y-4"
        >
          <div>
            <label class="block text-xs font-mono font-bold uppercase tracking-wider text-stone-300 mb-1.5">
              Nombre o Empresa:
            </label>
            <input
              type="text"
              name="nombre"
              required
              placeholder="Ej: Logística Sudamericana S.A."
              class="w-full bg-[var(--color-paper)] border border-[var(--color-asphalt-border)] rounded-sm px-4 py-2.5 text-sm text-[var(--color-ink)] placeholder-stone-500 focus:outline-none focus:border-[var(--color-primary)] font-sans"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-mono font-bold uppercase tracking-wider text-stone-300 mb-1.5">
                Teléfono / WhatsApp:
              </label>
              <input
                type="tel"
                name="telefono"
                required
                placeholder="11 5555-4444"
                class="w-full bg-[var(--color-paper)] border border-[var(--color-asphalt-border)] rounded-sm px-4 py-2.5 text-sm text-[var(--color-ink)] placeholder-stone-500 focus:outline-none focus:border-[var(--color-primary)] font-mono"
              />
            </div>
            <div>
              <label class="block text-xs font-mono font-bold uppercase tracking-wider text-stone-300 mb-1.5">
                Ubicación del Predio:
              </label>
              <input
                type="text"
                name="ubicacion"
                placeholder="Ej: Tortuguitas, Pilar, etc."
                class="w-full bg-[var(--color-paper)] border border-[var(--color-asphalt-border)] rounded-sm px-4 py-2.5 text-sm text-[var(--color-ink)] placeholder-stone-500 focus:outline-none focus:border-[var(--color-primary)] font-sans"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-mono font-bold uppercase tracking-wider text-stone-300 mb-1.5">
                Superficie Estimada (m²):
              </label>
              <input
                type="text"
                name="superficie"
                placeholder="Ej: 2.500 m²"
                class="w-full bg-[var(--color-paper)] border border-[var(--color-asphalt-border)] rounded-sm px-4 py-2.5 text-sm text-[var(--color-ink)] placeholder-stone-500 focus:outline-none focus:border-[var(--color-primary)] font-mono"
              />
            </div>
            <div>
              <label class="block text-xs font-mono font-bold uppercase tracking-wider text-stone-300 mb-1.5">
                Tipo de Obra:
              </label>
              <select
                name="tipo"
                class="w-full bg-[var(--color-paper)] border border-[var(--color-asphalt-border)] rounded-sm px-4 py-2.5 text-sm text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-primary)] font-sans"
              >
                <option value="asfalto">Pavimentación Asfáltica (CAC)</option>
                <option value="hormigon">Hormigón H-30 Pesado</option>
                <option value="bacheo">Bacheo & Reparación Express</option>
                <option value="sellado">Sellado de Fisuras & Seal Coating</option>
                <option value="demarcacion">Demarcación Vial & Topes</option>
                <option value="otro">Relevamiento Integral</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-mono font-bold uppercase tracking-wider text-stone-300 mb-1.5">
              Detalle adicional o estado del suelo:
            </label>
            <textarea
              name="mensaje"
              rows="3"
              placeholder="Describí brevemente el tipo de tránsito (autoelevadores, camiones, livianos) o problemas actuales de agua..."
              class="w-full bg-[var(--color-paper)] border border-[var(--color-asphalt-border)] rounded-sm p-4 text-sm text-[var(--color-ink)] placeholder-stone-500 focus:outline-none focus:border-[var(--color-primary)] font-sans resize-none"
            ></textarea>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="w-full py-4 px-6 font-bold font-display uppercase tracking-wider text-base bg-[var(--color-primary)] text-[#1c1917] hover:bg-[var(--color-safety-warning)] transition-colors rounded-sm shadow-xl flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Enviar Solicitud por WhatsApp</span>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>

          <div class="text-center pt-2">
            <a
              href={q.bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-mono text-stone-400 hover:text-[var(--color-primary)] underline"
            >
              ¿Preferís agendar una videollamada técnica por Calendly? Hacé clic acá
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
