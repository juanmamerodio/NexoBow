---
import { CONTENT } from "../site";
import Button from "./ui/Button.astro";

const p = CONTENT.prestador;
---

<header class="sticky top-0 z-40 bg-[var(--color-paper)]/95 backdrop-blur-md border-b border-[var(--color-asphalt-border)]">
  <!-- Emergency / Dispatch Top Bar -->
  <div class="bg-[var(--color-asphalt-surface)] border-b border-[#38332f] text-xs font-mono py-1.5 px-4 text-center text-stone-300 flex items-center justify-between max-w-7xl mx-auto">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
      <span class="font-bold text-[var(--color-primary)] uppercase tracking-wide">Guardia de Obra 24/7:</span>
      <a href={`tel:${p.phone_display}`} class="hover:underline text-[var(--color-ink)] font-semibold">{p.phone_display}</a>
    </div>
    <div class="hidden md:flex items-center gap-4 text-stone-400">
      <span>{p.ciudad}</span>
      <span>·</span>
      <span>{p.matricula}</span>
    </div>
  </div>

  <!-- Main Navigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <a href="#" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] p-1 rounded">
      <div class="w-10 h-10 rounded bg-[var(--color-primary)] flex items-center justify-center text-[#1c1917] font-black text-xl shadow-md">
        <!-- Road Roller / Asphalt Icon SVG -->
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 6h-2V4c0-1.1-.9-2-2-2H9c-1.1 0-2 .9-2 2v2H5c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zM9 4h6v2H9V4zm10 14H5V8h14v10z"/>
          <circle cx="8" cy="13" r="2"/>
          <circle cx="16" cy="13" r="2"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-black text-lg tracking-wider text-[var(--color-ink)] uppercase font-display leading-tight group-hover:text-[var(--color-primary)] transition-colors">
          {p.nombre}
        </span>
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-primary)]">
          {p.titulo}
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-bold uppercase tracking-wider text-stone-300">
      <a href="#capacidades" class="hover:text-[var(--color-primary)] transition-colors py-2">Capacidad</a>
      <a href="#obras" class="hover:text-[var(--color-primary)] transition-colors py-2">Obras</a>
      <a href="#certificaciones" class="hover:text-[var(--color-primary)] transition-colors py-2">Certificaciones</a>
      <a href="#cotizar" class="hover:text-[var(--color-primary)] transition-colors py-2">Presupuesto</a>
      <a href="#faq" class="hover:text-[var(--color-primary)] transition-colors py-2">Faq</a>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <a
        href={CONTENT.quoteEstimationSection.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-mono font-bold text-emerald-400 bg-emerald-950/40 border border-emerald-700/50 hover:bg-emerald-900/50 px-3 py-2 rounded-sm transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        WhatsApp Técnico
      </a>
      <Button href="#cotizar" variant="primary" size="sm">
        Cotizar en Obra
      </Button>
    </div>
  </div>
</header>
