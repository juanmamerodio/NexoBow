---
import { CONTENT } from "../site";
import Button from "./ui/Button.astro";

const fc = CONTENT.finalCta;
const p = CONTENT.prestador;
const q = CONTENT.quoteEstimationSection;
---

<section class="relative py-20 md:py-24 bg-[var(--color-paper)] overflow-hidden">
  <!-- Diagonal hazard striping border -->
  <div
    class="h-2 w-full absolute top-0 left-0 right-0"
    style="background: repeating-linear-gradient(45deg, #f59e0b, #f59e0b 20px, #1c1917 20px, #1c1917 40px);"
  ></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <div class="inline-block px-3 py-1 bg-[var(--color-primary)] text-[#1c1917] font-mono font-black text-xs uppercase tracking-widest mb-6 rounded-sm">
      INTERVENCIÓN INMEDIATA EN PREDIO
    </div>

    <h2 class="text-3xl sm:text-5xl font-black font-display uppercase tracking-tight text-[var(--color-ink)] mb-6 max-w-3xl mx-auto leading-tight">
      {fc.title}
    </h2>

    <p class="text-base sm:text-xl text-stone-300 font-sans max-w-2xl mx-auto mb-10 leading-relaxed">
      {fc.subtitle}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href={q.whatsapp} target="_blank" rel="noopener noreferrer" variant="primary" size="lg">
        {fc.ctaWhatsapp}
      </Button>
      <a
        href={`tel:${p.phone_display}`}
        class="inline-flex items-center justify-center font-bold tracking-wider uppercase px-7 py-3.5 text-base rounded-sm border border-[var(--color-asphalt-border)] bg-[var(--color-asphalt-surface)] text-[var(--color-ink)] hover:border-[var(--color-primary)] transition-colors"
      >
        <svg class="w-5 h-5 mr-2 text-[var(--color-primary)]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
        </svg>
        {fc.ctaTel}
      </a>
    </div>
  </div>

  <div
    class="h-2 w-full absolute bottom-0 left-0 right-0"
    style="background: repeating-linear-gradient(45deg, #1c1917, #1c1917 20px, #f59e0b 20px, #f59e0b 40px);"
  ></div>
</section>
