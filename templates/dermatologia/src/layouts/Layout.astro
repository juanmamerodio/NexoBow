---
import "../styles/global.css";
import { CONTENT, fontUrl, themeVars, THEME } from "../site.ts";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const rootStyle = themeVars(THEME);
const fontsHref = fontUrl(THEME);

const pageTitle =
  title ?? CONTENT.meta?.title ?? `${CONTENT.prestador?.nombre} | ${CONTENT.prestador?.tagline || "Dermatología Clínica"}`;
const pageDescription =
  description ??
  CONTENT.meta?.description ??
  (CONTENT.hero?.subtitle || "").slice(0, 160);

const favicon = CONTENT.meta?.favicon || "/icons/FAVICON-3.svg";
---

<!doctype html>
<html lang="es-AR" style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preload" href="/fonts/PPRightGothic-CompactRegular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/PPRightGroteskText-Regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/PPRightGrotesk-Medium.woff" as="font" type="font/woff" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsHref} rel="stylesheet" />
  </head>
  <body
    class="relative min-h-screen bg-[var(--color-paper)] font-sans text-[var(--color-ink)] antialiased selection:bg-[var(--color-primary)] selection:text-[var(--color-on-primary)]"
  >
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
