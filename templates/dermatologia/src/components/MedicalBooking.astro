---
import { CONTENT } from "../site.ts";
import Button from "./ui/Button.astro";

const booking = CONTENT.medical_booking || {
  badge: "VALORACIÓN MÉDICA & AGENDAMIENTO",
  title: "Iniciá tu transformación sin miedos",
  subtitle: "El primer paso para recuperar tu movilidad, frenar la progresión del tejido graso y vivir sin dolor constante.",
  garantia: "Garantía de Claridad Clínica: Si durante los primeros 20 minutos de consulta no obtenés un plan de acción concreto y diagnóstico fundado, te reintegramos el 100% de tus honorarios.",
  direct_whatsapp: "Consultar Turnos por WhatsApp",
  direct_calendar: "Reservar Consulta Online"
};

const { prestador } = CONTENT;
---

<section id="agendar" class="py-16 sm:py-24 px-4 sm:px-8 bg-slate-900 text-white relative overflow-hidden">
  <!-- Glowing Background Accents -->
  <div class="absolute -top-40 right-0 w-96 h-96 rounded-full bg-[var(--color-primary)]/20 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 left-0 w-96 h-96 rounded-full bg-cyan-400/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <div class="p-8 sm:p-14 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-md">
      <div class="max-w-3xl mb-10">
        <span class="inline-block text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)] bg-white/10 px-3.5 py-1 rounded-full mb-3.5 border border-white/10">
          {booking.badge}
        </span>
        <h2 class="type-h2 font-display text-white mb-4">
          {booking.title}
        </h2>
        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
          {booking.subtitle}
        </p>
      </div>

      <!-- Garantía Hormozi de Reversión Total de Riesgo -->
      <div class="p-6 rounded-2xl bg-[var(--color-primary)]/15 border border-[var(--color-primary)]/30 mb-10 flex items-start gap-4">
        <div class="w-10 h-10 rounded-full bg-[var(--color-primary)]/30 text-[var(--color-accent)] flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div>
          <h4 class="font-display font-bold text-sm sm:text-base text-white mb-1">
            Compromiso Médico & Reversión Total de Riesgo
          </h4>
          <p class="text-xs sm:text-sm text-slate-300 font-sans leading-relaxed">
            {booking.garantia}
          </p>
        </div>
      </div>

      <!-- Botones de Acción de Agendamiento Directo -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-10">
        <Button
          href={prestador.whatsapp}
          variant="primary"
          size="lg"
          class="justify-center text-center"
          target="_blank"
          rel="noopener noreferrer"
        >
          {booking.direct_whatsapp}
        </Button>

        <a
          href={`tel:${prestador.telefono}`}
          class="inline-flex items-center justify-center gap-2 text-sm sm:text-base font-medium py-3.5 px-6 rounded-full border border-white/20 text-white hover:bg-white/10 transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Llamar al Consultorio ({prestador.telefono})</span>
        </a>
      </div>

      <!-- Trust Badges Médicos -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-white/10 text-xs text-slate-400 font-sans">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Presencial en Recoleta o Virtual HD</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Matrícula Nacional & Provincial Oficial</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Ley 25.326 Secreto Médico Confidencial</span>
        </div>
      </div>
    </div>
  </div>
</section>
