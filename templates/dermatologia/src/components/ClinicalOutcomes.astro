---
import { CONTENT } from "../site.ts";

const outcomes = CONTENT.clinical_outcomes || {
  badge: "NUESTRAS VENTAJAS CLÍNICAS",
  title: "Por qué confiar tu salud en nuestro equipo",
  subtitle: "La combinación de rigor científico, tecnología de diagnóstico no invasivo y comprensión empática profunda.",
  advantages: [],
  testimonials: [],
};

const rawReviews = CONTENT.reviews;
const reviewsList = Array.isArray(rawReviews) ? rawReviews : (rawReviews?.items || []);
const testimonials = (outcomes.testimonials && outcomes.testimonials.length > 0) ? outcomes.testimonials : reviewsList;
---

<section id="ventajas" class="py-16 sm:py-24 px-4 sm:px-8 bg-[var(--color-paper)]">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado de Ventajas Clínicas -->
    <div class="max-w-3xl mb-14 sm:mb-18">
      <span class="inline-block text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)] bg-[var(--color-accent)]/80 px-3.5 py-1 rounded-full mb-3.5">
        {outcomes.badge}
      </span>
      <h2 class="type-h2 font-display text-[var(--color-ink)] mb-4">
        {outcomes.title}
      </h2>
      <p class="text-base sm:text-lg text-[var(--color-ink)]/70 font-sans leading-relaxed">
        {outcomes.subtitle}
      </p>
    </div>

    <!-- 5 Pilares Clínicos con Glyphs Auténticos de Lipedema Guru -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6 mb-20 sm:mb-24">
      {
        outcomes.advantages.map((adv: any, index: number) => (
          <div class="p-6 rounded-2xl bg-white border border-[var(--color-clinical-border)] hover:border-[var(--color-primary)]/50 transition-all hover:shadow-md flex flex-col justify-between">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent)]/60 flex items-center justify-center mb-5 p-2.5">
                <img
                  src={adv.icon}
                  alt={adv.title}
                  class="w-full h-full object-contain filter"
                />
              </div>
              <span class="text-xs font-mono text-[var(--color-primary)] font-semibold block mb-1">
                Pilar 0{index + 1}
              </span>
              <h3 class="font-display text-lg font-bold text-[var(--color-ink)] mb-2 leading-snug">
                {adv.title}
              </h3>
              <p class="text-xs sm:text-sm text-[var(--color-ink)]/70 font-sans leading-relaxed">
                {adv.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Sección de Testimonios y Casos Documentados -->
    <div class="pt-12 border-t border-[var(--color-clinical-border)]">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full inline-block mb-2">
            Casos Clínicos & Experiencias de Pacientes
          </span>
          <h3 class="font-display text-2xl sm:text-3xl font-bold text-[var(--color-ink)]">
            Evolución y Calidad de Vida Recuperada
          </h3>
        </div>
        <div class="flex items-center gap-1.5 text-xs text-[var(--color-ink)]/60 font-sans">
          <span class="flex text-amber-400">★★★★★</span>
          <span class="font-medium text-[var(--color-ink)]">5.0 / 5.0</span>
          <span>(Consentimiento ético informado)</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {
          testimonials.map((t: any) => (
            <div class="clinical-card p-6 sm:p-7 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="flex text-amber-400 text-sm">
                    {"★".repeat(t.rating || t.estrellas || 5)}
                  </div>
                  <span class="text-xs font-mono bg-slate-100 text-slate-700 px-2 py-0.5 rounded">
                    {t.estadio || t.ocupacion || "Paciente Verificada"}
                  </span>
                </div>
                <blockquote class="text-sm sm:text-base text-[var(--color-ink)]/80 font-sans leading-relaxed italic mb-6">
                  "{t.texto || t.comentario || t.bajada}"
                </blockquote>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <h4 class="font-display font-bold text-sm text-[var(--color-ink)]">
                    {t.nombre}
                  </h4>
                  <span class="text-xs text-[var(--color-ink)]/50 font-sans">
                    {t.edad || t.resultado || ""}
                  </span>
                </div>
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
