---
import { CONTENT } from "../site.ts";

const assessment = CONTENT.symptom_assessment || {
  badge: "DIAGNÓSTICO DIFERENCIAL & SIGNOS",
  title: "Cuándo podemos ayudarte",
  subtitle: "El lipedema suele confundirse erróneamente con sobrepeso o retención hídrica convencional.",
  items: []
};
---

<section id="sintomas" class="py-16 sm:py-24 px-4 sm:px-8 bg-[var(--color-paper)]">
  <div class="max-w-7xl mx-auto">
    <!-- Encabezado de Sección -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <span class="inline-block text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)] bg-[var(--color-accent)]/60 px-3 py-1 rounded-full mb-3.5">
        {assessment.badge}
      </span>
      <h2 class="type-h2 font-display text-[var(--color-ink)] mb-4">
        {assessment.title}
      </h2>
      <p class="text-base sm:text-lg text-[var(--color-ink)]/70 font-sans leading-relaxed">
        {assessment.subtitle}
      </p>
    </div>

    <!-- Grilla de Tarjetas Clínicas de Síntomas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {
        assessment.items.map((item: any) => (
          <div class="clinical-card p-6 sm:p-8 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <span class="w-10 h-10 rounded-full bg-[var(--color-accent)] text-[var(--color-primary)] font-display font-bold text-sm flex items-center justify-center border border-[var(--color-primary)]/15 group-hover:scale-110 transition-transform">
                  {item.id}
                </span>
                <span class="text-xs font-medium text-[var(--color-ink)]/40 font-mono uppercase tracking-wider">
                  Criterio Clínico
                </span>
              </div>
              <h3 class="font-display text-xl sm:text-2xl font-bold text-[var(--color-ink)] mb-3 leading-snug group-hover:text-[var(--color-primary)] transition-colors">
                {item.title}
              </h3>
              <p class="text-sm sm:text-base text-[var(--color-ink)]/70 font-sans leading-relaxed">
                {item.desc}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-[var(--color-clinical-border)]/60 flex items-center justify-between text-xs font-medium text-[var(--color-primary)]">
              <span>Signo Evaluado en Consulta</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none">
                <path d="M3.33334 8H12.6667M12.6667 8L8.00001 3.33334M12.6667 8L8.00001 12.6667" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Banner de Orientación Diagnóstica Rápida -->
    <div class="mt-12 sm:mt-16 p-6 sm:p-8 rounded-2xl bg-[var(--color-accent)]/50 border border-[var(--color-primary)]/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="space-y-1">
        <h4 class="font-display text-lg sm:text-xl font-bold text-[var(--color-ink)]">
          ¿Te sentís identificada con 2 o más de estos signos?
        </h4>
        <p class="text-xs sm:text-sm text-[var(--color-ink)]/70 font-sans">
          Un diagnóstico temprano evita la progresión a estadios avanzados y previene fibrosis innecesaria.
        </p>
      </div>
      <a
        href="#agendar"
        class="btn-clinical btn-clinical-primary text-xs sm:text-sm py-2.5 px-6 whitespace-nowrap"
      >
        Solicitar Evaluación Médica
      </a>
    </div>
  </div>
</section>
