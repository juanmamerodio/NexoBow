# Cloudflare API Credentials (para deploys y gestión de subdominios)
CLOUDFLARE_API_TOKEN="tu_token_de_cloudflare_aqui"
CLOUDFLARE_ACCOUNT_ID="tu_account_id_aqui"

# Dominio raíz de la agencia para subdominios (ej: nexobow.site)
NEXOBOW_ROOT_DOMAIN="nexobow.site"

# Supabase Credentials (Admin Cockpit & CRM)
PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="tu_anon_key_publica_aqui"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui" # Para scripts de migración y CLI
ADMIN_OWNER_EMAIL="juanma@nexobow.site"

# Zoho Mail Outbound SMTP (Gate 0 B2B Outreach — sin credenciales reales)
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER="juanma@nexobow.site"
ZOHO_SMTP_PASS="tu_app_password_zoho_aqui"
ZOHO_FROM_NAME="Juanma Merodio · NexoBow"

# Alertas Hot-Lead (/api/ping), Confirmación Inbound y Seguimiento vía Resend API
RESEND_API_KEY="re_tu_api_key_resend_aqui"
RESEND_FROM_EMAIL="NexoBow <hola@nexobow.site>"

# Clave HMAC-SHA256 para firmar enlaces de baja (/api/unsubscribe)
UNSUBSCRIBE_SECRET="reemplazar_con_clave_hmac_aleatoria_de_32_bytes"

# ElevenLabs Plan Starter (notas de voz 35s en scripts/generate-voice-note.mjs y MCP)
ELEVENLABS_API_KEY="sk_tu_api_key_elevenlabs_aqui"
ELEVENLABS_VOICE_ID="tu_voice_id_clonado_aqui"

# Analítica y SEO Público (web/ — opcional; GA4 solo carga tras consentimiento explícito)
PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
PUBLIC_GOOGLE_SITE_VERIFICATION="tu_codigo_de_verificacion_search_console"
