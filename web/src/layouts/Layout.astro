---
import "../styles/global.css";
import { SITE } from "../config";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#040607" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class="selection:bg-[#BF40FA] selection:text-[#F8F6FF] relative min-h-screen bg-[#040607] text-[#F8F6FF]">
    <!-- Soft-Obsidian atmospheric glows (#5B2A62 Velvet & #4928C2 Ultrasonic at 10-18% opacity) -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden z-0">
      <div
        class="animate-glow-mesh absolute -top-44 -left-40 h-[620px] w-[620px] rounded-full bg-[#5B2A62]/18 blur-[150px]"
      ></div>
      <div
        class="animate-glow-mesh absolute top-1/3 -right-44 h-[540px] w-[540px] rounded-full bg-[#4928C2]/14 blur-[140px]"
        style="animation-delay: -4s;"
      ></div>
      <div
        class="animate-glow-mesh absolute -bottom-44 left-1/4 h-[560px] w-[560px] rounded-full bg-[#5B2A62]/12 blur-[160px]"
        style="animation-delay: -2s;"
      ></div>
    </div>

    <div class="relative z-10">
      <slot />
    </div>

    <!-- Floating 0-JS WhatsApp Pill (Bottom-Right, Pure CSS) -->
    <a
      href={SITE.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group fixed bottom-5 right-5 z-50 flex items-center gap-2.5 rounded-full border border-emerald-500/50 bg-[#0B0D12]/95 px-4 py-3 text-xs font-bold text-[#F8F6FF] shadow-[0_10px_35px_rgba(0,0,0,0.85),0_0_20px_rgba(16,185,129,0.25)] backdrop-blur-xl transition-all duration-300 hover:scale-105 hover:border-emerald-400 hover:shadow-[0_0_30px_rgba(16,185,129,0.45)]"
      aria-label={`Contactar por WhatsApp a Juanma Merodio (${SITE.phone})`}
    >
      <span class="flex h-2.5 w-2.5 items-center justify-center">
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
      </span>
      <span class="hidden sm:inline text-[#E3D9FC] group-hover:text-[#F8F6FF] transition-colors">
        WhatsApp: <span class="text-emerald-400 font-extrabold">{SITE.phone}</span>
      </span>
      <span class="sm:hidden text-emerald-400 font-bold">WhatsApp</span>
      <svg class="h-4 w-4 text-emerald-400 group-hover:translate-x-0.5 transition-transform" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.86.897 2.796.897h.001c3.181 0 5.767-2.587 5.768-5.766.001-3.181-2.585-5.767-5.769-5.767zm7.575 5.766c-.002 4.174-3.398 7.57-7.574 7.57-1.309 0-2.548-.344-3.649-.976l-4.383 1.15 1.17-4.272c-.722-1.15-1.107-2.483-1.108-3.864.002-4.174 3.398-7.57 7.574-7.57 4.176 0 7.572 3.397 7.572 7.57z" />
      </svg>
    </a>
  </body>
</html>
