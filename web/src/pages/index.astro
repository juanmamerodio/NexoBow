---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import InteractiveFunnel from "../components/InteractiveFunnel.astro";
import TemplateCatalog from "../components/TemplateCatalog.astro";
import RoiCalculator from "../components/RoiCalculator.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Pricing from "../components/Pricing.astro";
import CreateBowSystem from "../components/CreateBowSystem.astro";
import Founder from "../components/Founder.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";
import { buildHomeJsonLd } from "../lib/seo";

const homeJsonLd = buildHomeJsonLd(SITE.faqs);
---

<Layout
  title="NexoBow | Páginas Web y Turnos por WhatsApp para Médicos y Profesionales"
  description="Diseño de páginas web para consultorios médicos, odontólogos, nutricionistas, psicólogos y estudios jurídicos en Argentina. Sistema de turnos online con WhatsApp y Google Maps en menos de 1 segundo."
  canonicalPath="/"
  jsonLd={homeJsonLd}
>
  <Header />
  <main>
    <Hero />
    <BeforeAfter />
    <InteractiveFunnel />
    <TemplateCatalog />
    <RoiCalculator />
    <CaseStudies />
    <Pricing />
    <CreateBowSystem />
    <Founder />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Layout>
