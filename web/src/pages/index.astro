---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import InteractiveFunnel from "../components/InteractiveFunnel.astro";
import TemplateCatalog from "../components/TemplateCatalog.astro";
import RoiCalculator from "../components/RoiCalculator.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Pricing from "../components/Pricing.astro";
import CreateBowSystem from "../components/CreateBowSystem.astro";
import Founder from "../components/Founder.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="NexoBow | Sistema de Captación y Agendamiento B2B (<0.8s)"
  description="Transformamos tus clics de Google Maps e Instagram en consultorías agendadas automáticamente. Sin secretarias, en Astro SSG (<0.8s) y con +10 diseños exclusivos por rubro."
>
  <Header />
  <main>
    <Hero />
    <BeforeAfter />
    <InteractiveFunnel />
    <TemplateCatalog />
    <RoiCalculator />
    <CaseStudies />
    <Pricing />
    <CreateBowSystem />
    <Founder />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Layout>
