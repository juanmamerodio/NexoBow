---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";
---

<Layout
  title="Baja de Correos Confirmada | NexoBow"
  description="Confirmación de baja de comunicaciones comerciales por correo electrónico en NexoBow conforme a la Ley 25.326."
  canonicalPath="/baja-email/"
  noindex={true}
>
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-24 sm:py-28 text-center">
    <div class="rounded-3xl border border-[#4928C2]/45 bg-[#0B0D12] p-10 sm:p-14 shadow-[0_20px_60px_rgba(4,6,7,0.9)]">
      <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl border border-emerald-500/50 bg-emerald-500/15 text-2xl text-emerald-400" aria-hidden="true">
        ✓
      </div>
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-400">
        Preferencia de Comunicaciones · Ley N° 25.326
      </p>
      <h1 class="mt-3 font-outfit text-3xl font-extrabold tracking-tight text-[#F8F6FF] sm:text-4xl">
        ¡Listo! Ya te dimos de baja de nuestros correos.
      </h1>
      <p class="mt-4 text-base sm:text-lg leading-relaxed text-[#E3D9FC]/90">
        Tu dirección fue removida de nuestra lista de envíos comerciales y de seguimiento: no vas a recibir más correos sobre tu muestra web ni recordatorios automáticos.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-[#E3D9FC]/75">
        Conforme a la Ley N° 25.326 y nuestra{" "}
        <a
          href="/privacidad/#retencion"
          class="font-semibold text-[#E3D9FC] underline decoration-[#BF40FA]/70 underline-offset-2 hover:text-[#BF40FA]"
        >
          Política de Privacidad
        </a>
        , conservamos únicamente la marca mínima de bloqueo para evitar futuros envíos por error. Si querés ejercer otro derecho ARCO o retomar el contacto en el futuro, podés escribirnos a{" "}
        <a href={`mailto:${SITE.email}`} class="font-semibold text-[#E3D9FC] underline decoration-[#4928C2] underline-offset-2 hover:text-[#BF40FA]">
          {SITE.email}
        </a>.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="/"
          class="inline-flex min-h-11 items-center gap-2 rounded-full bg-[#BF40FA] px-6 py-3 text-sm font-extrabold text-[#040607] transition-colors hover:bg-[#D170FF] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F8F6FF]"
        >
          <span>← Volver a NexoBow</span>
        </a>
        <a
          href="/privacidad/"
          class="inline-flex min-h-11 items-center gap-2 rounded-full border border-[#4928C2]/55 bg-[#040607] px-6 py-3 text-sm font-semibold text-[#E3D9FC] transition-colors hover:border-[#BF40FA] hover:text-[#F8F6FF]"
        >
          <span>Ver Política de Privacidad</span>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
