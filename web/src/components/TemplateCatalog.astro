---
import { SITE } from "../config";
---

<section id="disenos" class="relative mx-auto max-w-6xl px-6 py-24">
  <div class="mx-auto max-w-3xl text-center mb-14">
    <div class="mb-3 inline-block rounded-full border border-[#4928C2]/45 bg-[#0B0D12] px-4 py-1.5 text-xs font-bold tracking-wider text-[#E3D9FC] uppercase">
      Identidad Propia por Especialidad
    </div>
    <h2 class="font-outfit text-3xl font-extrabold tracking-tight text-[#F8F6FF] sm:text-4xl md:text-5xl">
      Más de 10 arquitecturas visuales exclusivas. <span class="text-[#BF40FA]">Cero páginas clonadas.</span>
    </h2>
    <p class="mt-4 text-lg text-[#E3D9FC]/90">
      Cada consultorio o estudio recibe un diseño pensado para su especialidad, nunca la misma página repetida que otro colega de tu ciudad.
    </p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
    {SITE.templateCatalog.map((tpl) => {
      const isLive = tpl.status === "En Vivo (Demo)";
      return (
        <div class="group relative flex flex-col justify-between rounded-2xl border border-[#4928C2]/35 bg-[#0B0D12] p-5 transition-all duration-300 hover:-translate-y-1 hover:border-[#BF40FA]/75">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="font-outfit text-xs font-bold text-[#E3D9FC]/75">#{tpl.id}</span>
              <span
                class={`rounded-full px-2.5 py-0.5 text-xs font-bold ${
                  isLive
                    ? "bg-[#BF40FA] text-[#040607]"
                    : "border border-[#4928C2]/50 bg-[#040607] text-[#E3D9FC]"
                }`}
              >
                {tpl.status}
              </span>
            </div>

            <h3 class="mt-3 font-outfit text-lg font-bold text-[#F8F6FF]">{tpl.name}</h3>
            <p class="mt-0.5 text-xs font-semibold text-[#E3D9FC]">{tpl.niche}</p>
            <p class="mt-2.5 text-sm leading-relaxed text-[#E3D9FC]/80">{tpl.description}</p>
          </div>

          <div class="mt-5 space-y-3 border-t border-[#4928C2]/25 pt-3.5">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-medium text-[#E3D9FC]/75">Colores</span>
              <div class="flex items-center gap-1.5">
                {tpl.palette.map((hex) => (
                  <span
                    class="h-4 w-4 rounded-full border border-white/25"
                    style={`background-color: ${hex};`}
                    title={hex}
                  />
                ))}
              </div>
            </div>
            {tpl.demoUrl && (
              <a
                href={tpl.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full rounded-lg border border-[#BF40FA]/55 bg-[#040607] py-2 text-center text-xs font-bold text-[#E3D9FC] transition-colors hover:bg-[#BF40FA] hover:text-[#040607]"
              >
                Ver demo en vivo<span class="sr-only"> de {tpl.name}</span> ↗
              </a>
            )}
          </div>
        </div>
      );
    })}
  </div>
</section>
