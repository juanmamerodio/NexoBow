---
import { SITE } from "../config";
const links = [
  { href: "#problema", label: "El Problema" },
  { href: "#como-funciona", label: "Cómo Funciona" },
  { href: "#disenos", label: "Diseños (+10)" },
  { href: "#casos-de-exito", label: "Casos de Éxito" },
  { href: "#calculadora-roi", label: "Calculadora ROI" },
  { href: "#planes", label: "Planes y Bonos" },
  { href: "#quien-esta-detras", label: "Quién Está Detrás" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="sticky top-0 z-50 border-b border-[#4928C2]/20 bg-[#040607]/85 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
    <!-- Brand Logo: Nexo (#F8F6FF) + Bow (#BF40FA) in Outfit Bold -->
    <div class="flex items-center gap-4">
      <a href="/" class="group flex items-center gap-0.5 font-outfit text-2xl font-extrabold tracking-tight">
        <span class="text-[#F8F6FF] transition-colors">Nexo</span>
        <span class="text-[#BF40FA] drop-shadow-[0_0_10px_rgba(191,64,250,0.45)]">Bow</span>
        <span class="ml-1 inline-block h-2 w-2 rounded-full bg-[#BF40FA]"></span>
      </a>

      <div class="hidden items-center gap-2 rounded-full border border-[#4928C2]/30 bg-[#0B0D12] px-3 py-1 text-[11px] font-medium text-[#E3D9FC] xl:inline-flex">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        <span>Cupos de implementación abiertos</span>
      </div>
    </div>

    <!-- Executive Navigation -->
    <nav class="hidden items-center gap-1 text-xs font-medium text-[#E3D9FC]/80 lg:flex" aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          class="rounded-full px-3 py-2 transition-all duration-200 hover:bg-[#5B2A62]/20 hover:text-[#F8F6FF]"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Primary Conversion Action Button: Direct WhatsApp Contact -->
    <a
      href={SITE.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative inline-flex items-center gap-2.5 rounded-full border border-emerald-500/50 bg-[#0B0D12] p-1 pl-4 pr-1.5 text-xs font-semibold tracking-wide text-[#F8F6FF] transition-all duration-300 hover:border-emerald-400 hover:bg-emerald-950/20 hover:shadow-[0_0_24px_rgba(16,185,129,0.3)]"
    >
      <span class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        <span>Contactar por WhatsApp</span>
      </span>
      <span class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-500 text-[#040607] font-extrabold transition-all duration-300 group-hover:translate-x-0.5 group-hover:bg-emerald-400">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.586 1.86.897 2.796.897h.001c3.181 0 5.767-2.587 5.768-5.766.001-3.181-2.585-5.767-5.769-5.767zm7.575 5.766c-.002 4.174-3.398 7.57-7.574 7.57-1.309 0-2.548-.344-3.649-.976l-4.383 1.15 1.17-4.272c-.722-1.15-1.107-2.483-1.108-3.864.002-4.174 3.398-7.57 7.574-7.57 4.176 0 7.572 3.397 7.572 7.57z" />
        </svg>
      </span>
    </a>
  </div>
</header>
