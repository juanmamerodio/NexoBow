---
const steps = [
  {
    id: "step-1",
    panelClass: "step-panel-1",
    labelClass: "step-label-1",
    diagramId: "funnel-step-1",
    tabNum: "Paso 01",
    tabTitle: "1. Te encuentran",
    stageTag: "Etapa 01 · Búsqueda en tu zona",
    heading: "Cuando alguien busca tu especialidad hoy, llega directo a tu página.",
    nodes: [
      {
        title: "Búsqueda local",
        detail: "El paciente te encuentra en Google Maps o Instagram.",
        icon: "search",
      },
      {
        title: "Perfil con reseñas",
        detail: "Ve tus estrellas reales y horarios de atención.",
        icon: "star",
      },
      {
        title: "Clic a tu página",
        detail: "Aterriza en un lugar serio, no en un chat frío.",
        icon: "arrow-up-right",
      },
    ],
  },
  {
    id: "step-2",
    panelClass: "step-panel-2",
    labelClass: "step-label-2",
    diagramId: "funnel-step-2",
    tabNum: "Paso 02",
    tabTitle: "2. Te conocen",
    stageTag: "Etapa 02 · Confianza antes de escribir",
    heading: "Abre al instante en el celular y muestra cómo trabajás sin vueltas.",
    nodes: [
      {
        title: "Abre en menos de 1s",
        detail: "Funciona fluido incluso con datos móviles lentos.",
        icon: "bolt",
      },
      {
        title: "Método y valor claros",
        detail: "Muestra tu especialidad, ubicación y preguntas frecuentes.",
        icon: "check",
      },
      {
        title: "Cero dudas básicas",
        detail: "Entiende el servicio antes de mandarte un mensaje.",
        icon: "shield",
      },
    ],
  },
  {
    id: "step-3",
    panelClass: "step-panel-3",
    labelClass: "step-label-3",
    diagramId: "funnel-step-3",
    tabNum: "Paso 03",
    tabTitle: "3. Piden turno",
    stageTag: "Etapa 03 · Turno o consulta ordenada",
    heading: "Se terminan los 15 mensajes sueltos para coordinar un horario.",
    nodes: [
      {
        title: "Botón visible de turno",
        detail: "Accesible desde el celular con un solo toque.",
        icon: "calendar",
      },
      {
        title: "Agenda o WhatsApp listo",
        detail: "Elige horario disponible o envía su motivo de consulta.",
        icon: "chat",
      },
      {
        title: "Consultas decididas",
        detail: "Hablás solo con personas listas para atenderse.",
        icon: "check",
      },
    ],
  },
  {
    id: "step-4",
    panelClass: "step-panel-4",
    labelClass: "step-label-4",
    diagramId: "funnel-step-4",
    tabNum: "Paso 04",
    tabTitle: "4. Confirman y asisten",
    stageTag: "Etapa 04 · Recordatorios y asistencia",
    heading: "Cada turno queda confirmado con recordatorios automáticos 24h y 2h antes.",
    nodes: [
      {
        title: "Aviso 24h y 2h antes",
        detail: "El paciente confirma o reprograma con un toque.",
        icon: "bell",
      },
      {
        title: "Lista de espera activa",
        detail: "Si alguien libera un lugar, se ofrece al siguiente.",
        icon: "users",
      },
      {
        title: "Agenda aprovechada",
        detail: "Reducís ausencias y recuperás horas libres cada semana.",
        icon: "shield",
      },
    ],
  },
];
---

<section id="como-funciona" class="relative mx-auto max-w-6xl px-6 py-24">
  <div class="mx-auto max-w-3xl text-center mb-12">
    <div class="mb-3 inline-block rounded-full border border-[#4928C2]/45 bg-[#0B0D12] px-4 py-1.5 text-xs font-bold tracking-wider text-[#E3D9FC] uppercase">
      Esquema Visual · En 4 Pasos
    </div>
    <h2 class="font-outfit text-3xl font-extrabold tracking-tight text-[#F8F6FF] sm:text-4xl md:text-5xl">
      Probá en vivo cómo funciona tu embudo en <span class="text-[#BF40FA]">4 pasos</span>
    </h2>
    <p class="mt-4 text-lg text-[#E3D9FC]/90">
      Tocá cada etapa para ver el recorrido completo, desde que te buscan hasta que se sientan a atenderse.
    </p>
  </div>

  <!-- 0-JS Interactive Tabs Container using CSS :has(:checked) -->
  <div class="funnel-tabs rounded-3xl border border-[#4928C2]/45 bg-[#0B0D12] p-6 sm:p-10 shadow-[0_20px_50px_rgba(4,6,7,0.85)]">
    <!-- Hidden Radio Inputs (accessible via keyboard & click) -->
    <input type="radio" name="funnel-step" id="step-1" class="sr-only" checked />
    <input type="radio" name="funnel-step" id="step-2" class="sr-only" />
    <input type="radio" name="funnel-step" id="step-3" class="sr-only" />
    <input type="radio" name="funnel-step" id="step-4" class="sr-only" />

    <!-- Step Selector Labels -->
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <label
          for={s.id}
          class={`${s.labelClass} cursor-pointer rounded-2xl border border-[#4928C2]/35 bg-[#040607] p-4 transition-all duration-200 hover:border-[#BF40FA]`}
        >
          <span class="text-xs font-bold tracking-wider text-[#E3D9FC] uppercase">{s.tabNum}</span>
          <p class="mt-1 font-outfit text-base sm:text-lg font-bold text-[#F8F6FF]">{s.tabTitle}</p>
        </label>
      ))}
    </div>

    <!-- Step Visual 3-Node Infographic Panels (flat divider, no nested card box) -->
    <div class="mt-8 border-t border-[#4928C2]/30 pt-8">
      {steps.map((s, sIdx) => (
        <div class={`${s.panelClass} ${sIdx === 0 ? "block" : "hidden"}`}>
          <div class="mb-7 max-w-3xl">
            <span class="inline-block rounded-full bg-[#4928C2]/35 px-3.5 py-1 text-xs font-bold text-[#E3D9FC]">
              {s.stageTag}
            </span>
            <h3 class="mt-3 font-outfit text-2xl sm:text-3xl font-bold text-[#F8F6FF]">
              {s.heading}
            </h3>
          </div>

          <ol
            data-diagram={s.diagramId}
            aria-label={`Infografía ${s.tabTitle} en 3 nodos`}
            class="grid items-center gap-4 md:grid-cols-[1fr_auto_1fr_auto_1fr]"
          >
            {s.nodes.map((node, nIdx) => (
              <>
                <li class="flex items-start gap-3.5 rounded-2xl bg-[#040607] p-5 border-l-4 border-[#BF40FA]">
                  <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#4928C2]/30 text-[#E3D9FC]" aria-hidden="true">
                    {node.icon === "search" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    )}
                    {node.icon === "star" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z"/></svg>
                    )}
                    {node.icon === "arrow-up-right" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
                    )}
                    {node.icon === "bolt" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
                    )}
                    {node.icon === "check" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="m5 13 4 4L19 7"/></svg>
                    )}
                    {node.icon === "shield" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="M12 3l8 3v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
                    )}
                    {node.icon === "calendar" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
                    )}
                    {node.icon === "chat" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="M4 5h16v11H7l-3 3z"/></svg>
                    )}
                    {node.icon === "bell" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 8-3 8h18s-3-1-3-8"/><path d="M10.3 20a2 2 0 0 0 3.4 0"/></svg>
                    )}
                    {node.icon === "users" && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><circle cx="9" cy="8" r="3.5"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14a4.5 4.5 0 0 1 5 5"/></svg>
                    )}
                  </span>
                  <div>
                    <p class="font-outfit text-base sm:text-lg font-bold text-[#F8F6FF]">{node.title}</p>
                    <p class="mt-1 text-base leading-relaxed text-[#E3D9FC]/85">{node.detail}</p>
                  </div>
                </li>

                {nIdx < s.nodes.length - 1 && (
                  <li aria-hidden="true" class="flex justify-center py-1 md:py-0">
                    <svg class="h-6 w-6 text-[#BF40FA] rotate-90 md:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                      <path d="M4 12h15" />
                      <path d="m14 6 6 6-6 6" />
                    </svg>
                  </li>
                )}
              </>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .funnel-tabs:has(#step-1:checked) .step-label-1,
  .funnel-tabs:has(#step-2:checked) .step-label-2,
  .funnel-tabs:has(#step-3:checked) .step-label-3,
  .funnel-tabs:has(#step-4:checked) .step-label-4 {
    border-color: #BF40FA;
    background-color: rgba(91, 42, 98, 0.35);
  }

  .funnel-tabs:has(#step-1:focus-visible) .step-label-1,
  .funnel-tabs:has(#step-2:focus-visible) .step-label-2,
  .funnel-tabs:has(#step-3:focus-visible) .step-label-3,
  .funnel-tabs:has(#step-4:focus-visible) .step-label-4 {
    outline: 2px solid #BF40FA;
    outline-offset: 2px;
  }

  .funnel-tabs:has(#step-1:checked) .step-panel-1 { display: block; }
  .funnel-tabs:has(#step-1:checked) .step-panel-2,
  .funnel-tabs:has(#step-1:checked) .step-panel-3,
  .funnel-tabs:has(#step-1:checked) .step-panel-4 { display: none; }

  .funnel-tabs:has(#step-2:checked) .step-panel-2 { display: block; }
  .funnel-tabs:has(#step-2:checked) .step-panel-1,
  .funnel-tabs:has(#step-2:checked) .step-panel-3,
  .funnel-tabs:has(#step-2:checked) .step-panel-4 { display: none; }

  .funnel-tabs:has(#step-3:checked) .step-panel-3 { display: block; }
  .funnel-tabs:has(#step-3:checked) .step-panel-1,
  .funnel-tabs:has(#step-3:checked) .step-panel-2,
  .funnel-tabs:has(#step-3:checked) .step-panel-4 { display: none; }

  .funnel-tabs:has(#step-4:checked) .step-panel-4 { display: block; }
  .funnel-tabs:has(#step-4:checked) .step-panel-1,
  .funnel-tabs:has(#step-4:checked) .step-panel-2,
  .funnel-tabs:has(#step-4:checked) .step-panel-3 { display: none; }
</style>
