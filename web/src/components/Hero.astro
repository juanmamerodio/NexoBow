---
import { SITE } from "../config";
---

<section class="relative mx-auto max-w-6xl px-6 pb-28 pt-12 md:pt-20">
  <div class="grid items-center gap-12 lg:grid-cols-12">
    <!-- Copy Column (Hormozi direct style) -->
    <div class="lg:col-span-7">
      <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold text-white/90 backdrop-blur-md mb-6 shadow-sm">
        <span class="flex h-2 w-2 rounded-full bg-[#DB1FFF] animate-ping"></span>
        <span class="text-white/80">Fábrica de Embudos Automatizados</span>
      </div>

      <h1 class="font-outfit text-5xl font-extrabold leading-[1.05] tracking-tight text-white md:text-7xl">
        Más pacientes.<br />
        Cero mensajes sueltos.<br />
        Tu <span class="bg-gradient-to-r from-[#DB1FFF] via-[#a855f7] to-[#818cf8] bg-clip-text text-transparent animate-gradient-text">embudo listo</span> en días.
      </h1>

      <p class="mt-7 max-w-xl text-lg font-normal leading-relaxed text-white/70">
        Transformamos tu tráfico de Google Maps, Instagram y WhatsApp en consultorías gratuitas agendadas en tu calendario. Sin perder tiempo coordinando horarios a mano.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-5">
        <!-- Büro-style expanded pill CTA -->
        <a
          href={SITE.bookingUrl}
          class="group relative inline-flex items-center gap-4 rounded-full bg-white/10 p-2 pl-7 pr-2.5 text-sm font-bold tracking-wide text-white backdrop-blur-md border border-white/20 transition-all duration-300 hover:border-[#DB1FFF] hover:bg-white/15 hover:shadow-[0_0_35px_rgba(219,31,255,0.45)]"
        >
          <span>Quiero mi embudo</span>
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#DB1FFF] text-white transition-all duration-300 group-hover:scale-110 group-hover:translate-x-1 shadow-[0_0_15px_rgba(219,31,255,0.6)]">
            <svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

        <div class="flex items-center gap-2 text-xs text-white/60">
          <svg class="h-4 w-4 text-[#DB1FFF]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          <span>Primer mes de prueba sin costo</span>
        </div>
      </div>
    </div>

    <!-- 3D Smartphone Interactive Mockup Column -->
    <div class="lg:col-span-5 flex justify-center">
      <div class="relative w-full max-w-[340px] sm:max-w-[360px]" style="perspective: 1200px;">
        
        <!-- Glow Backlight -->
        <div class="absolute -inset-4 rounded-[45px] bg-gradient-to-tr from-[#DB1FFF]/30 via-violet-600/20 to-transparent blur-2xl opacity-75"></div>

        <!-- Phone Card 3D container -->
        <div
          id="phone-3d-card"
          class="relative rounded-[42px] border-4 border-white/20 bg-gradient-to-b from-neutral-900 via-neutral-950 to-black p-3.5 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_30px_rgba(219,31,255,0.25)] transition-transform duration-200 ease-out preserve-3d"
          style="transform: rotateY(-8deg) rotateX(6deg);"
        >
          <!-- Dynamic Island / Speaker Notch -->
          <div class="mx-auto mb-3 h-5 w-24 rounded-full bg-neutral-950 border border-white/10 flex items-center justify-center">
            <div class="h-2 w-2 rounded-full bg-neutral-800 mr-2"></div>
            <div class="h-1.5 w-8 rounded-full bg-neutral-900"></div>
          </div>

          <!-- Phone Screen Content -->
          <div class="rounded-[30px] bg-neutral-950/90 border border-white/10 p-4 overflow-hidden backdrop-blur-md">
            
            <!-- WhatsApp Top Bar -->
            <div class="flex items-center gap-3 border-b border-white/10 pb-3">
              <div class="relative flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500/20 text-emerald-400 font-bold text-sm border border-emerald-500/30">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
                </svg>
                <span class="absolute bottom-0 right-0 h-2.5 w-2.5 rounded-full bg-emerald-500 ring-2 ring-neutral-950"></span>
              </div>
              <div>
                <p class="text-sm font-semibold text-white">Asistente NexoBow</p>
                <p class="text-[11px] text-emerald-400 font-medium">● En línea (Respuesta instantánea)</p>
              </div>
            </div>

            <!-- WhatsApp Chat Stream -->
            <div class="my-4 space-y-3 text-xs">
              <!-- Lead Incoming -->
              <div class="flex flex-col items-start">
                <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-neutral-800/90 px-3.5 py-2.5 text-neutral-200 border border-white/5 shadow-sm">
                  Hola! Vi tus casos de éxito en Instagram. ¿Tienen turnos disponibles esta semana?
                </div>
                <span class="mt-1 text-[9px] text-neutral-500">14:32</span>
              </div>

              <!-- Automated Bot Response -->
              <div class="flex flex-col items-end">
                <div class="max-w-[88%] rounded-2xl rounded-tr-sm bg-[#DB1FFF]/25 border border-[#DB1FFF]/40 px-3.5 py-2.5 text-white shadow-sm">
                  ¡Hola! Qué bueno saludarte. Sí, podés elegir tu consultoría de 20 min en este link directo 👇
                </div>
                <span class="mt-1 text-[9px] text-white/50">14:32 · Automático</span>
              </div>

              <!-- Booking Card inside Chat -->
              <div class="rounded-xl border border-white/15 bg-gradient-to-br from-white/10 to-white/5 p-3 text-white backdrop-blur-md shadow-md">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-xs text-white">Consultoría Inicial</span>
                  <span class="rounded-full bg-[#DB1FFF] px-2 py-0.5 text-[10px] font-bold text-white uppercase tracking-wider">Agendada</span>
                </div>
                <div class="mt-2 text-[11px] text-white/80">
                  📅 Jueves 16:30 hs · Google Meet
                </div>
                <div class="mt-1.5 flex items-center gap-1.5 text-[10px] text-emerald-400">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Sincronizado en Google Calendar & Email</span>
                </div>
              </div>
            </div>

            <!-- Floating Metric Badge -->
            <div class="mt-2 rounded-xl border border-[#DB1FFF]/30 bg-[#DB1FFF]/10 p-3 text-center">
              <span class="text-[10px] uppercase tracking-wider font-semibold text-white/70">Impacto comprobado</span>
              <p class="font-outfit text-xl font-bold text-[#DB1FFF] mt-0.5">+42% Consultorías</p>
              <p class="text-[10px] text-white/60">sin perder horas al teléfono</p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // Dynamic 3D Card Tilt with Inertia & Graceful Reduced Motion Handling
  const card = document.getElementById("phone-3d-card");
  if (card && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const parent = card.parentElement;
    if (parent) {
      let isHovered = false;

      parent.addEventListener("mouseenter", () => {
        isHovered = true;
      });

      parent.addEventListener("mousemove", (e) => {
        const rect = parent.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const xPct = (x / rect.width - 0.5) * 2;
        const yPct = (y / rect.height - 0.5) * 2;

        card.style.transform = `rotateY(${xPct * 18}deg) rotateX(${-yPct * 18}deg) scale3d(1.03, 1.03, 1.03)`;
      });

      parent.addEventListener("mouseleave", () => {
        isHovered = false;
        card.style.transform = "rotateY(-8deg) rotateX(6deg) scale3d(1, 1, 1)";
      });
    }
  }
</script>
