---
const gaMeasurementId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "").trim();
---

<aside
  id="nexobow-cookie-banner"
  role="region"
  aria-label="Preferencias de cookies y privacidad"
  data-ga-id={gaMeasurementId}
  hidden
  class="fixed bottom-20 left-4 right-4 z-50 rounded-2xl border border-[#4928C2]/55 bg-[#0B0D12]/95 p-5 text-[#F8F6FF] shadow-[0_20px_50px_rgba(4,6,7,0.92)] backdrop-blur-xl sm:bottom-5 sm:left-5 sm:right-auto sm:max-w-md"
>
  <p class="font-outfit text-sm font-bold text-[#F8F6FF]">
    Privacidad y cookies en NexoBow
  </p>
  <p class="mt-1.5 text-xs leading-relaxed text-[#E3D9FC]/85">
    Navegás con 0 cookies de seguimiento por defecto. Solo activamos medición anónima (GA4) si elegís aceptarla.{" "}
    <a
      href="/privacidad/#cookies"
      class="font-semibold text-[#E3D9FC] underline decoration-[#BF40FA]/70 underline-offset-2 hover:text-[#BF40FA] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#BF40FA]"
    >
      Ver política de cookies
    </a>
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button
      id="nexobow-cookie-accept"
      type="button"
      class="inline-flex min-h-11 cursor-pointer items-center justify-center rounded-full bg-[#BF40FA] px-4 py-2 text-xs font-extrabold text-[#040607] transition-colors hover:bg-[#D170FF] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F8F6FF]"
    >
      Aceptar analítica
    </button>
    <button
      id="nexobow-cookie-essential"
      type="button"
      class="inline-flex min-h-11 cursor-pointer items-center justify-center rounded-full border border-[#4928C2]/60 bg-[#040607] px-4 py-2 text-xs font-semibold text-[#E3D9FC] transition-colors hover:border-[#BF40FA] hover:text-[#F8F6FF] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#BF40FA]"
    >
      Solo esenciales
    </button>
  </div>
</aside>

<script is:inline data-nexobow-consent-loader="true">
(function () {
  var path = window.location.pathname || "/";
  if (path === "/admin" || path.indexOf("/admin/") === 0) return;

  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = window.gtag || gtag;

  gtag("consent", "default", {
    analytics_storage: "denied",
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    wait_for_update: 500
  });

  var STORAGE_KEY = "nexobow_cookie_consent";
  var banner = document.getElementById("nexobow-cookie-banner");
  var acceptBtn = document.getElementById("nexobow-cookie-accept");
  var essentialBtn = document.getElementById("nexobow-cookie-essential");
  var gaId = banner ? (banner.getAttribute("data-ga-id") || "").trim() : "";
  var gaConfigured = false;
  var eventsBound = false;

  function readConsent() {
    try {
      return window.localStorage.getItem(STORAGE_KEY);
    } catch (_e) {
      return null;
    }
  }

  function writeConsent(val) {
    try {
      window.localStorage.setItem(STORAGE_KEY, val);
    } catch (_e) {}
  }

  function bindAnalyticsEvents() {
    if (eventsBound) return;
    eventsBound = true;

    document.addEventListener("submit", function (ev) {
      var form = ev.target && ev.target.closest ? ev.target.closest('form[action*="/api/v1/bow-system/create"]') : null;
      if (form) {
        gtag("event", "generate_lead", { event_category: "inbound" });
      }
    });

    document.addEventListener("click", function (ev) {
      var link = ev.target && ev.target.closest ? ev.target.closest("a") : null;
      if (!link) return;
      var href = link.getAttribute("href") || "";
      if (href.indexOf("wa.me/") !== -1) {
        gtag("event", "contact_whatsapp", { event_category: "conversion" });
      } else if (href.indexOf("preview.nexobow.site") !== -1 || href.indexOf("demo-nutri-sofia.pages.dev") !== -1) {
        gtag("event", "view_demo", { event_category: "engagement" });
      }
    });
  }

  function enableAnalytics() {
    gtag("consent", "update", {
      analytics_storage: "granted",
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied"
    });

    if (/^G-[A-Z0-9]+$/i.test(gaId) && !gaConfigured) {
      gaConfigured = true;
      if (!document.querySelector('script[data-nexobow-ga4="true"]')) {
        var s = document.createElement("script");
        s.async = true;
        s.setAttribute("data-nexobow-ga4", "true");
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaId);
        document.head.appendChild(s);
      }
      gtag("js", new Date());
      gtag("config", gaId, { anonymize_ip: true });
    }

    bindAnalyticsEvents();
  }

  var saved = readConsent();
  if (saved === "accepted") {
    enableAnalytics();
  } else if (saved !== "essential" && banner) {
    banner.hidden = false;
  }

  if (acceptBtn) {
    acceptBtn.addEventListener("click", function () {
      writeConsent("accepted");
      if (banner) banner.hidden = true;
      enableAnalytics();
    });
  }

  if (essentialBtn) {
    essentialBtn.addEventListener("click", function () {
      writeConsent("essential");
      gtag("consent", "update", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied"
      });
      if (banner) banner.hidden = true;
    });
  }

  document.addEventListener("click", function (ev) {
    var trigger = ev.target && ev.target.closest ? ev.target.closest("[data-open-cookie-settings]") : null;
    if (!trigger || !banner) return;
    banner.hidden = false;
    if (acceptBtn) acceptBtn.focus();
  });
})();
</script>
