---
import { SITE } from "../config";

const starterWaUrl = `https://wa.me/${SITE.phoneRaw}?text=Hola%20Juanma!%20Me%20interesa%20activar%20el%20Plan%20Starter%20de%20NexoBow%20con%201%20a%C3%B1o%20de%20hosting%20incluido.`;
const autonomousWaUrl = `https://wa.me/${SITE.phoneRaw}?text=Hola%20Juanma!%20Quiero%20consultar%20por%20el%20Plan%20Autonomous%20(Turno%20Automatizado%20IA%2024%2F7).`;
const growthWaUrl = `https://wa.me/${SITE.phoneRaw}?text=Hola%20Juanma!%20Quiero%20cotizar%20el%20Plan%20Full%20Growth%20(Embudo%20%2B%20AfterBow%20Audiovisual).`;
---

<section id="planes" class="relative mx-auto max-w-6xl px-6 py-24">
  <div class="mx-auto max-w-3xl text-center mb-10">
    <div class="mb-3 inline-block rounded-full border border-[#4928C2]/40 bg-[#0B0D12] px-4 py-1 text-xs font-semibold tracking-wider text-[#E3D9FC] uppercase">
      Inversión Transparente · Escalera de Valor
    </div>
    <h2 class="font-outfit text-3xl font-extrabold tracking-tight text-[#F8F6FF] sm:text-4xl md:text-5xl">
      Elegí el plan para <span class="text-[#BF40FA]">escalar tu consultorio</span> hoy
    </h2>
    <p class="mt-3 text-base text-[#E3D9FC]/80">
      Precios claros en Pesos Argentinos, sin abonos chicos ni comisiones por turno y con 1 año de hosting incluido en tu entrada.
    </p>
  </div>

  <!-- 14-Day Risk Reversal & 7-Day Active Server Expiration Banner -->
  <div class="mb-12 space-y-4">
    <div class="rounded-2xl border border-emerald-500/50 bg-gradient-to-r from-emerald-950/30 via-[#0B0D12] to-[#040607] p-5 text-center shadow-[0_0_30px_rgba(16,185,129,0.15)]">
      <p class="text-xs sm:text-sm font-semibold text-[#F8F6FF]">
        🛡️ <span class="text-emerald-400 uppercase tracking-wide font-extrabold">GARANTÍA INCONDICIONAL DE 14 DÍAS:</span> Si en las primeras dos semanas no sentís que tu nueva web eleva drásticamente el prestigio de tu consultorio y te ahorra tiempo en WhatsApp, te devolvemos el <strong>100% de tu dinero</strong> y te dejamos el dominio registrado a tu nombre sin cargo.
      </p>
    </div>

    <div class="rounded-2xl border border-[#BF40FA]/50 bg-gradient-to-r from-[#5B2A62]/30 via-[#0B0D12] to-[#4928C2]/25 p-5 text-center shadow-[0_0_30px_rgba(191,64,250,0.15)]">
      <p class="text-xs sm:text-sm font-semibold text-[#F8F6FF]">
        ⏱️ <span class="text-[#BF40FA] uppercase tracking-wide font-extrabold">POLÍTICA DE SERVIDOR ACTIVO:</span> Si recibiste una demo personalizada por WhatsApp, tu archivo y diseño quedan reservados por <strong>7 días corridos</strong>. Pasado ese plazo sin actividad, el sistema libera el cupo y elimina la demo automáticamente.
      </p>
    </div>
  </div>

  <!-- 3-Plan Ladder -->
  <div class="grid gap-8 lg:grid-cols-3 items-stretch">
    <!-- Plan 1: NexoBow Starter (Featured) -->
    <div class="relative flex flex-col justify-between rounded-3xl border-2 border-[#BF40FA] bg-gradient-to-b from-[#5B2A62]/25 via-[#0B0D12] to-[#040607] p-8 shadow-[0_0_50px_rgba(191,64,250,0.2)]">
      <div>
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-[#BF40FA] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#F8F6FF]">
            Más Elegido
          </span>
          <span class="text-xs font-semibold text-[#E3D9FC]">Profesionales Independientes</span>
        </div>

        <h3 class="mt-5 font-outfit text-2xl font-extrabold text-[#F8F6FF]">NexoBow Starter</h3>
        <p class="mt-1 text-xs text-[#E3D9FC]/75">Tu landing de prestigio lista en días para convertir visitas en consultorías.</p>

        <div class="mt-6 border-t border-[#4928C2]/30 pt-5">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/70 font-medium">
            Setup único llave en mano · <span class="line-through text-[#E3D9FC]/50">{SITE.setupOldPrice}</span>
          </p>
          <p class="mt-1 font-outfit text-4xl font-extrabold text-[#F8F6FF]">{SITE.setupPrice}</p>
        </div>

        <div class="mt-4 rounded-2xl border border-[#4928C2]/35 bg-[#040607]/90 p-4">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/70 font-medium">Hosting &amp; Mantenimiento Año 1</p>
          <p class="mt-1 font-outfit text-2xl font-bold text-emerald-400">{SITE.monthlyPrice}</p>
          <p class="mt-0.5 text-[11px] text-emerald-300 font-semibold">✓ {SITE.tier1HostingNote} · +30 días de prueba IA opcional</p>
        </div>

        <ul class="mt-6 space-y-3 text-xs text-[#E3D9FC]">
          <li class="flex items-start gap-2.5"><span class="text-emerald-400 font-bold">✓</span><span class="font-bold text-[#F8F6FF]">Garantía incondicional de satisfacción 14 días</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Landing Astro SSG personalizada (&lt;0.8s) en dominio propio</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Copywriting Hormozi + Botón directo a WhatsApp / Agenda</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Reseñas reales de Google Maps y cumplimiento Ley 25.326</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>1 año completo de hosting Cloudflare edge sin costo mensual</span></li>
        </ul>
      </div>

      <div class="mt-8">
        <a
          href={starterWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center rounded-full bg-[#BF40FA] px-6 py-3.5 text-sm font-bold text-[#F8F6FF] transition-all duration-200 hover:bg-[#A82EE3] shadow-[0_0_25px_rgba(191,64,250,0.4)]"
        >
          Activar Plan Starter por WhatsApp →
        </a>
      </div>
    </div>

    <!-- Plan 2: NexoBow Autonomous (Turno Automatizado IA 24/7) -->
    <div class="flex flex-col justify-between rounded-3xl border border-[#4928C2]/40 bg-[#0B0D12] p-8">
      <div>
        <div class="flex items-center justify-between">
          <span class="rounded-full border border-[#4928C2]/50 bg-[#040607] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#E3D9FC]">
            Turno IA 24/7
          </span>
          <span class="text-xs font-semibold text-[#E3D9FC]/70">Consultorios &amp; Clínicas</span>
        </div>

        <h3 class="mt-5 font-outfit text-2xl font-extrabold text-[#F8F6FF]">NexoBow Autonomous</h3>
        <p class="mt-1 text-xs text-[#E3D9FC]/75">Recepcionista IA oficial en WhatsApp que agenda consultorías y frena el ausentismo.</p>

        <div class="mt-6 border-t border-[#4928C2]/25 pt-5">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/70 font-medium">Setup e Integración IA (pago único)</p>
          <p class="mt-1 font-outfit text-4xl font-extrabold text-[#F8F6FF]">{SITE.clinicSetupPrice}</p>
        </div>

        <div class="mt-4 rounded-2xl border border-[#4928C2]/30 bg-[#040607]/90 p-4">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/70 font-medium">Operación IA &amp; Agenda 24/7</p>
          <p class="mt-1 font-outfit text-2xl font-bold text-[#E3D9FC]">{SITE.clinicMonthlyPrice} finales/mes</p>
          <p class="mt-0.5 text-[11px] text-emerald-400 font-semibold">✓ Se paga solo recuperando 1 a 2 pacientes por mes</p>
        </div>

        <ul class="mt-6 space-y-3 text-xs text-[#E3D9FC]/85">
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Todo lo incluido en NexoBow Starter</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Recepcionista IA 24/7 en WhatsApp (Meta Cloud API oficial)</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Recordatorios anti-ausentismo 24h y 1h antes del turno</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Solicitud automática de reseñas 5★ en Google Maps</span></li>
        </ul>
      </div>

      <div class="mt-8">
        <a
          href={autonomousWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center rounded-full border border-[#4928C2]/60 bg-[#040607] px-6 py-3.5 text-sm font-bold text-[#F8F6FF] transition-all duration-200 hover:border-[#BF40FA] hover:bg-[#5B2A62]/20"
        >
          Consultar por Turno IA en WhatsApp →
        </a>
      </div>
    </div>

    <!-- Plan 3: Full Growth + Mes de Contenido Audiovisual (AfterBow Partnership) -->
    <div class="flex flex-col justify-between rounded-3xl border border-[#4928C2]/50 bg-gradient-to-b from-[#0B0D12] via-[#0B0D12] to-[#5B2A62]/20 p-8">
      <div>
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-[#4928C2] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#F8F6FF]">
            Alianza AfterBow
          </span>
          <span class="text-xs font-semibold text-[#BF40FA]">Embudo + Videos</span>
        </div>

        <h3 class="mt-5 font-outfit text-2xl font-extrabold text-[#F8F6FF]">
          Growth Partner + Contenido Audiovisual
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-[#E3D9FC]/85">
          ¿Además del embudo multi-profesional y posicionamiento AEO necesitás 1 mes de contenido en video (Reels, Ads y piezas de autoridad) para estallar tu agenda?
        </p>

        <div class="mt-6 border-t border-[#4928C2]/25 pt-5">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/70 font-medium">Modalidad llave en mano integral</p>
          <p class="mt-1 font-outfit text-2xl font-extrabold text-[#F8F6FF]">Plan Personalizado a Medida</p>
        </div>

        <div class="mt-4 rounded-2xl border border-[#4928C2]/35 bg-[#040607]/90 p-4 text-xs text-[#E3D9FC]">
          🎬 Producido junto a nuestra agencia audiovisual{" "}
          <a
            href={SITE.afterbowUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-[#BF40FA] underline decoration-[#BF40FA]/60 underline-offset-2 hover:text-[#F8F6FF]"
          >
            AfterBow (afterbow.com)
          </a>
        </div>

        <ul class="mt-6 space-y-3 text-xs text-[#E3D9FC]/85">
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Sistema Autonomous multi-profesional + Posicionamiento AEO</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Jornada de rodaje profesional y edición dinámica (Reels &amp; Ads)</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold">✓</span><span>Reactivación de pacientes inactivos y tráfico directo al embudo</span></li>
        </ul>
      </div>

      <div class="mt-8 space-y-2.5">
        <a
          href={growthWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center rounded-full border border-[#BF40FA]/60 bg-[#5B2A62]/30 px-6 py-3.5 text-sm font-bold text-[#F8F6FF] transition-all duration-200 hover:bg-[#BF40FA] hover:text-[#F8F6FF]"
        >
          Cotizar Plan Growth + Contenido vía WhatsApp →
        </a>
        <a
          href={SITE.afterbowUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center text-xs font-semibold text-[#E3D9FC]/75 hover:text-[#BF40FA]"
        >
          Ver portfolio audiovisual en afterbow.com ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Hormozi Fast-Action Bonus Stack -->
  <div class="mt-14 rounded-3xl border border-[#4928C2]/45 bg-[#0B0D12] p-8 sm:p-10">
    <div class="text-center mb-8">
      <span class="rounded-full bg-[#BF40FA]/20 border border-[#BF40FA]/40 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#BF40FA]">
        Stack de Acción Rápida · Bonificado al 100%
      </span>
      <h3 class="mt-3 font-outfit text-2xl font-extrabold text-[#F8F6FF] sm:text-3xl">
        3 Bonos incluidos GRATIS activando tu sistema antes de los 7 días
      </h3>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {SITE.bonuses.map((b) => (
        <div class="flex flex-col justify-between rounded-2xl border border-[#4928C2]/30 bg-[#040607] p-6">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-extrabold uppercase tracking-wider text-[#BF40FA]">{b.number}</span>
              <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-[11px] font-bold text-emerald-400">
                Valuado en {b.value} → GRATIS
              </span>
            </div>
            <h4 class="mt-3 font-outfit text-lg font-bold text-[#F8F6FF]">{b.title}</h4>
            <p class="mt-2 text-xs leading-relaxed text-[#E3D9FC]/75">{b.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
