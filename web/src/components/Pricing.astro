---
import { SITE } from "../config";

const starterWaUrl = `https://wa.me/${SITE.phoneRaw}?text=Hola%20Juanma!%20Me%20interesa%20activar%20el%20Plan%20Starter%20de%20NexoBow%20con%201%20a%C3%B1o%20de%20hosting%20incluido.`;
const autonomousWaUrl = `https://wa.me/${SITE.phoneRaw}?text=Hola%20Juanma!%20Quiero%20consultar%20por%20el%20Plan%20Autonomous%20(Turno%20Automatizado%20IA%2024%2F7).`;
const growthWaUrl = `https://wa.me/${SITE.phoneRaw}?text=Hola%20Juanma!%20Quiero%20cotizar%20el%20Plan%20Full%20Growth%20(Embudo%20%2B%20AfterBow%20Audiovisual).`;
---

<section id="planes" class="relative mx-auto max-w-6xl px-6 py-24">
  <div class="mx-auto max-w-3xl text-center mb-10">
    <div class="mb-3 inline-block rounded-full border border-[#4928C2]/45 bg-[#0B0D12] px-4 py-1.5 text-xs font-bold tracking-wider text-[#E3D9FC] uppercase">
      Inversión Clara · En Pesos Argentinos
    </div>
    <h2 class="font-outfit text-3xl font-extrabold tracking-tight text-[#F8F6FF] sm:text-4xl md:text-5xl">
      Elegí el plan para <span class="text-[#BF40FA]">ordenar tu agenda</span> hoy
    </h2>
    <p class="mt-4 text-lg text-[#E3D9FC]/90">
      Precios transparentes en pesos argentinos, sin comisiones por turno y con 1 año de alojamiento incluido en el plan inicial.
    </p>
  </div>

  <!-- 14-Day Risk Reversal & 7-Day Active Server Expiration Banner -->
  <div class="mb-12 space-y-4">
    <div class="rounded-2xl border border-emerald-500/45 bg-[#0B0D12] p-5 text-center">
      <p class="text-sm sm:text-base font-medium text-[#F8F6FF] leading-relaxed">
        🛡️ <span class="text-emerald-400 uppercase tracking-wide font-extrabold">GARANTÍA TÉCNICA DE 14 DÍAS:</span> Primero evaluás tu muestra gratuita durante 7 días sin pagar nada. Una vez contratado el Setup, garantizamos entrega en menos de 72 h hábiles y apertura en menos de 1s al <strong>100% de tu dinero</strong>, o desistimiento dentro de los 14 días previos a publicar deduciendo solo gastos directos de terceros (como tu dominio transferido a tu nombre).{" "}
        <a
          href="/terminos/#reembolsos"
          class="font-bold text-emerald-300 underline decoration-emerald-400/70 underline-offset-4 hover:text-emerald-200"
        >
          Ver Política de Reembolsos →
        </a>
      </p>
    </div>

    <div class="rounded-2xl border border-[#4928C2]/50 bg-[#0B0D12] p-5 text-center">
      <p class="text-sm sm:text-base font-medium text-[#F8F6FF] leading-relaxed">
        ⏱️ <span class="text-[#E3D9FC] uppercase tracking-wide font-extrabold">POLÍTICA DE SERVIDOR ACTIVO:</span> Si recibiste una demo personalizada por WhatsApp, tu archivo y diseño quedan reservados por <strong>7 días corridos</strong>. Pasado ese plazo sin actividad, el sistema libera el cupo de tu zona.
      </p>
    </div>
  </div>

  <!-- 3-Plan Ladder -->
  <div class="grid gap-8 lg:grid-cols-3 items-stretch">
    <!-- Plan 1: NexoBow Starter (Featured) -->
    <div class="relative flex flex-col justify-between rounded-3xl border-2 border-[#BF40FA] bg-[#0B0D12] p-8 shadow-[0_20px_50px_rgba(4,6,7,0.85)]">
      <div>
        <div class="flex items-center justify-between gap-2">
          <span class="rounded-full bg-[#BF40FA] px-3.5 py-1 text-xs font-extrabold uppercase tracking-wider text-[#040607]">
            Más Elegido
          </span>
          <span class="text-xs font-semibold text-[#E3D9FC]">Profesionales Independientes</span>
        </div>

        <h3 class="mt-5 font-outfit text-2xl font-extrabold text-[#F8F6FF]">NexoBow Starter</h3>
        <p class="mt-1.5 text-sm sm:text-base text-[#E3D9FC]/85">Tu página profesional lista en días para recibir consultas ordenadas.</p>

        <div class="mt-6 border-t border-[#4928C2]/30 pt-5">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/75 font-semibold">
            Setup único llave en mano · <span class="line-through text-[#E3D9FC]/60">{SITE.setupOldPrice}</span>
          </p>
          <p class="mt-1 font-outfit text-4xl font-extrabold text-[#F8F6FF]">{SITE.setupPrice}</p>
        </div>

        <div class="mt-5 border-t border-b border-[#4928C2]/30 py-4">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/75 font-semibold">Alojamiento &amp; Mantenimiento Año 1</p>
          <p class="mt-1 font-outfit text-2xl font-bold text-emerald-400">{SITE.monthlyPrice}</p>
          <p class="mt-1 text-xs sm:text-sm text-emerald-300 font-semibold">✓ {SITE.tier1HostingNote} · Sin débito automático obligatorio (aviso al mes 11)</p>
        </div>

        <ul class="mt-6 space-y-3 text-sm sm:text-base text-[#E3D9FC]">
          <li class="flex items-start gap-2.5"><span class="text-emerald-400 font-bold" aria-hidden="true">✓</span><span class="font-bold text-[#F8F6FF]">Garantía técnica 14 días + Etapa 0 de 7 días</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Página personalizada (&lt;0.8s) en dominio propio</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Textos claros sobre tu método + botón directo a WhatsApp o Agenda</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Reseñas reales de Google Maps y cumplimiento Ley 25.326</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>1 año completo de alojamiento sin costo mensual</span></li>
        </ul>
      </div>

      <div class="mt-8 space-y-3">
        <a
          href={starterWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center rounded-full bg-[#BF40FA] px-6 py-3.5 text-base font-extrabold text-[#040607] transition-colors duration-200 hover:bg-[#D170FF] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F8F6FF]"
        >
          Activar Plan Starter por WhatsApp →
        </a>
        <p class="text-center text-xs sm:text-sm text-[#E3D9FC]/80">
          <a href="/terminos/#debito-automatico" class="underline decoration-[#4928C2]/70 underline-offset-4 hover:text-[#BF40FA]">
            Ver política de renovaciones y débito automático
          </a>
        </p>
      </div>
    </div>

    <!-- Plan 2: NexoBow Autonomous (Turno Automatizado IA 24/7) -->
    <div class="flex flex-col justify-between rounded-3xl border border-[#4928C2]/45 bg-[#0B0D12] p-8">
      <div>
        <div class="flex items-center justify-between gap-2">
          <span class="rounded-full border border-[#4928C2]/55 bg-[#040607] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#E3D9FC]">
            Turno IA 24/7
          </span>
          <span class="text-xs font-semibold text-[#E3D9FC]/80">Consultorios &amp; Clínicas</span>
        </div>

        <h3 class="mt-5 font-outfit text-2xl font-extrabold text-[#F8F6FF]">NexoBow Autonomous</h3>
        <p class="mt-1.5 text-sm sm:text-base text-[#E3D9FC]/85">Asistente en WhatsApp que coordina turnos todo el día y envía recordatorios automáticos.</p>

        <div class="mt-6 border-t border-[#4928C2]/30 pt-5">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/75 font-semibold">Setup e Integración IA (pago único)</p>
          <p class="mt-1 font-outfit text-4xl font-extrabold text-[#F8F6FF]">{SITE.clinicSetupPrice}</p>
        </div>

        <div class="mt-5 border-t border-b border-[#4928C2]/30 py-4">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/75 font-semibold">Operación &amp; Agenda 24/7</p>
          <p class="mt-1 font-outfit text-2xl font-bold text-[#E3D9FC]">{SITE.clinicMonthlyPrice} finales/mes</p>
          <p class="mt-1 text-xs sm:text-sm text-emerald-400 font-semibold">✓ Se paga solo recuperando 2 consultas por mes</p>
        </div>

        <ul class="mt-6 space-y-3 text-sm sm:text-base text-[#E3D9FC]/90">
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Todo lo incluido en NexoBow Starter</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Asistente 24/7 en WhatsApp oficial que transcribe audios</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Recordatorios automáticos 24h y 2h antes con lista de espera</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Solicitud automática de reseñas 5★ en Google Maps</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Débito días 1–5 tras 30 días de prueba · Baja sin permanencia</span></li>
        </ul>
      </div>

      <div class="mt-8 space-y-3">
        <a
          href={autonomousWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center rounded-full border border-[#4928C2]/70 bg-[#040607] px-6 py-3.5 text-base font-bold text-[#F8F6FF] transition-colors duration-200 hover:border-[#BF40FA] hover:bg-[#5B2A62]/30"
        >
          Consultar por Turno IA en WhatsApp →
        </a>
        <p class="text-center text-xs sm:text-sm text-[#E3D9FC]/80">
          <a href="/terminos/#debito-automatico" class="underline decoration-[#4928C2]/70 underline-offset-4 hover:text-[#BF40FA]">
            Política de Débito Automático y baja sin permanencia
          </a>
        </p>
      </div>
    </div>

    <!-- Plan 3: Full Growth + Mes de Contenido Audiovisual (AfterBow Partnership) -->
    <div class="flex flex-col justify-between rounded-3xl border border-[#4928C2]/45 bg-[#0B0D12] p-8">
      <div>
        <div class="flex items-center justify-between gap-2">
          <span class="rounded-full bg-[#4928C2] px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#F8F6FF]">
            Alianza AfterBow
          </span>
          <span class="text-xs font-semibold text-[#E3D9FC]">Embudo + Videos</span>
        </div>

        <h3 class="mt-5 font-outfit text-2xl font-extrabold text-[#F8F6FF]">
          Growth Partner + Contenido Audiovisual
        </h3>
        <p class="mt-2 text-sm sm:text-base leading-relaxed text-[#E3D9FC]/90">
          ¿Además del embudo multi-profesional y mayor visibilidad en Google necesitás 1 mes de contenido en video (Reels, anuncios y piezas de autoridad) para recibir consultas de pacientes ya decididos a atenderse?
        </p>

        <div class="mt-6 border-t border-[#4928C2]/30 pt-5">
          <p class="text-xs uppercase tracking-wider text-[#E3D9FC]/75 font-semibold">Modalidad llave en mano integral</p>
          <p class="mt-1 font-outfit text-2xl font-extrabold text-[#F8F6FF]">Plan Personalizado a Medida</p>
        </div>

        <div class="mt-5 border-t border-b border-[#4928C2]/30 py-4 text-sm text-[#E3D9FC]">
          🎬 Producido junto a nuestra agencia audiovisual{" "}
          <a
            href={SITE.afterbowUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-[#F8F6FF] underline decoration-[#BF40FA] underline-offset-4 hover:text-[#BF40FA]"
          >
            AfterBow (afterbow.com)
          </a>
        </div>

        <ul class="mt-6 space-y-3 text-sm sm:text-base text-[#E3D9FC]/90">
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Sistema Autonomous multi-profesional + visibilidad en buscadores</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Jornada de rodaje profesional y edición dinámica (Reels y anuncios)</span></li>
          <li class="flex items-start gap-2.5"><span class="text-[#BF40FA] font-bold" aria-hidden="true">✓</span><span>Seguimiento de pacientes inactivos y tráfico directo a tu agenda</span></li>
        </ul>
      </div>

      <div class="mt-8 space-y-3">
        <a
          href={growthWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center rounded-full border border-[#BF40FA]/70 bg-[#040607] px-6 py-3.5 text-base font-bold text-[#F8F6FF] transition-colors duration-200 hover:bg-[#BF40FA] hover:text-[#040607]"
        >
          Cotizar Plan Growth + Contenido vía WhatsApp →
        </a>
        <a
          href={SITE.afterbowUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center text-xs sm:text-sm font-semibold text-[#E3D9FC]/85 hover:text-[#BF40FA]"
        >
          Ver portfolio audiovisual en afterbow.com ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Fast-Action Bonus Stack -->
  <div class="mt-14 rounded-3xl border border-[#4928C2]/45 bg-[#0B0D12] p-8 sm:p-10">
    <div class="text-center mb-8">
      <span class="rounded-full border border-[#BF40FA]/60 bg-[#040607] px-4 py-1 text-xs font-bold uppercase tracking-wider text-[#E3D9FC]">
        Bonos incluidos · Sin costo adicional
      </span>
      <h3 class="mt-3 font-outfit text-2xl font-extrabold text-[#F8F6FF] sm:text-3xl">
        3 Bonos incluidos GRATIS activando tu sistema antes de los 7 días
      </h3>
    </div>

    <div class="grid gap-8 md:grid-cols-3 border-t border-[#4928C2]/25 pt-8">
      {SITE.bonuses.map((b) => (
        <div class="border-l-2 border-[#BF40FA] pl-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-extrabold uppercase tracking-wider text-[#E3D9FC]">{b.number}</span>
            <span class="rounded-full bg-emerald-500/20 px-3 py-0.5 text-xs font-bold text-emerald-300">
              Valuado en {b.value} → GRATIS
            </span>
          </div>
          <h4 class="mt-3 font-outfit text-lg font-bold text-[#F8F6FF]">{b.title}</h4>
          <p class="mt-2 text-sm sm:text-base leading-relaxed text-[#E3D9FC]/85">{b.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
