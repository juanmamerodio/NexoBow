---
import { SITE } from "../config";
---

<section id="faq" class="relative mx-auto max-w-4xl px-6 py-24">
  <div class="text-center mb-12">
    <div class="mb-3 inline-block rounded-full border border-[#4928C2]/45 bg-[#0B0D12] px-4 py-1.5 text-xs font-bold tracking-wider text-[#E3D9FC] uppercase">
      Claridad Total · Cero Letra Chica
    </div>
    <h2 class="font-outfit text-3xl font-extrabold tracking-tight text-[#F8F6FF] sm:text-4xl md:text-5xl">
      Preguntas frecuentes sobre tu página web y turnos por WhatsApp
    </h2>
  </div>

  <div class="space-y-4">
    {SITE.faqs.map((f) => (
      <details class="group rounded-2xl border border-[#4928C2]/35 bg-[#0B0D12] p-6 sm:p-7 transition-colors duration-200 hover:border-[#4928C2]/65 open:border-[#BF40FA]/70">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-outfit text-lg sm:text-xl font-bold text-[#F8F6FF]">
          <span>{f.q}</span>
          <span
            aria-hidden="true"
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#4928C2]/45 bg-[#040607] text-[#BF40FA] transition-transform duration-300 group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="mt-4 text-base leading-relaxed text-[#E3D9FC]/90">{f.a}</p>
        {(f.linkHref || f.secondaryLinkHref) && (
          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-semibold">
            {f.linkHref && f.linkLabel && (
              <a
                href={f.linkHref}
                class="text-[#E3D9FC] underline decoration-[#BF40FA]/80 underline-offset-4 hover:text-[#BF40FA]"
              >
                {f.linkLabel} →
              </a>
            )}
            {f.secondaryLinkHref && f.secondaryLinkLabel && (
              <a
                href={f.secondaryLinkHref}
                class="text-[#E3D9FC]/90 underline decoration-[#4928C2]/80 underline-offset-4 hover:text-[#BF40FA]"
              >
                {f.secondaryLinkLabel} →
              </a>
            )}
          </div>
        )}
      </details>
    ))}
  </div>
</section>
