---
import { SITE } from "../config";

const scenarios = [
  {
    id: "roi-a",
    labelClass: "roi-label-a",
    panelClass: "roi-panel-a",
    tag: "Consultorio tranquilo",
    optionText: "Pierdo 2 consultas por mes sin respuesta",
    revenueHeading: "Recupero estimado (2 consultas)",
    revenueValue: "~$80.000 a $120.000 ARS/mes",
    revenueNote: "Equivale a dos consultas o seguimientos mensuales que hoy se enfrían.",
    weeklyHours: "3 hs libres / semana",
    monthlyHours: "+12 hs libres al mes",
    barFillWidth: 112,
    hoursNote: "Dejás de responder precios de noche.",
    checked: false,
  },
  {
    id: "roi-b",
    labelClass: "roi-label-b",
    panelClass: "roi-panel-b",
    tag: "Agenda habitual",
    optionText: "Pierdo 5 consultas por mes en WhatsApp",
    revenueHeading: "Ingreso recuperado (5 consultas)",
    revenueValue: "~$200.000 a $300.000 ARS/mes",
    revenueNote: "Solo ordenando 5 consultas que antes quedaban en el visto.",
    weeklyHours: "6 hs libres / semana",
    monthlyHours: "+24 hs libres al mes",
    barFillWidth: 204,
    hoursNote: "Equivale a 3 jornadas de consultorio recuperadas.",
    checked: true,
  },
  {
    id: "roi-c",
    labelClass: "roi-label-c",
    panelClass: "roi-panel-c",
    tag: "Clínica o equipo",
    optionText: "Recibimos más de 30 consultas por semana",
    revenueHeading: "Facturación ordenada (+15 turnos)",
    revenueValue: "+$600.000 ARS/mes",
    revenueNote: "Derivando consultas por especialidad sin saturar recepción.",
    weeklyHours: "11 hs libres / semana",
    monthlyHours: "+45 hs libres al mes",
    barFillWidth: 300,
    hoursNote: "Atención automática incluso domingos y feriados.",
    checked: false,
  },
];
---

<section id="calculadora-roi" class="relative mx-auto max-w-5xl px-6 py-24">
  <div class="mx-auto max-w-3xl text-center mb-12">
    <div class="mb-3 inline-block rounded-full border border-[#4928C2]/45 bg-[#0B0D12] px-4 py-1.5 text-xs font-bold tracking-wider text-[#E3D9FC] uppercase">
      Cuenta Rápida · Retorno Claro
    </div>
    <h2 class="font-outfit text-3xl font-extrabold tracking-tight text-[#F8F6FF] sm:text-4xl md:text-5xl">
      Hacé la cuenta rápida: ¿cuánta plata estás dejando <span class="text-[#BF40FA]">arriba de la mesa</span> cada mes?
    </h2>
    <p class="mt-4 text-lg text-[#E3D9FC]/90">
      Tocá tu situación actual para ver el ingreso y las horas libres que recuperás por semana.
    </p>
  </div>

  <div class="roi-box rounded-3xl border border-[#4928C2]/45 bg-[#0B0D12] p-6 sm:p-10 shadow-[0_20px_50px_rgba(4,6,7,0.85)]">
    <!-- Hidden Radio Inputs (0 JS) -->
    {scenarios.map((s) => (
      <input
        type="radio"
        name="roi-tier"
        id={s.id}
        class="sr-only"
        checked={s.checked}
      />
    ))}

    <!-- 3 Simplified Scenario Selectors -->
    <div class="grid gap-4 md:grid-cols-3">
      {scenarios.map((s) => (
        <label
          for={s.id}
          class={`${s.labelClass} cursor-pointer rounded-2xl border border-[#4928C2]/35 bg-[#040607] p-5 transition-all duration-200 hover:border-[#BF40FA]`}
        >
          <span class="text-xs font-bold tracking-wider text-[#E3D9FC] uppercase">{s.tag}</span>
          <p class="mt-2 font-outfit text-base sm:text-lg font-bold text-[#F8F6FF]">
            {s.optionText}
          </p>
        </label>
      ))}
    </div>

    <!-- Visual Comparison Area (flat divider, no nested card box) -->
    <div
      data-diagram="roi-hours-bar"
      class="mt-8 border-t border-[#4928C2]/30 pt-8"
    >
      <p class="mb-5 text-sm font-bold uppercase tracking-wider text-[#E3D9FC]">
        Horas que recuperás por semana frente al costo único del sistema
      </p>

      {scenarios.map((s) => (
        <div class={`${s.panelClass} ${s.checked ? "grid" : "hidden"} items-center gap-8 md:grid-cols-2`}>
          <!-- Left: Financial recovery -->
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-[#E3D9FC]/80">
              {s.revenueHeading}
            </p>
            <p class="mt-1.5 font-outfit text-3xl font-extrabold text-[#F8F6FF] sm:text-4xl">
              {s.revenueValue}
            </p>
            <p class="mt-2.5 text-base leading-relaxed text-[#E3D9FC]/85">
              {s.revenueNote}
            </p>
          </div>

          <!-- Right: SVG Comparative Hours Bar -->
          <div class="border-l-2 border-[#BF40FA] pl-5 space-y-3">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="font-outfit text-2xl font-extrabold text-[#F8F6FF]">{s.weeklyHours}</span>
              <span class="text-sm font-bold text-emerald-400">{s.monthlyHours}</span>
            </div>

            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 320 46"
              class="h-11 w-full"
            >
              <!-- Recovered hours bar -->
              <rect x="0" y="4" width="320" height="14" rx="7" fill="#1A1D26" />
              <rect x="0" y="4" width={s.barFillWidth} height="14" rx="7" fill="#34D399" />
              <!-- Setup cost comparative bar (1-time low baseline) -->
              <rect x="0" y="28" width="320" height="14" rx="7" fill="#1A1D26" />
              <rect x="0" y="28" width="68" height="14" rx="7" fill="#BF40FA" />
            </svg>

            <div class="text-sm text-[#E3D9FC]/85">
              <span class="inline-flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
                <span>{s.hoursNote}</span>
              </span>
            </div>
          </div>
        </div>
      ))}

      <!-- Shared Legend & Bottom Mathematical Conclusion -->
      <div class="mt-8 border-t border-[#4928C2]/25 pt-5 text-center space-y-2">
        <p class="inline-flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-[#E3D9FC]/80">
          <span class="inline-flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
            <span>Horas recuperadas por semana</span>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-[#BF40FA]" aria-hidden="true"></span>
            <span>Setup único: {SITE.setupPrice}</span>
          </span>
        </p>
        <p class="text-base font-semibold text-[#E3D9FC]">
          💡 Con solo recuperar 2 consultas por mes que hoy se pierden sin respuesta,{" "}
          <span class="text-[#F8F6FF]">
            tu Setup único ya se paga solo — y tenés {SITE.monthlyPrice} de abono durante todo el primer año.
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .roi-box:has(#roi-a:checked) .roi-label-a,
  .roi-box:has(#roi-b:checked) .roi-label-b,
  .roi-box:has(#roi-c:checked) .roi-label-c {
    border-color: #BF40FA;
    background-color: rgba(91, 42, 98, 0.35);
  }

  .roi-box:has(#roi-a:focus-visible) .roi-label-a,
  .roi-box:has(#roi-b:focus-visible) .roi-label-b,
  .roi-box:has(#roi-c:focus-visible) .roi-label-c {
    outline: 2px solid #BF40FA;
    outline-offset: 2px;
  }

  .roi-box:has(#roi-a:checked) .roi-panel-a { display: grid; }
  .roi-box:has(#roi-a:checked) .roi-panel-b,
  .roi-box:has(#roi-a:checked) .roi-panel-c { display: none; }

  .roi-box:has(#roi-b:checked) .roi-panel-b { display: grid; }
  .roi-box:has(#roi-b:checked) .roi-panel-a,
  .roi-box:has(#roi-b:checked) .roi-panel-c { display: none; }

  .roi-box:has(#roi-c:checked) .roi-panel-c { display: grid; }
  .roi-box:has(#roi-c:checked) .roi-panel-a,
  .roi-box:has(#roi-c:checked) .roi-panel-b { display: none; }
</style>
