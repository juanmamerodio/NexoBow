# Plantilla de variables para NexoBow Autonomous (Gate 1 · VPS Zero-Trust)
# Copiá este archivo a infra/autonomous/.env.autonomous en el VPS (chmod 600).
# Nunca versiones credenciales ni claves privadas reales en el repositorio.

# --- Base de datos Postgres 16 (aislada en red internal: data-tier) ---
POSTGRES_DB=nexobow_autonomous
POSTGRES_USER=nexobow_autonomous
POSTGRES_PASSWORD=reemplazar_clave_privada_postgres_32_bytes

# --- Redis 7 (buffer de mensajes WABA aislado en data-tier) ---
REDIS_PASSWORD=reemplazar_clave_privada_redis_32_bytes

# --- Orquestador n8n 2.0 (enlazado solo a loopback 127.0.0.1) ---
N8N_ENCRYPTION_KEY=reemplazar_clave_privada_n8n_64_hex
N8N_LOCAL_PORT=5678
WEBHOOK_URL=https://reemplazar-webhook.ejemplo.invalid/

# --- Credenciales Meta WhatsApp Business Cloud API (WABA) ---
META_WABA_VERIFY_TOKEN=reemplazar_token_verificacion_meta_waba
META_WABA_APP_SECRET=reemplazar_clave_privada_app_meta_waba
META_WABA_ACCESS_TOKEN=reemplazar_credencial_acceso_meta_waba

# --- Puente agregado sin PII hacia Cloudflare Edge / Supabase ---
NEXOBOW_INGEST_URL=https://reemplazar-dominio.ejemplo.invalid/api/v1/autonomous/ingest
AUTONOMOUS_INGEST_KEY=reemplazar_clave_privada_ingest_64_hex

# --- Túnel saliente opcional Cloudflare Tunnel (perfil tunnel) ---
# CLOUDFLARE_TUNNEL_TOKEN=reemplazar_credencial_cloudflare_tunnel_opcional
